        "type": "pages-banner-section",
        "settings": {
          "title": "Übbs tingling<br class=\"hidden-xs\"> your mind?",
          "subtitle": "You’ve come to the right place!",
          "banner_img": "shopify://shop_images/FAQ-Img.png",
          "big_circle": "shopify://shop_images/Ellipse_1_2e315378-c3bf-404c-a9c2-79a28b872cc3.png"

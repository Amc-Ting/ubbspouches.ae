      "faq_tab_accordion": {
        "type": "faq_tab_accordion",
        "blocks": {
          "text_6qifC9": {
            "type": "text",
            "settings": {
              "ques": "How can I contact you?",
              "ans": "<p>You can get in touch via our <a href=\"https://ubbspouches.ae/pages/contact\" target=\"_blank\" title=\"https://ubbspouches.ae/pages/contact\">Contact Us</a> or email us at <a href=\"mailto:customerservices@ubbspouches.ae\" title=\"mailto:customerservices@ubbspouches.ae\">customerservices@ubbspouches.ae</a></p>"
            }
          },
          "text_Hb6zni": {
            "type": "text",
            "settings": {
              "ques": "How will I know when my order is processed?",
              "ans": "<p>As soon as we receive your order, we will send you a confirmation email. This email will contain your order summary and order number. If you do not receive this email or if the email does not match your order, please write to us on <a href=\"mailto:customerservices@ubbspouches.ae\" title=\"mailto:customerservices@ubbspouches.ae\">customerservices@ubbspouches.ae</a></p>"
            }
          },
          "text_9BBzLr": {
            "type": "text",
            "settings": {
              "ques": "What are the delivery charges?",
              "ans": "<p>To find out more about our delivery charges, please visit our <a href=\"/policies/shipping-policy\" target=\"_blank\" title=\"Shipping Policy\">shipping policy </a>page.</p>"
            }
          },
          "text_aypCQx": {
            "type": "text",
            "settings": {
              "ques": "What delivery options does Übbs offer?",
              "ans": "<p>Depending on your location, we offer 1-Hour Delivery, Same Day Delivery & Next Day Delivery.</p>"
            }
          },
          "text_iRiYqL": {
            "type": "text",
            "settings": {
              "ques": "How do I know when my order has been shipped?",
              "ans": "<p>You will receive an email from us to let you know when your order has been shipped. For orders placed before 12am, we will despatch your order the same day. For orders placed after this time, we will despatch on the next available day.</p>"
            }
          },
          "text_6FhbTe": {
            "type": "text",
            "settings": {
              "ques": "What days can you deliver on?",
              "ans": "<p>We deliver 7 days a week, Monday – Sunday.</p>"
            }
          },
          "text_NBQFT9": {
            "type": "text",
            "settings": {
              "ques": "What happens if my order is wrong?",
              "ans": "<p>We’re sorry that you’ve received the incorrect order. We’ll fix that right away. Write to us on <a href=\"mailto:customerservices@ubbspouches.ae\" title=\"mailto:customerservices@ubbspouches.ae\">customerservices@ubbspouches.ae</a> or get in touch via the <a href=\"https://ubbspouches.ae/pages/contact\" target=\"_blank\" title=\"https://ubbspouches.ae/pages/contact\">Contact Us</a> and we’ll get back to you as soon as possible.</p>"
            }
          },
          "text_rUWVRq": {
            "type": "text",
            "settings": {
              "ques": "What happens if my order is missing/hasn't arrived?",
              "ans": "<p>If your Übbs Nicotine Pouches haven’t arrived please contact us via our <a href=\"https://ubbspouches.ae/pages/contact\" target=\"_blank\">Contact Us</a> or write to us on <a href=\"mailto:customerservices@ubbspouches.ae\" title=\"mailto:customerservices@ubbspouches.ae\">customerservices@ubbspouches.ae</a> and we will resolve the issue as soon as possible.</p>"
            }
          },
          "text_rjKtPJ": {
            "type": "text",
            "settings": {
              "ques": "Do you offer international shipping?",
              "ans": "<p>Unfortunately, we do not currently deliver outside of the UAE.</p>"
            }
          },
          "text_bVaVYe": {
            "type": "text",
            "settings": {
              "ques": "How can I return my order?",
              "ans": "<p>To return your order, you can visit your nearest MyVapery store in UAE, or call the MyVapery Helpline Number (800 69 800), or e-mail us at <a href=\"mailto:customerservices@ubbspouches.ae\" title=\"mailto:customerservices@ubbspouches.ae\">customerservices@ubbspouches.ae</a> for assistance.</p>"
            }
          },
          "text_k4Dzap": {
            "type": "text",
            "settings": {
              "ques": "Can I change or cancel an order?",
              "ans": "<p>In our efforts to provide the most efficient service to our customers, once an order has been placed and processed, we won’t be able to alter, change, or cancel the order.</p>"
            }
          }
        },
        "block_order": [

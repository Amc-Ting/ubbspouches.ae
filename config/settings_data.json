        }
      },
      "pages-nicotine_section": {
        "type": "pages-nicotine_section",
        "settings": {
          "title": "NICOTINE THAT’S DONE RIGHT",
          "subtitle": "<p>Designed in Sweden and manufactured to global pharmaceutical standards, our tobacco-free nicotine pouches offer a new nicotine experience. Crafted with precision, each pouch is a refreshing burst of flavours without the harmful effects of tobacco.</p>",
          "btntitle": "Shop Now",
          "btnlink": "shopify://collections/shop",
          "big_image": "shopify://shop_images/Nicotine_Thats_Done_Right.jpg",
          "small_image": "shopify://shop_images/nicotine_banner_img.jpg"
        }
      },
      "pages-psa_section": {
        "type": "pages-psa_section",
        "settings": {
          "title": "100% indulgence.<br> 0% tobacco.",
          "subtitle": "What are nicotine pouches?<br>übbs tobacco-free nicotine pouches are made only with pure, premium ingredients—nicotine, plant-based materials, flavourings, and sweeteners. They offer a clean, flavourful nicotine experience without the harmful side effects of tobacco. Each pouch delivers a consistent and satisfying feeling, allowing you to truly enjoy a tobacco-free alternative.",
          "banner_img": "shopify://shop_images/how-it-works_-_Open_can_image.png"
        }
      },
      "nicotine-banner": {
        "type": "nicotine-banner",
        "settings": {
          "title": "NICOTINE THAT’S DONE RIGHT",
          "subtitle": "<p>Designed in Sweden and manufactured to global pharmaceutical standards, our tobacco-free nicotine pouches offer a new nicotine experience. Crafted with precision, each pouch is a refreshing burst of flavours without the harmful effects of tobacco.</p>",
          "btntitle": "Shop Now",
          "btnlink": "shopify://collections/shop",
          "big_image": "shopify://shop_images/refer_bg_1.png",
          "small_image": "shopify://shop_images/Refer-a-friend-Mobile_1.jpg"
        }
      },
      "ourf_banner-section": {
        "type": "ourf_banner-section",
        "settings": {
          "title": "Geek out on where<br class=\"hidden-xs\"> Übbs is produced",
          "subtitle": "Know all about our manufacturing<br class=\"hidden-xs\"> facility and more!",
          "banner_img": "shopify://shop_images/Our_Facilities_img.png",
          "big_circle": "shopify://shop_images/Ellipse_1_2e315378-c3bf-404c-a9c2-79a28b872cc3.png"
        }
      },
      "ourf_psa_section": {
        "type": "ourf_psa_section",
        "settings": {
          "title": "Launched<br class=\"hidden-xs\"> in 2022",
          "subtitle": "übbs tobacco-free nicotine pouch is a thoughtfully crafted product catering to adult smokers and vapers across the world. We produce nicotine pouches that adhere to global pharmaceutical standards and we come with market experience, dedicated R&D teams and state-of-the-art, fully automated manufacturing facilities to deliver premium smokeless nicotine products globally."
        }
      },
      "ourf_vision_section": {
        "type": "ourf_vision_section",
        "settings": {
          "title": "Advanced<br class=\"hidden-xs\"> manufacturing<br class=\"hidden-xs\"> facility",
          "subtitle": "To provide a smokeless, tobacco-free alternative to smokers and vapers in the UK, übbs has established an advanced manufacturing facility, commissioned under strict pharmaceutical guidelines to meet Good Manufacturing Practices (GMP), to produce nicotine pouches.",
          "banner_img": "shopify://shop_images/Img-tinified.png"
        }
      },
      "ourf_psa_section1": {
        "type": "ourf_psa_section1",
        "settings": {
          "title": "A sophisticated<br class=\"hidden-xs\"> packaging<br class=\"hidden-xs\"> machinery",
          "subtitle": "We can retain approximately 45% moisture content while producing nicotine pouches at high volumes with our custom packaging machinery. The smart-tech equipment automatically removes waste sachets during roll changeovers and comes with industry-leading auto-cleaning features. The facility also features inbuilt stability chambers to test the products’ shelf life in various environments and temperatures.",
          "subtext": "With übbs tobacco-free nicotine pouches, we aim to deliver an unparalleled sensory experience for adult smokers and vapers.",
          "banner_img": "shopify://shop_images/Our_Facilities_-_image.png"
        }
      },
      "oursp_banner-section": {
        "type": "oursp_banner-section",
        "settings": {
          "title": "We put the ‘pro’<br class=\"hidden-xs\"> in processes",
          "subtitle": "Everything we do to deliver high-quality<br class=\"hidden-xs\"> nicotine pouches.",
          "banner_img": "shopify://shop_images/Our_Responsibility_img.png",
          "big_circle": "shopify://shop_images/Ellipse_1_d5dbfffb-63c2-4897-a29e-63758762c301.png"
        }
      },
      "oursp-responsibility_section": {
        "type": "oursp-responsibility_section",
        "blocks": {
          "psa_section_AQJFXf": {
            "type": "psa_section",
            "settings": {
              "psa_title": "Gold<br class=\"hidden-xs\"> standard factory operations",
              "psa_subtitle": "Our entire factory operations are executed under pharmaceutical Good Manufacturing Practices (GMP) and have been authenticated by the central and state drugs control department. We have a talented group of skilled individuals who ensure every task performed at the manufacturing facilities meets the standards set by the organisation.",
              "psa_banner_img": "shopify://shop_images/GOLD-STANDARD-FACTORY-OPERATIONS_LOOP.gif"
            }
          },
          "vision_section_fGMCtz": {
            "type": "vision_section",
            "settings": {
              "vision_title": "Strict<br class=\"hidden-xs\"> manufacturing<br class=\"hidden-xs\"> processes",
              "vision_subtitle": "The manufacturing process is monitored and approved by a dedicated, certified manufacturing chemist, who ensures our products are of the highest quality. This quality inspection is performed at every single stage of the process from blending, to curing, pouch making and finally container packing.",
              "vision_banner_img": "shopify://shop_images/STRICT-MANUFACTURING-PROCESSES_LOOP.gif"
            }
          },
          "psa_section_w3QwiU": {
            "type": "psa_section",
            "settings": {
              "psa_title": "Stringent<br class=\"hidden-xs\"> tests",
              "psa_subtitle": "We don’t just test our products for quality purposes, but also to make sure every pouch we produce is safe for our customers and meets all regulations. We have a fully equipped in-house laboratory ensuring all necessary tests are conducted to meet and exceed regulatory standards.",
              "psa_banner_img": "shopify://shop_images/STRINGENT-TESTS_LOOP_2750765e-b48a-4f37-851b-a9e4ebc526d4.gif"
            }
          },
          "vision_section_wQqLCP": {
            "type": "vision_section",
            "settings": {
              "vision_title": "Highest<br class=\"hidden-xs\"> quality materials",
              "vision_subtitle": "All the raw materials we use are procured from global suppliers who have years of experience and expertise in the food and pharmaceutical sectors. The raw materials are validated through qualitative wet, instrumental and microbial analysis. These analyses are performed by qualified quality control chemists who are certified by the drugs control department.",
              "vision_banner_img": "shopify://shop_images/HIGHEST-QUALITY-MATERIALS_LOOP_39219e3d-b42b-4b90-8258-958108900fc2.gif"
            }
          },
          "psa_section_kqWcRz": {
            "type": "psa_section",
            "settings": {
              "psa_title": "Our commitment<br class=\"hidden-xs\"> to the planet",
              "psa_subtitle": "Wherever and whenever possible, we strive to do our bit for the planet. The non-woven fabric used to produce our tobacco-free nicotine pouches is procured from industry leaders in the UK and Europe. The packaging material used to produce the übbs can is made from Polypropylene (PP), which is safe and recyclable. Moreover, all the materials we use to facilitate shipping and transport are paper-based and completely recyclable.",
              "psa_banner_img": "shopify://shop_images/OUR-COMMITMENT-TO-THE-PLANET_LOOP_ed7ca81e-82b0-4701-88b3-049bfe5930cf.gif"
            }
          }
        },

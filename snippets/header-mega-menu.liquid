{% comment %}
  Mega menu with Shop products slider and normal Discover section
{% endcomment %}

<nav class="custom_mega_menu header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      <li>
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>

              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
                tabindex="-1"
              >
                {% if link.title == 'Shop' %}
                  {% render 'shop-mega-links', block: block %}
                  <div class="product-tabs hidden">
                    <div class="tab-btn active" data-tab="pouches">übbs Nicotine Pouches</div>
                    <div class="tab-btn" data-tab="bundles">übbs Bundles</div>
                  </div>
                  <div id="pouches" class="tab-content active">
                    <div class="shop-menu-flex">
                      <!-- Left side: shop title + view all -->
                      <div class="shop-all-mbl">
                        <span class="shop-text">Shop by Product</span>
                        <a href="/collections/shop" class="arrow-view">View all →</a>
                      </div>

                      <!-- Right side: product images slider -->
                      <div class="swiper shop-swiper">
                        <div class="swiper-wrapper">
                          {%- for childlink in link.links -%}
                            {% capture productimg %}{{ childlink.url | remove: '/products/'  | remove:'/ar' }}.png{% endcapture %}
                            {% capture productimghover %}{{ childlink.url | remove: '/products/' | remove:'/ar' }}-hover.png{% endcapture %}
                            <div class="swiper-slide mega-menu__item-with-image">
                              <a
                                id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                                href="{{ childlink.url }}"
                                class="mega-menu__link mega-menu__link--level-2 link{% if childlink.current %} mega-menu__link--active{% endif %}"
                                {% if childlink.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                <div class="mega-menu__image-wrapper">
                                  <img
                                    src="{{ productimg | asset_url }}"
                                    alt="{{ childlink.title | escape }}"
                                    class="mega-menu__image {{ productimg | remove: '.png' }}"
                                    loading="lazy"
                                  >
                                  <img
                                    src="{{ productimghover | asset_url }}"
                                    alt="{{ childlink.title | escape }}"
                                    class="mega-menu__image--hover {{ productimghover | remove : '.png' }}"
                                    loading="lazy"
                                  >
                                </div>
                                <span class="mega-menu__title">{{ childlink.title | escape }}</span>
                              </a>
                            </div>
                          {%- endfor -%}
                        </div>
                        <!-- Swiper controls -->
                        <div class="swiper-button-next"></div>
                        <div class="swiper-button-prev"></div>
                        <div class="swiper-pagination"></div>
                      </div>
                    </div>
                  </div>
                  <div id="bundles" class="tab-content">
                    <div class="shop-menu-flex">
                      <!-- Left side: shop title + view all -->
                      <div class="shop-all-mbl">
                        <span class="shop-text">Shop by Product</span>
                        <a href="/collections/bundles" class="arrow-view">View all →</a>
                      </div>

                      <!-- Right side: product images slider -->
                      <div class="swiper shop-swiper">
                        <div class="swiper-wrapper">
                          {%- for childlink in linklists['menu-bundles'].links -%}
                            {% capture productimg %}{{ childlink.url | remove: '/products/' }}.png{% endcapture %}
                            {% capture productimghover %}{{ childlink.url | remove: '/products/' }}-hover.png{% endcapture %}
                            <div class="swiper-slide mega-menu__item-with-image">
                              <a
                                id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                                href="{{ childlink.url }}"
                                class="mega-menu__link mega-menu__link--level-2 link{% if childlink.current %} mega-menu__link--active{% endif %}"
                                {% if childlink.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                <div class="mega-menu__image-wrapper">
                                  <img
                                    src="{{ productimg | asset_url }}"
                                    alt="{{ childlink.title | escape }}"
                                    class="mega-menu__image"
                                    loading="lazy"
                                  >
                                  <img
                                    src="{{ productimghover | asset_url }}"
                                    alt="{{ childlink.title | escape }}"
                                    class="mega-menu__image--hover"
                                    loading="lazy"
                                  >
                                </div>
                                <span class="mega-menu__title">{{ childlink.title | escape }}</span>
                              </a>
                            </div>
                          {%- endfor -%}
                        </div>
                        <!-- Swiper controls -->
                        <div class="swiper-button-next"></div>
                        <div class="swiper-button-prev"></div>
                        <div class="swiper-pagination"></div>
                      </div>
                    </div>
                  </div>
                {% elsif link.title == 'Discover' %}
                  <div class="discover-menu-flex">
                    <!-- Left side: Discover links -->
                    <div class="discover-links">
                      <ul class="mega-menu__list" role="list">
                        {%- for childlink in link.links -%}
                          <li>
                            <a
                              id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                              href="{{ childlink.url }}"
                              class="mega-menu__link mega-menu__link--level-2 link{% if childlink.current %} mega-menu__link--active{% endif %}"
                              {% if childlink.current %}
                                aria-current="page"
                              {% endif %}
                            >
                              {{ childlink.title | escape }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>

                    <!-- Right side: Discover blog articles (normal layout) -->
                    <div class="discover-articles">
                      {% for block in section.blocks %}
                        {% if block.type == 'blog_article' %}
                          {% assign sarticle = block.settings.article %}
                          <div class="article_blog">
                            <div class="image_cover">
                              <a href="{{ sarticle.url }}">
                                <img
                                  src="{{ sarticle.image | image_url: width: 500 }}"
                                  loading="lazy"
                                  alt="{{ sarticle.title }}"
                                >
                              </a>
                              {% if sarticle.tags.size > 0 %}
                                <div class="tab-cyt">
                                  {% for tag in sarticle.tags %}
                                    <span class="taged">{{ tag }}</span>
                                  {% endfor %}
                                </div>
                              {% endif %}
                            </div>
                            <div class="article_content">
                              <p class="article_title">
                                <a href="{{ sarticle.url }}">{{ sarticle.title }}</a>
                              </p>
                              <div class="banner__buttons">
                                <a class="button button--primary" href="{{ sarticle.url }}">Read More</a>
                              </div>
                            </div>
                          </div>
                        {% endif %}
                      {% endfor %}
                    </div>
                  </div>

                {% else %}
                  <ul
                    class="mega-menu__list page-width{% if link.levels == 1 %} mega-menu__list--condensed{% endif %}"
                    role="list"
                  >
                    {%- for childlink in link.links -%}
                      <li>
                        <a
                          id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                          href="{{ childlink.url }}"
                          class="mega-menu__link mega-menu__link--level-2 link{% if childlink.current %} mega-menu__link--active{% endif %}"
                          {% if childlink.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{ childlink.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {% endif %}
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('#shopify-section-{{ section.id }}');
    if (!section) return;

    const tabs = section.querySelectorAll('.tab-btn');
    const contents = section.querySelectorAll('.tab-content');

    tabs.forEach((tab) => {
      tab.addEventListener('click', function () {
        tabs.forEach((t) => t.classList.remove('active'));
        contents.forEach((c) => c.classList.remove('active'));

        this.classList.add('active');
        const activeContent = section.querySelector('#' + this.dataset.tab);
        activeContent.classList.add('active');
        //console.log("qwerwew");
        {% comment %} setTimeout(() => {
          // 🔥 Proper Dawn 15 slider fix
          activeContent.querySelectorAll('slider-component').forEach((slider) => {
            // Force reflow
            slider.style.display = 'none';
            slider.offsetHeight;
            slider.style.display = '';

            // Trigger resize so Dawn recalculates
            window.dispatchEvent(new Event('resize'));
          });
        }, 150); {% endcomment %}
         setTimeout(() => {
          const swipers = activeContent.querySelectorAll('.shop-swiper');

          swipers.forEach((swiperEl) => {
            if (swiperEl.swiper) {
              swiperEl.swiper.update();
              swiperEl.swiper.updateSize();
              swiperEl.swiper.updateSlides();
              swiperEl.swiper.updateProgress();
              swiperEl.swiper.updateSlidesClasses();
            }
          });

          window.dispatchEvent(new Event('resize'));
        }, 150);
      });
    });
  });
</script>

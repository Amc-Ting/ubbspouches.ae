{% comment %}
  <script>
    function toggleCheckoutButton() {
      const cartItems = document.querySelectorAll('.cart-item');
      const nonUpsellItems = document.querySelectorAll('.cart-item:not(.upsell_item)');

      const checkoutButton = document.querySelector('#CartDrawer-Checkout'); // adjust selector

      if (cartItems.length > 0 && nonUpsellItems.length === 0) {
        // Only upsell items present
        checkoutButton.style.display = 'none';
      } else {
        checkoutButton.style.display = 'block';
      }
    }

    // Run on drawer open and cart updates
    document.addEventListener('cart:updated', toggleCheckoutButton);
    document.addEventListener('drawer:open', toggleCheckoutButton);
    toggleCheckoutButton(); // Run on page load
  </script>
{% endcomment %}

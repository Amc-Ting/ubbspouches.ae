<div class="custom-model-main">
  <div class="custom-model-inner">
    <div class="close-btn">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="28" height="28" rx="14" fill="black"/> <path d="M17.8726 17.5096L18.0494 17.3328L17.8726 17.1561L14.7166 14L17.8396 10.8769L18.0164 10.7002L17.8396 10.5234L17.5096 10.1934L17.3329 10.0166L17.1561 10.1934L14.033 13.3165L10.844 10.1274L10.6672 9.95063L10.4904 10.1274L10.1604 10.4574L9.98367 10.6342L10.1604 10.8109L13.3495 14L10.1934 17.1561L10.0167 17.3328L10.1934 17.5096L10.5234 17.8396L10.7002 18.0164L10.877 17.8396L14.033 14.6835L17.1891 17.8396L17.3659 18.0164L17.5426 17.8396L17.8726 17.5096Z" fill="white" stroke="white" stroke-width="0.5"/>
      </svg>
    </div>

    <div class="custom-model-wrap">
      <h2 class="model__heading">
        {% if collection.template_suffix == 'bundle' %}
          Bundle Offers
        {% else %}
          Multibuy Offers
        {% endif %}
      </h2>
      <div class="pop-up-content-wrap">
        <p>
          Take advantage of our multibuy offers, allowing you to buy nicotine pouches for less and stock up on your
          favorite übbs Nicotine Pouches. Embark on your journey towards a smoke-free, tobacco-free lifestyle, without
          breaking the bank.
        </p>
        <p>
          Browse through our collection and find the one that suits your taste and preferences. Start your smoke-free
          journey with übbs Pouches today.
        </p>
        <div class="comparison">
          {% if collection.template_suffix == 'bundle' or product.tags contains 'Bundle' %}
            <table class="table">
              <thead>
                <tr>
                  <th class="tl tl2"></th>
                  <th class="product blue">PRICE PER CAN</th>
                  <th class="product red">SAVING</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td></td>
                  <td colspan="3">Best Seller Bundle</td>
                </tr>
                <tr class="compare-row">
                  <td>Best Seller Bundle</td>
                  <!--
                    <td class="blue">£5.00</td>
                    <td class="red">16% Off</td>
                  -->
                  <td class="blue">£4.00</td>
                  <td class="red">33% Off</td>
                </tr>
                <tr>
                  <td></td>
                  <td colspan="3">Mint Bundle</td>
                </tr>
                <tr>
                  <td>Mint Bundle</td>
                  <td class="blue">£4.00</td>
                  <td class="red">33% Off</td>
                </tr>
                <tr>
                  <td></td>
                  <td colspan="3">Fruit Bundle</td>
                </tr>
                <tr class="compare-row">
                  <td>Fruit Bundle</td>
                  <td class="blue">£4.00</td>
                  <td class="red">33% Off</td>
                </tr>
                <tr>
                  <td></td>
                  <td colspan="4">Mix Bundle</td>
                </tr>
                <tr>
                  <td>Mix Bundle</td>
                  <td class="blue">£4.00</td>
                  <td class="red">33% Off</td>
                </tr>
                <tr>
                  <td></td>
                  <td colspan="3">Starter Bundle</td>
                </tr>
                <tr class="compare-row">
                  <td>Starter Bundle</td>
                  <td class="blue">£3.33</td>
                  <td class="red">44% Off</td>
                </tr>
              </tbody>
            </table>
          {% else %}
            <table class="table">
              <thead>
                <tr>
                  <th class="tl tl2">CANS</th>
                  <th class="product blue">PRICE PER CAN</th>
                  <th class="product red">SAVING</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td></td>
                  <td colspan="3">3-5 cans</td>
                </tr>
                <tr class="compare-row">
                  <td>3-5 cans</td>
                    {% comment %} <td class="blue">£4.80</td>
                    <td class="red">20% Off</td> {% endcomment %}
                    <td class="blue">£3.50</td>
                    <td class="red">41.67% Off</td>
                  
                </tr>

                <tr>
                  <td></td>
                  <td colspan="3">6-11 cans</td>
                </tr>
                <tr>
                  <td>6-11 cans</td>
                    {% comment %} <td class="blue">£4.20</td>
                    <td class="red">30% Off</td> {% endcomment %}
                    <td class="blue">£3.00</td>
                    <td class="red">50% Off</td>
                 
                </tr>
                <tr>
                  <td></td>
                  <td colspan="3">12-23 cans</td>
                </tr>
                <tr class="compare-row">
                  <td>12-23 cans</td>
                    {% comment %} <td class="blue">£3.60</td>
                    <td class="red">40% Off</td> {% endcomment %}
                     <td class="blue">£2.10</td>
                    <td class="red">65% Off</td>
                  
                </tr>
                <tr>
                  <td></td>
                  <td colspan="4">24+ cans</td>
                </tr>
                <tr>
                  <td>24+ cans</td>
                    {% comment %} <td class="blue">£3.00</td>
                    <td class="red">50% Off</td> {% endcomment %}
                    <td class="blue">£2.00</td>
                    <td class="red">66% Off</td>
                </tr>
                
              </tbody>
            </table>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
  <div class="bg-overlay"></div>
</div>
<style>
    .custom-model-main {
      text-align: center;
      overflow: hidden;
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      left: 0; /* z-index: 1050; */
      -webkit-overflow-scrolling: touch;
      outline: 0;
      opacity: 0;
      -webkit-transition: opacity 0.15s linear, z-index 0.15;
      -o-transition: opacity 0.15s linear, z-index 0.15;
      transition: opacity 0.15s linear, z-index 0.15;
      z-index: -1;
      overflow-x: hidden;
      overflow-y: auto;
    }

    .model-open {
      z-index: 99999;
      opacity: 1;
      overflow: hidden;
    }
    .custom-model-inner {
      -webkit-transform: translate(0, -25%);
      -ms-transform: translate(0, -25%);
      transform: translate(0, -25%);
      -webkit-transition: -webkit-transform 0.3s ease-out;
      -o-transition: -o-transform 0.3s ease-out;
      transition: -webkit-transform 0.3s ease-out;
      -o-transition: transform 0.3s ease-out;
      transition: transform 0.3s ease-out;
      transition: transform 0.3s ease-out, -webkit-transform 0.3s ease-out;
      display: inline-block;
      vertical-align: middle;
      width: 870px;
      margin: 30px auto;
      max-width: 97%;
    }
    .custom-model-wrap {
      display: block;
      width: 100%;
      position: relative;
      background-color: #fff;
      border-radius: 30px;
      -webkit-box-shadow: 0 3px 9px rgba(0, 0, 0, 0.5);
      box-shadow: 0 3px 9px rgba(0, 0, 0, 0.5);
      background-clip: padding-box;
      outline: 0;
      text-align: left;
      padding:2rem 3rem;
      -webkit-box-sizing: border-box;
      -moz-box-sizing: border-box;
      box-sizing: border-box;
      max-height: calc(100vh - 70px);
      overflow-y: auto;
    }
    .model__heading{font-size: 26px;text-align: center;text-transform: uppercase; font-family: 'KronaRegular'; font-weight: 400; padding-bottom: 20px; margin-bottom: 20px; border-bottom: 1px solid rgba(0,0,0,0.5);    color: #000;
    letter-spacing: 0.6px;}
    .model-open .custom-model-inner {
      -webkit-transform: translate(0, 0);
      -ms-transform: translate(0, 0);
      transform: translate(0, 0);
      position: relative;
      z-index: 999;
    }
    .model-open .bg-overlay {
      background: rgba(0, 0, 0, 0.6);
      z-index: 99;
    }
    .bg-overlay {
      background: rgba(0, 0, 0, 0);
      height: 100vh;
      width: 100%;
      position: fixed;
      left: 0;
      top: 0;
      right: 0;
      bottom: 0;
      z-index: 0;
      -webkit-transition: background 0.15s linear;
      -o-transition: background 0.15s linear;
      transition: background 0.15s linear;
    }
    .close-btn {
      position: absolute;
      right: 20px;
      top: 15px;
      cursor: pointer;
      z-index: 99;
    }

    @media screen and (min-width: 800px) {
      .custom-model-main:before {
        content: "";
        display: inline-block;
        height: auto;
        vertical-align: middle;
        margin-right: -0px;
        height: 100%;
      }
      .pop-up-content-wrap p{font-size: 20px; font-weight: 400; line-height: 24px;margin-bottom: 20px;}
    }
    @media screen and (max-width: 799px) {
      .custom-model-inner {
        margin-top: 45px;
      }
      .model__heading{font-size: 20px;}
      .pop-up-content-wrap p{font-size: 14px; font-weight: 400; line-height: 24px;margin-bottom: 20px;}
    }
    .comparison {
      max-width: 960px;
      margin: 0 auto;
      margin-bottom: 10px;
      margin-top: 20px;
      text-align: center;
    }

  .comparison table {
    width: 100%;
    border-spacing: 0rem 0;
    table-layout: auto;
    background: rgba(239, 236, 236, 0.5);
    border-radius:20px;
  }

  .comparison td,
  .comparison th {
    empty-cells: show;
    padding: 10px;

    font-size: 18px;
    text-transform: uppercase;
    font-family: 'KronaRegular';
    font-weight: 400;
  }

  .comparison tbody tr:nth-child(odd) {
    display: none;
  }
  .comparison thead tr th:first-child, .comparison tbody tr td:first-child{padding-left:3rem;}
  .comparison tbody tr:last-child{border-bottom-left-radius: 20px;border-bottom-right-radius: 20px;overflow: hidden;}
  .comparison tbody tr:last-child td:last-child{border-bottom-right-radius: 20px;}
  .comparison tbody tr:last-child td:first-child{border-bottom-left-radius: 20px;}
  /* .comparison tbody tr:nth-child(2){background: rgba(200, 200, 200, 0.2);}
  .comparison tbody tr:nth-child(4){background: rgba(200, 200, 200, 0.4);}
  .comparison tbody tr:nth-child(6){background: rgba(200, 200, 200, 0.6);}
  .comparison tbody tr:nth-child(8){background: rgba(200, 200, 200, 0.8);}
  .comparison tbody tr:nth-child(10){background: rgba(200, 200, 200, 0.9);} */
  .comparison th {
    font-weight: normal;
    padding: 0;

  }

  .comparison .product,
  .comparison .tl {
    color: #000;
    padding: 10px;
    font-size: 20px;
    text-transform: uppercase;
    font-family: 'KronaRegular';
    font-weight: 400;
  }

  .comparison .tl2 {
    border-right: 0;
  }

  .comparison .product {
    height: 40px;
    width: 33%;
    color: #fff;
    text-align: center;
    border-radius: 20px 20px 0 0;
  }
  .comparison .blue{
    background: rgba(77, 157, 232, 1);
    mix-blend-mode: multiply;
    color: #fff;
    text-align: center;
    border: 0 solid #fff;
    border-right-width: 0.25rem;
  }
  .comparison .red{
    background: rgba(244, 138, 110, 1);
    mix-blend-mode: multiply;
    color: #fff;
    text-align: center;
    border: 0 solid #fff;
    border-left-width: 0.25rem;
  }

  .special_offer{position:relative;}
  .special_offer_badge{
    position: absolute;
    font-size: 12px;
    text-transform: none;
    top: 10px;
    right: 40px;
    color: #000;
    background-color: #68D3CE;
    font-family: var(--font-body-family);
    padding: 4px 10px 4px 5px;
    border-radius: 0 50px 50px 0;
  }
  @media screen and (min-width: 721px) and (max-width: 1000px) {
    .table_ul li {
      letter-spacing: 0px;
    }
  }

  @media screen and (max-width: 720px) {
    .table_ul {
      padding: 0px;
    }
    .table_ul li {
      font-size: 10px;
      line-height: 16px;
      padding: 3px 0;
    }
    .comparison {
      max-width: 100%;
    }
    .comparison td:first-child,
    .comparison th:first-child {
      display: none;
    }
    .comparison tbody tr:nth-child(odd) {
      display: table-row;
      background: #F7F7F7;
    }
    .comparison .row {
      background: #FFF;
    }
    .comparison td,
    .comparison th {
      border: none;
      padding: 10px;
    }
    .comparison .compare-row {
      background: #ffffff;
    }
    .comparison .qbse {
      font-size: 1.2em;
    }
    .comparison td {
      font-size: 14px;
      text-align: center;
    }
    .comparison th {
      font-size: 14px;
    }
    .custom-model-wrap{
      padding:2rem 1rem;
    }
  }
</style>
{% comment %} <script>
  // Get the elements
  var clickHere = document.querySelectorAll('.Click-here');
  var closeBtnAndOverlay = document.querySelectorAll('.close-btn, .bg-overlay');
  var customModelMain = document.querySelector('.custom-model-main');

  // Add event listener for 'click' on ".Click-here"
  clickHere.forEach(function (element) {
    element.addEventListener('click', function () {
      customModelMain.classList.add('model-open');
    });
  });

  // Add event listener for 'click' on ".close-btn" or ".bg-overlay"
  closeBtnAndOverlay.forEach(function (element) {
    element.addEventListener('click', function () {
      customModelMain.classList.remove('model-open');
    });
  });
</script> {% endcomment %}

<script>
document.addEventListener("DOMContentLoaded", function () {

  var clickHere = document.querySelectorAll('.Click-here');
  var multibuySummary = document.querySelectorAll('.multibuy-popup summary');
  var closeBtnAndOverlay = document.querySelectorAll('.close-btn, .bg-overlay');
  var customModelMain = document.querySelector('.custom-model-main');

  // Existing Click-here trigger (keep)
  clickHere.forEach(function (element) {
    element.addEventListener('click', function () {
      customModelMain.classList.add('model-open');
    });
  });

  // NEW: Multibuy accordion trigger
  multibuySummary.forEach(function (summary) {
    summary.addEventListener('click', function (e) {
      e.preventDefault();      // stop accordion open
      e.stopPropagation();     // extra safety
      customModelMain.classList.add('model-open');
    });
  });

  // Close popup
  closeBtnAndOverlay.forEach(function (element) {
    element.addEventListener('click', function () {
      customModelMain.classList.remove('model-open');
    });
  });

});
</script>


<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.card-wrapper').forEach((card) => {
      // Find all variant radios ONLY inside this card
      const radios = card.querySelectorAll("input[type='radio'][data-variant]");

      if (!radios.length) return; // skip cards with no variant radios

      radios.forEach((radio) => {
        radio.addEventListener('change', function () {
          console.log('clicked');

          const variantId = this.dataset.variant;
          console.log('variantId', variantId);
          const selectedValue = this.value;
          console.log('selectedValue', selectedValue);
          // const handle = this.name.split("-").pop(); // last part is handle
          // console.log("handle", handle);
          const variantImg = this.getAttribute('imgSrc'); // <-- get image url
          console.log('variantImg', variantImg);

          // ------------------ UPDATE SELECTED TEXT ------------------
          const selectedBox = card.querySelector('.variant_selection');
          const hoverImg = card.querySelector('.hover_img');

          console.log('selectedBox', selectedBox);
          if (selectedBox) {
            console.log('selectedBox1', selectedBox);
            const text = selectedBox.querySelector('.font_text');
            //if (text) text.textContent = `${selectedValue} / pouch`;
          }

          if (selectedBox && hoverImg && variantImg) {
            // update attribute
            selectedBox.setAttribute('data-variant-image', variantImg);

            // update image
            hoverImg.src = variantImg;
          }

          // ------------------ FIND MATCHING PRODUCT FORM ------------------
          const productForm = card.querySelector('product-form');
          if (!productForm) {
            console.error('ERROR: product-form not found for:');
            return;
          }

          // ------------------ UPDATE HIDDEN VARIANT ID ------------------
          const hiddenInput = productForm.querySelector('input.product-variant-id');
          if (!hiddenInput) {
            console.error('ERROR: hidden variant input missing!');
            return;
          }

          hiddenInput.value = variantId;
        });
      });
    });
  });
</script>
<script>
{% comment %}
  document.addEventListener("DOMContentLoaded", function () {
     document.querySelectorAll(".card_product_variant").forEach(function (variantBox) {

      const cardWrapper = variantBox.closest(".card-wrapper, .grid__item, .product-card");
      if (!cardWrapper) return;

      const imageSec = cardWrapper.querySelector(".prod_img_sec");
      const mainImage = imageSec?.querySelector("img.media-1");
      if (!mainImage) return;

      const productUrl = variantBox.getAttribute("data-url");

      // On variant change
      variantBox.addEventListener("change", function (e) {
        if (!e.target.matches("input[type='radio']")) return;

        const variantId = e.target.dataset.variant;

        fetch(`${productUrl}.js`)
          .then(response => response.json())
          .then(product => {
            const selectedVariant = product.variants.find(v => v.id == variantId);
            if (!selectedVariant) return;

            // get variant image ID
            const variantImageId = selectedVariant.featured_media?.id;
            if (!variantImageId) return;

            // find matching media in product.media[]
            const newMedia = product.media.find(m => m.id == variantImageId);
            if (!newMedia) return;

            // update main image
            mainImage.src = newMedia.src;
            mainImage.srcset = newMedia.src;

          })
          .catch(err => console.error("Variant Image Error: ", err));
      });
    });
    let cardBox = document.querySelectorAll(".card-wrapper");
    if (cardBox.length) {
      cardBox.forEach(function (cardInner) {

        const varBox = cardInner.querySelector(".card_product_variant");
        if (!varBox) return;

        const imageSec = cardInner.querySelector(".prod_img_sec");
        const mainImage = imageSec?.querySelector("img.media-1");
        if (!mainImage) return;

        // On variant change
        varBox.addEventListener("change", function (e) {
          if (!e.target.matches("input[type='radio']")) return;

          // Get the image source directly from attribute
          const newImg = e.target.getAttribute("imgSrc");

          if (!newImg) {
            console.error("No imgSrc found on selected variant radio");
            return;
          }

          // Update main image
          mainImage.src = newImg;
          mainImage.srcset = newImg;
        });

      });
    }
  }); {% endcomment %}
</script>

  }
  .related-products .quantity__button{
    opacity: 1 !important;
  }
  .related-products .review_price_sec {
      {% comment %} padding-top: 30px !important; {% endcomment %}
  }
  body.main_index .lipscore-rating-small svg.lipscore-rating-star,
  .lipscore-rating-small svg.lipscore-rating-star {
    width: 10px !important;
    height: 10px !important;
  }
  .lipscore-rating-small{
    min-height: 15px;
    max-height: 20px;
    line-height: 0;
    padding-bottom:5px;
  }
</style>

{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{%- if card_product and card_product != empty -%}
  {%- liquid
    assign ratio = 1
    if card_product.featured_media and media_aspect_ratio == 'portrait'
      assign ratio = 0.8
    elsif card_product.featured_media and media_aspect_ratio == 'adapt'
      assign ratio = card_product.featured_media.aspect_ratio
    endif
    if ratio == 0 or ratio == null
      assign ratio = 1
    endif
    assign selected_variant = card_product.selected_or_first_available_variant
    assign pack_1_discount = 0
    assign pack_3_discount = 0
    assign pack_6_discount = 0
    assign pack_12_discount = 0
    assign pack_24_discount = 0
  -%}
  <div class="card-wrapper underline-links-hover {{card_product.tags | join: " " }}">
    {% if card_product.tags contains 'New' or card_product.tags contains 'new' %}
      <div class="card__badge top new_badge">
        <span
          style="display:block; background-color:{{ card_product.metafields.custom.product_color }} !important; border-color:{{ card_product.metafields.custom.product_color }} !important;"
          class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}"
          >New</span
        >
      </div>
    {% endif %}
    {% if card_product.tags contains 'Spicy' %}
      <div class="card__badge top spicy_badge">
        <span
          style="display:block; background-color:{{ card_product.metafields.custom.product_color }} !important; border-color:{{ card_product.metafields.custom.product_color }} !important;"
          class="badge badge--bottom-right color-{{ settings.sale_badge_color_scheme }}"
          >Spicy</span
        >
      </div>
    {% endif %}
    <div class="card__badge sold_out_badge {{ settings.badge_position }}">
      {%- if card_product.available == false -%}
        <span class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }}">
          {{- 'products.product.sold_out' | t -}}
        </span>
        {% comment %}
          {%- elsif card_product.compare_at_price > card_product.price and card_product.available -%}
          <span class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}" {{ 'products.product.on_sale' | t }}>STOPTOBER Sale</span>
        {% endcomment %}
      {%- endif -%}
    </div>
    {% comment %}
      {% if card_product.tags contains 'new_design' %}
        <div class="card__badge top new_design_badge">
          <p
            style="
              display:block;padding: 0.5rem 4rem 0.5rem 1rem;text-align: left;
              line-height:inherit;  background-color:{{ card_product.metafields.custom.product_color }} !important; border-color:{{ card_product.metafields.custom.product_color }} !important;
            "
            class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}"
          >
            New Design
            <span
              style="display:block;font-size:6px;padding: 0px 4px;line-height:inherit;text-align:left;width: max-content;"
              class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}"
            >
              Same Great Flavour</span
            >
          </p>
        </div>
      {% endif %}
    {% endcomment %}
    <div
      class="
        card
        card--{{ settings.card_style }}
        {% if card_product.featured_media %} card--media{% else %} card--text{% endif %}
        {% if settings.card_style == 'card' %} color-{{ settings.card_color_scheme }} gradient{% endif %}
        {% if extend_height %} card--extend-height{% endif %}
        {% if card_product.featured_media == nil and settings.card_style == 'card' %} ratio{% endif %}
      "
      style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;"
    >
      <div
        class="card__inner {% if settings.card_style == 'standard' %}color-{{ settings.card_color_scheme }} gradient{% endif %}{% if card_product.featured_media or settings.card_style == 'standard' %} ratio{% endif %}"
        style="--ratio-percent: {{ 1 | divided_by: ratio | times: 85 }}%;"
      >
        {%- if card_product.featured_media -%}
          <div
            class="card__media"
            {% if card_product.tags contains 'main_wholesale_product' %}
            {% else %}
              onclick="window.location.href='{{ card_product.url }}'"
            {% endif %}
          >
            <div class="media media--transparent media--hover-effect">
              {% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
              <div class="prod_img_sec">
                <!-- {{card_product.variants[0].available }} -->
                <!-- {{card_product.has_only_default_variant }} -->
                <img
                  srcset="
                    {%- if card_product.featured_media.width >= 165 -%}{{ card_product.featured_media | image_url: width: 165 }} 165w,{%- endif -%}
                    {%- if card_product.featured_media.width >= 360 -%}{{ card_product.featured_media | image_url: width: 360 }} 360w,{%- endif -%}
                    {%- if card_product.featured_media.width >= 533 -%}{{ card_product.featured_media | image_url: width: 533 }} 533w,{%- endif -%}
                    {%- if card_product.featured_media.width >= 720 -%}{{ card_product.featured_media | image_url: width: 720 }} 720w,{%- endif -%}
                    {%- if card_product.featured_media.width >= 940 -%}{{ card_product.featured_media | image_url: width: 940 }} 940w,{%- endif -%}
                    {%- if card_product.featured_media.width >= 1066 -%}{{ card_product.featured_media | image_url: width: 1066 }} 1066w,{%- endif -%}
                    {{ card_product.featured_media | image_url }} {{ card_product.featured_media.width }}w
                  "
                  src="{{ card_product.featured_media | image_url: width: 533 }}"
                  sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                  alt="{{ card_product.featured_media.alt | escape }}"
                  class="motion-reduce media-1"
                  {% unless lazy_load == false %}
                    loading="lazy"
                  {% endunless %}
                  width="{{ card_product.featured_media.width }}"
                  height="{{ card_product.featured_media.height }}"

                  {% unless card_product.variants[0].available %}
                    {% if card_product.has_only_default_variant %}
                      style="display:none"
                    {% endif %}
                  {% endunless %}
                >

                {% comment %}{% endcomment %}
                <!-- {{card_product.variants[1].available }} -->
                <img
                  srcset="
                    {%- if card_product.media[1].width >= 165 -%}{{ card_product.media[1] | image_url: width: 165 }} 165w,{%- endif -%}
                    {%- if card_product.media[1].width >= 360 -%}{{ card_product.media[1] | image_url: width: 360 }} 360w,{%- endif -%}
                    {%- if card_product.media[1].width >= 533 -%}{{ card_product.media[1] | image_url: width: 533 }} 533w,{%- endif -%}
                    {%- if card_product.media[1].width >= 720 -%}{{ card_product.media[1] | image_url: width: 720 }} 720w,{%- endif -%}
                    {%- if card_product.media[1].width >= 940 -%}{{ card_product.media[1] | image_url: width: 940 }} 940w,{%- endif -%}
                    {%- if card_product.media[1].width >= 1066 -%}{{ card_product.media[1] | image_url: width: 1066 }} 1066w,{%- endif -%}
                    {{ card_product.media[1] | image_url }} {{ card_product.media[1].width }}w
                  "
                  src="{{ card_product.media[1] | image_url: width: 533 }}"
                  sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                  alt="{{ card_product.media[1].alt | escape }}"
                  class="motion-reduce media-2"
                  loading="lazy"
                  width="{{ card_product.media[1].width }}"
                  height="{{ card_product.media[1].height }}"
                  {% unless card_product.variants[1].available %}
                    style="display:none"
                  {% endunless %}
                >
                {% if card_product.media[2] %}
                  <!-- {{card_product.variants[2].available }} -->
                  <img
                    srcset="
                      {%- if card_product.media[2].width >= 165 -%}{{ card_product.media[2] | image_url: width: 165 }} 165w,{%- endif -%}
                      {%- if card_product.media[2].width >= 360 -%}{{ card_product.media[2] | image_url: width: 360 }} 360w,{%- endif -%}
                      {%- if card_product.media[2].width >= 533 -%}{{ card_product.media[2] | image_url: width: 533 }} 533w,{%- endif -%}
                      {%- if card_product.media[2].width >= 720 -%}{{ card_product.media[2] | image_url: width: 720 }} 720w,{%- endif -%}
                      {%- if card_product.media[2].width >= 940 -%}{{ card_product.media[2] | image_url: width: 940 }} 940w,{%- endif -%}
                      {%- if card_product.media[2].width >= 1066 -%}{{ card_product.media[2] | image_url: width: 1066 }} 1066w,{%- endif -%}
                      {{ card_product.media[2] | image_url }} {{ card_product.media[2].width }}w
                    "
                    src="{{ card_product.media[2] | image_url: width: 533 }}"
                    sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                    alt="{{ card_product.media[2].alt | escape }}"
                    class="motion-reduce media-3"
                    loading="lazy"
                    width="{{ card_product.media[2].width }}"
                    height="{{ card_product.media[2].height }}"
                    {% unless card_product.variants[2].available %}
                      style="display:none"
                    {% endunless %}
                  >
                {% endif %}

                {% comment %}theme-check-enable ImgLazyLoading{% endcomment %}

                {% comment %}{% endcomment %}
                {% unless card_product.tags contains 'Bundle' %}
                  <div class="hover_img_sec">
                    {% assign selected_variant_img = card_product.selected_or_first_available_variant %}

                    <img
                      data-src="{{ selected_variant_img.featured_image | image_url: width: 533 }}"
                      sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 130 | divided_by: 4 }}px, (min-width: 990px) calc((100vw - 130px) / 4), (min-width: 750px) calc((100vw - 120px) / 3), calc((100vw - 35px) / 2)"
                      alt="{{ selected_variant_img.featured_image.alt | escape }}"
                      class="motion-reduce hover_img loading-lazy"
                      loading="lazy"
                      width="{{ selected_variant_img.featured_image.width }}"
                      height="{{ selected_variant_img.featured_image.height }}"
                    >
                  </div>
                {% endunless %}
              </div>
            </div>
          </div>
        {%- endif -%}
        <div class="card__content">
          {% comment %}
            <div class="card__information">

                <h3
                  class="card__heading"
                  {% if card_product.featured_media == null and settings.card_style == 'standard' %}
                    id="title-{{ section_id }}-{{ card_product.id }}"
                  {% endif %}
                >
                  <a href="{{ card_product.url }}" class="full-unstyled-link">
                    {{ card_product.title | escape }}
                  </a>
                </h3>

            </div>
          {% endcomment %}

          <!-- new badge {{ card_product.tags | join: ', ' }} -->

          <!-- new badge -->
          {% comment %}
            <!-- sale badge {{ card_product.tags | join: ', ' }}-->
              {% unless card_product.tags contains 'Bundle' %}{% endunless %}
                <div class="card__badge top right">
                    <span style="display: flex;align-items: center;gap: 0.5rem;" class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}">
                      <img src="https://cdn.shopify.com/s/files/1/0559/7075/8753/files/Bolt_Icon_03.svg?v=1731663267" class="bolt-icon-svg">
                      Black Friday Sale
                    </span>
                </div>

            <!-- sale badge -->
          {% endcomment %}
        </div>
      </div>
      <div class="card__content">
        {% render 'judgeme_widgets',
          widget_type: 'judgeme_preview_badge',
          jm_style: '',
          concierge_install: false,
          product: card_product
        %}
        <h3
          class="card__heading {% if card_product.featured_media or settings.card_style == 'standard' %} h5{% endif %}"
          {% if card_product.featured_media or settings.card_style == 'card' %}
            id="title-{{ section_id }}-{{ card_product.id }}"
          {% endif %}
        >
          <a
            href="{% if card_product.tags contains 'coming_soon' or card_product.tags contains 'main_wholesale_product'  %}#{% else %}{{ card_product.url }}{% endif %}"
            class="full-unstyled-link"
          >
            <span>{{ card_product.title | escape | remove: 'Übbs' | remove: 'Nicotine Pouches' }}</span>
            {% comment %}
              {{ card_product.metafields.custom.card_product_title.value }}
            {% endcomment %}
          </a>
        </h3>
        <div class="card__information">
          {% comment %}
            {% unless card_product.tags contains 'Bundle' %}
            <div class="offer_sec">
              <div class="questions_answer">
                  <div class="accordion">
                      <h4 class="header4 font_text font_black"><span>MULTIBUY UPTO 50% OFF</span> <span class="i-icon">i</span></h4>
                      <div class="content">
                        <p class=" font_text font_black">
                            Save when you buy 3, 6, 12, 24 or more cans.
                         </p>
                        <div class="text_sec">
                          <p> <span>Add 3 or more cans</span> <span>Add 6 or more cans</span> <span>Add 12 or more cans</span> <span>Add 24 or more cans</span> <!--<span>Add 48 or more cans</span>--> </p>
                          <p> <span>10% Off | <b>£5.40</b> per can </span> <span>20% Off | <b>£4.80</b> per can </span> <span>30% Off | <b>£4.20</b> per can </span> <span>50% Off | <b>£3.00</b> per can </span> <!--<span><s>50%</s> 60% Off | <b>£2.40</b> per can </span>--> </p>
                        </div>
                      </div>
                  </div>
              </div>
            </div>
            {% endunless %}
          {% endcomment %}
          {% comment %}
            {% render 'judgeme_widgets',
              widget_type: 'judgeme_preview_badge',
              jm_style: '',
              concierge_install: false,
              product: card_product
            %}
          {% endcomment %}
          {% comment %}
            <!-- TrustBox widget - Product Mini MultiSource -->

              <div class="trustpilot-widget" data-locale="en-GB" data-template-id="577258fb31f02306e4e3aaf9" data-businessunit-id="635414ed2d0f99d637c4b0f1" data-style-height="24px" data-style-width="100%" data-token="80cd7430-131e-4f7b-97cc-aae7234dd24e" data-sku="{{ card_product.selected_or_first_available_variant.sku }}" data-no-reviews="hide" data-scroll-to-list="true" data-style-alignment="left">
                <a href="https://uk.trustpilot.com/review/ubbspouches.com" target="_blank" rel="noopener">Trustpilot</a>
              </div>

            <!-- End TrustBox widget -->
          {% endcomment %}

          {% for variant in card_product.variants %}
            {% if variant.sku != blank %}
              {% assign all_skus = all_skus | append: variant.sku | append: ',' %}
            {% endif %}
          {% endfor %}

          {% assign all_skus = all_skus | remove_last: ',' %}

          {% comment %}
            <!-- TrustBox widget - Product Mini MultiSource -->
            <div class="trustpilot-rating-link" onclick="window.location.href='{{ card_product.url }}#tab_section'">
              <div
                class="trustpilot-widget"
                data-locale="en-GB"
                data-template-id="577258fb31f02306e4e3aaf9"
                data-businessunit-id="635414ed2d0f99d637c4b0f1"
                data-style-height="24px"
                data-style-width="100%"
                data-token="80cd7430-131e-4f7b-97cc-aae7234dd24e"
                data-sku="{{ all_skus }}"
                data-no-reviews="hide"
                data-scroll-to-list="true"
                data-style-alignment="left"
              >
                <a href="https://uk.trustpilot.com/review/ubbspouches.com" target="_blank" rel="noopener">Trustpilot</a>
              </div>
            </div>
            <!-- End TrustBox widget ss -->
          {% endcomment %}

          <div class="card-information">
            {%- if show_vendor -%}
              <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
              <div class="caption-with-letter-spacing light">{{ card_product.vendor }}</div>
            {%- endif -%}

            {% if card_product.metafields.custom.seo_description %}
              <div class="caption-largexx add-read-more show-less-content">
                {{ card_product.metafields.custom.seo_description }}
              </div>
            {% endif %}

            <span class="caption-large light">{{ block.settings.description | escape }}</span>

            {%- if show_rating and card_product.metafields.reviews.rating.value != blank -%}
              {% liquid
                assign rating_decimal = 0
                assign decimal = card_product.metafields.reviews.rating.value.rating | modulo: 1
                if decimal >= 0.3 and decimal <= 0.7
                  assign rating_decimal = 0.5
                elsif decimal > 0.7
                  assign rating_decimal = 1
                endif
              %}
              <div
                class="rating"
                role="img"
                aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: card_product.metafields.reviews.rating.value, rating_max: card_product.metafields.reviews.rating.value.scale_max }}"
              >
                <span
                  aria-hidden="true"
                  class="rating-star color-icon-{{ settings.accent_icons }}"
                  style="--rating: {{ card_product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ card_product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
                ></span>
              </div>
              <p class="rating-text caption">
                <span aria-hidden="true">
                  {{- card_product.metafields.reviews.rating.value }} /
                  {{ card_product.metafields.reviews.rating.value.scale_max -}}
                </span>
              </p>
              <p class="rating-count caption">
                <span aria-hidden="true">({{ card_product.metafields.reviews.rating_count }})</span>
                <span class="visually-hidden">
                  {{- card_product.metafields.reviews.rating_count }}
                  {{ 'accessibility.total_reviews' | t -}}
                </span>
              </p>
            {%- endif -%}

            <div class="review_price_sec">
              {% if card_product.tags contains 'coming_soon' %}
                <p>Coming Soon</p>
              {% else %}
                {% render 'price', product: card_product, price_class: '' %}
              {% endif %}
              {% comment %}
                {% unless card_product.tags contains 'Bundle' or card_product.tags contains 'main_wholesale_product' %}
                  <div class="multibuy_title_text">
                    <span class="small-hide">
                      From <b>£2.35</b> with <a href="javascript:void(0)" class="Click-here underlined-link">Multibuy</a>.
                    </span>
                    <span class="large-up-hide medium-hide">
                      <a href="javascript:void(0)" class="Click-here underlined-link">From <b>£2.35</b></a>
                    </span>
                  </div>
                {% endunless %}
              {% endcomment %}
            </div>

            {% unless card_product.tags contains 'coming_soon' %}
              <div class="quantity_variant_sec">
                <legend class="form__label">Choose your strength</legend>
                <variant-radios
                  class="no-js-hidden card_product_variant {{ card_product.handle }}"
                  data-section="{{ section.id }}"
                  data-url="{{ card_product.url }}"
                  {{ block.shopify_attributes }}
                >
                  {%- for option in card_product.options_with_values -%}
                    {% comment %}
                      <selected
                        class="{{ card_product.handle }} variant_selection"
                        data-available="{{ card_product.selected_or_first_available_variant.available }}"
                        data-variant-image="{{ card_product.selected_or_first_available_variant.featured_image | image_url: width: 533 }}"
                      >
                        <p class="font_text">{{ card_product.selected_or_first_available_variant.title }} / pouch</p>
                        <div>
                          {% if card_product.selected_or_first_available_variant.title == 'Regular: 6mg' %}
                            <span class="dot"></span>
                            <span class="dot"></span>
                            <span class="circle"></span>
                            <span class="circle"></span>
                          {% elsif card_product.selected_or_first_available_variant.title == 'Strong: 11mg' %}
                            <span class="dot"></span>
                            <span class="dot"></span>
                            <span class="dot"></span>
                            <span class="dot"></span>
                          {% elsif card_product.selected_or_first_available_variant.title == 'Mild: 4mg' %}
                            <span class="dot"></span>
                            <span class="circle"></span>
                            <span class="circle"></span>
                            <span class="circle"></span>
                          {% else %}
                            <span class="dot"></span>
                            <span class="dot"></span>
                            <span class="dot"></span>
                            <span class="dot"></span>
                            <span class="dot"></span>
                          {% endif %}
                        </div>
                      </selected>
                    {% endcomment %}
                    <fieldset class="coll-fieldset variant_selection js product-form__input radio_btn {% if card_product.tags contains 'Bundle' %}bundle_product{% endif %}">
                      {%- for value in option.values -%}
                        <div style="position: relative;flex: 1 1 auto;">
                          {% assign variant = card_product.variants | where: 'option1', value | first %}
                          <input
                            type="radio"
                            id="{{ variant.id }}-{{ option.position }}-{{ forloop.index0 }}"
                            name="{{ option.name }}-{{ card_product.handle }}"
                            value="{{ value | escape }}"
                            form="{{ product_form_id }}"
                            data-available="{{ variant.available }}"
                            data-variant="{{ variant.id }}"
                            imgSrc="{{ variant.image | img_url:'' }}"
                            data-variant-image="{{ card_product.selected_or_first_available_variant.featured_image | image_url: width: 533 }}"
                            {% if option.selected_value == value %}
                              checked="checked"
                            {% endif %}
                          >
                          <label for="{{ variant.id }}-{{ option.position }}-{{ forloop.index0 }}">
                            <span>
                              {{- value | split: ':' | last | remove: 'mg' -}}
                              mg</span
                            >
                            {% comment %}
                              <p class="font_text"></p>
                               <div>
                                 {% if value == 'Regular: 6mg' %}
                                   <span class="dot"></span>
                                   <span class="dot"></span>
                                   <span class="circle"></span>
                                   <span class="circle"></span>
                                 {% elsif value == 'Strong: 11mg' %}
                                   <span class="dot"></span>
                                   <span class="dot"></span>
                                   <span class="dot"></span>
                                   <span class="dot"></span>
                                 {% elsif value == 'Mild: 4mg' %}
                                   <span class="dot"></span>
                                   <span class="circle"></span>
                                   <span class="circle"></span>
                                   <span class="circle"></span>
                                 {% elsif value == 'Intense: 20mg' %}
                                   <span class="dot"></span>
                                   <span class="dot"></span>
                                   <span class="dot"></span>
                                   <span class="dot"></span>
                                   <span class="dot"></span>
                                   <span class="dot"></span>
                                 {% else %}
                                   <span class="dot"></span>
                                   <span class="dot"></span>
                                   <span class="dot"></span>
                                   <span class="dot"></span>
                                   <span class="dot"></span>
                                 {% endif %}
                               </div>
                            {% endcomment %}
                          </label>
                        </div>
                      {%- endfor -%}
                    </fieldset>
                  {%- endfor -%}
                  <script
                    type="application/json"
                    class="card-product-variants-json"
                  >
                    {{ card_product.variants | json }}
                  </script>
                </variant-radios>

                <noscript class="product-form__noscript-wrapper-{{ section.id }}">
                  <div class="product-form__input{% if product.has_only_default_variant %} hidden{% endif %}">
                    <label class="form__label" for="Variants-{{ section.id }}">
                      {{- 'products.product.product_variants' | t -}}
                    </label>
                    <div class="select">
                      <select
                        name="id"
                        id="Variants-{{ section.id }}"
                        class="select__select"
                        form="{{ product_form_id }}"
                      >
                        {%- for variant in product.variants -%}
                          <option
                            {% if variant == product.selected_or_first_available_variant %}
                              selected="selected"
                            {% endif %}
                            {% if variant.available == false %}
                              disabled
                            {% endif %}
                            value="{{ variant.id }}"
                          >
                            {{ variant.title }}
                            {%- if variant.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}
                            - {{ variant.price | money | strip_html }}
                          </option>
                        {%- endfor -%}
                      </select>
                      {% render 'icon-caret' %}
                    </div>
                  </div>
                </noscript>
              </div>

              <div class="cart_btn_sec">
                {% comment %}
                  <div
                    class="product-form__input product-form__quantity{% if settings.inputs_shadow_vertical_offset != 0 and settings.inputs_shadow_vertical_offset < 0 %} product-form__quantity-top{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    <label class="form__label hidden" for="Quantity-{{ section.id }}">
                      {{ 'products.product.quantity.label' | t }}
                    </label>
                  </div>
                {% endcomment %}
                {%- render 'buy-buttons',
                  block: block,
                  product: card_product,
                  product_form_id: product_form_id,
                  section_id: section.id,
                  show_pickup_availability: true
                -%}
                {% comment %}
                  <div class="11 product-form__buttons">
                    <button
                      type="button"
                      class="cmn_btn cart_btn card_cart_btn button button--primary"
                      form="{{ product_form_id }}"
                      {% if card_product.selected_or_first_available_variant.available == false %}
                        disabled
                      {% endif %}
                    >
                      <span>
                        {% if card_product.selected_or_first_available_variant.available %}
                          {{ 'products.product.add_to_cart' | t }}
                        {% else %}
                          {{ 'products.product.sold_out' | t }}
                        {% endif %}
                      </span>
                    </button>
                  </div>
                {% endcomment %}
              </div>
            {% endunless %}
          </div>
        </div>

        {%- if show_quick_add -%}
          <div class="quick-add">
            {%- assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id -%}
            {%- if card_product.has_only_default_variant -%}
              <product-form>
                {%- form 'product',
                  card_product,
                  id: product_form_id,
                  class: 'form',
                  novalidate: 'novalidate',
                  data-type: 'add-to-cart-form'
                -%}
                  <input
                    type="hidden"
                    name="id"
                    value="{{ card_product.selected_or_first_available_variant.id }}"
                    disabled
                  >
                  <button
                    id="{{ product_form_id }}-submit"
                    type="submit"
                    name="add"
                    class="quick-add__submit button button--full-width button--secondary"
                    aria-haspopup="dialog"
                    aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                    aria-live="polite"
                    data-sold-out-message="true"
                    {% if card_product.selected_or_first_available_variant.available == false %}
                      disabled
                    {% endif %}
                  >
                    <span>
                      {%- if card_product.selected_or_first_available_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                    <span class="sold-out-message hidden">
                      {{ 'products.product.sold_out' | t }}
                    </span>
                    <div class="loading-overlay__spinner hidden">
                      <svg
                        aria-hidden="true"
                        focusable="false"
                        role="presentation"
                        class="spinner"
                        viewBox="0 0 66 66"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                      </svg>
                    </div>
                  </button>
                {%- endform -%}
              </product-form>
            {%- else -%}
              <modal-opener data-modal="#QuickAdd-{{ card_product.id }}">
                <button
                  id="{{ product_form_id }}-submit"
                  type="submit"
                  name="add"
                  class="quick-add__submit button button--full-width button--secondary"
                  aria-haspopup="dialog"
                  aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                  data-product-url="{{ card_product.url }}"
                >
                  {{ 'products.product.choose_options' | t }}
                  <div class="loading-overlay__spinner hidden">
                    <svg
                      aria-hidden="true"
                      focusable="false"
                      role="presentation"
                      class="spinner"
                      viewBox="0 0 66 66"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                    </svg>
                  </div>
                </button>
              </modal-opener>
              <quick-add-modal id="QuickAdd-{{ card_product.id }}" class="quick-add-modal">
                <div
                  role="dialog"
                  aria-label="{{ 'products.product.choose_product_options' | t: product_name: card_product.title | escape }}"
                  aria-modal="true"
                  class="quick-add-modal__content global-settings-popup"
                  tabindex="-1"
                >
                  <button
                    id="ModalClose-{{ card_product.id }}"
                    type="button"
                    class="quick-add-modal__toggle"
                    aria-label="{{ 'accessibility.close' | t }}"
                  >
                    {% render 'icon-close' %}
                  </button>
                  <div id="QuickAddInfo-{{ card_product.id }}" class="quick-add-modal__content-info"></div>
                </div>
              </quick-add-modal>
            {%- endif -%}
          </div>
        {%- endif -%}
        <div class="card__badge sold_out_badge{{ settings.badge_position }}">
          {%- if card_product.available == false -%}
            <span class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }}">
              {{- 'products.product.sold_out' | t -}}
            </span>
          {%- elsif card_product.compare_at_price > card_product.price and card_product.available -%}
            <span class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}">
              {{- 'products.product.on_sale' | t -}}
            </span>
          {%- endif -%}
        </div>
      </div>
    </div>
    <!--
      ========================================
           QUANTITY POPUP
      =========================================
    -->

    <div
      class="card-quantity-popup"
      hidden
      role="dialog"
      aria-modal="true"
      aria-label="Select quantity"
    >
      <div class="card-quantity-popup-overlay"></div>

      <div class="card-quantity-popup-inner">
        <!-- CLOSE -->

        <button
          type="button"
          class="card-quantity-close"
          aria-label="Close quantity selector"
        >
          <span aria-hidden="true">×</span>
        </button>

        <!--
          ====================================
               PRODUCT HEADER
          =====================================
        -->

        <div class="card-quantity-popup-header">
          <div class="card-quantity-popup-product">
            {% if selected_variant.featured_image %}
              <img
                class="card-quantity-popup-image"
                src="{{ selected_variant.featured_image | image_url: width: 120 }}"
                alt="{{ card_product.title | escape }}"
                width="70"
                height="70"
                loading="lazy"
              >

            {% elsif card_product.featured_media %}
              <img
                class="card-quantity-popup-image"
                src="{{ card_product.featured_media | image_url: width: 120 }}"
                alt="{{ card_product.title | escape }}"
                width="70"
                height="70"
                loading="lazy"
              >
            {% endif %}

            <div class="card-quantity-popup-product-info">
              <h4 class="card-quantity-product-title">
                {{ card_product.title | escape | remove: 'Übbs' | remove: 'Nicotine Pouches' }}
              </h4>

              <p class="card-quantity-variant">
                {{ selected_variant.title }}
              </p>
            </div>
          </div>
        </div>

        <!--
          ====================================
               QUANTITY OPTIONS
          =====================================
        -->

        <div class="card-quantity-options">
          <!-- 1 PACK -->

          <button
            type="button"
            class="card-quantity-option is-selected"
            data-quantity="1"
            data-discount="{{ pack_1_discount }}"
          >
            <span class="quantity-option-radio"></span>

            <span class="quantity-option-name"> 1-Pack </span>
            {% comment %} <span class="quantity-option-discount" style="opacity: 0;"></span> {% endcomment %}
            <strong class="quantity-option-price"></strong>

            <span class="quantity-option-per-can"></span>
          </button>

          <!-- 3 PACK -->

          <button
            type="button"
            class="card-quantity-option"
            data-quantity="3"
            data-discount="{{ pack_3_discount }}"
          >
            <span class="quantity-option-radio"></span>

            <span class="quantity-option-name"> 3-Pack </span>
            {% comment %} <span class="quantity-option-discount">Save 10%</span> {% endcomment %}
            <strong class="quantity-option-price"></strong>

            <span class="quantity-option-per-can"></span>
          </button>

          <!-- 6 PACK -->

          <button
            type="button"
            class="card-quantity-option"
            data-quantity="6"
            data-discount="{{ pack_6_discount }}"
          >
            <span class="quantity-option-radio"></span>

            <span class="quantity-option-name"> 6-Pack </span>
            {% comment %} <span class="quantity-option-discount">Save 20%</span> {% endcomment %}
            <strong class="quantity-option-price"></strong>

            <span class="quantity-option-per-can"></span>
          </button>

          <!-- 12 PACK -->

          <button
            type="button"
            class="card-quantity-option"
            data-quantity="12"
            data-discount="{{ pack_12_discount }}"
          >
            <span class="quantity-option-radio"></span>

            <span class="quantity-option-name"> 12-Pack </span>
            {% comment %} <span class="quantity-option-discount">Save 30%</span> {% endcomment %}

            <strong class="quantity-option-price"></strong>

            <span class="quantity-option-per-can"></span>
          </button>

          <!-- 24 PACK -->

          <button
            type="button"
            class="card-quantity-option"
            data-quantity="24"
            data-discount="{{ pack_24_discount }}"
          >
            <span class="quantity-option-radio"></span>

            <span class="quantity-option-name"> 24-Pack </span>
            {% comment %} <span class="quantity-option-discount">Save 33%</span> {% endcomment %}

            <strong class="quantity-option-price"></strong>

            <span class="quantity-option-per-can"></span>
          </button>
        </div>

        <!--
          ====================================
               CUSTOM QUANTITY
          =====================================
        -->

        <div class="card-custom-quantity">
          <span> Select Custom Quantity </span>

          <div class="card-custom-quantity-controls">
            <button
              type="button"
              class="card-custom-quantity-minus"
              aria-label="Decrease quantity"
            >
              −
            </button>

            <span class="card-custom-quantity-value"> 1 </span>

            <button
              type="button"
              class="card-custom-quantity-plus"
              aria-label="Increase quantity"
            >
              +
            </button>
          </div>
        </div>

        <!--
          ====================================
               POPUP ADD TO BASKET
          =====================================
        -->

        <button
          type="button"
          class="card-popup-add-button"
        >
          Add to basket
          <span class="card-popup-total-price hidden"></span>
        </button>
      </div>
    </div>
  </div>
{%- else -%}
  <div class="card-wrapper underline-links-hover">
    <div
      class="
        card
        card--{{ settings.card_style }}
        card--text
        {% if extend_height %} card--extend-height{% endif %}
        {% if settings.card_style == 'card' %} color-{{ settings.card_color_scheme }} gradient{% endif %}
        {% if card_product.featured_media == nil and settings.card_style == 'card' %} ratio{% endif %}
      "
      style="--ratio-percent: 100%;"
    >
      <div
        class="card__inner {% if settings.card_style == 'standard' %}color-{{ settings.card_color_scheme }} gradient{% endif %}{% if settings.card_style == 'standard' %} ratio{% endif %}"
        style="--ratio-percent: 100%;"
      >
        <div class="card__content">
          <div class="card__information">
            <h3 class="card__heading">
              <a role="link" aria-disabled="true" class="full-unstyled-link">
                {{ 'onboarding.product_title' | t }}
              </a>
            </h3>
          </div>
        </div>
      </div>
      <div class="card__content">
        <div class="card__information">
          <h3 class="card__heading{% if settings.card_style == 'standard' %} h5{% endif %}">
            <a role="link" aria-disabled="true" class="full-unstyled-link">
              {{ 'onboarding.product_title' | t }}
            </a>
          </h3>
          <div class="card-information">
            {%- if show_vendor -%}
              <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
              <div class="caption-with-letter-spacing light">{{ 'products.product.vendor' | t }}</div>
            {%- endif -%}
            {% render 'price' %}
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}


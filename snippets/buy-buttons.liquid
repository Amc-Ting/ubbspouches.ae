{% comment %}
  Renders product buy-buttons.

  Updated:
  - Custom quantity selector
  - Quantity popup
  - 1 / 3 / 6 / 12 / 24 pack options
  - Dynamic pack pricing
  - Dynamic Add to Basket price
  - Keeps Shopify quantity input inside product form
  - Works with product-card variant selection

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} product form id.
  - section_id: {String} id of section to which this snippet belongs.
  - show_pickup_availability: {Boolean}
{% endcomment %}

{%- if product != blank -%}
  {%- liquid
    assign gift_card_recipient_feature_active = false

    if block.settings.show_gift_card_recipient and product.gift_card?
      assign gift_card_recipient_feature_active = true
    endif

    assign show_dynamic_checkout = false

    if block.settings.show_dynamic_checkout and gift_card_recipient_feature_active == false
      assign show_dynamic_checkout = true
    endif

    assign selected_variant = product.selected_or_first_available_variant

    assign pack_1_discount = 0
    assign pack_3_discount = 10
    assign pack_6_discount = 20
    assign pack_12_discount = 30
    assign pack_24_discount = 32.86
  -%}
  {% comment %}
    assign pack_1_discount = 0
    assign pack_3_discount = 41.55
    assign pack_6_discount = 56.60
    assign pack_12_discount = 58.26
    assign pack_24_discount = 61.60
  {% endcomment %}
  <div
    class="main_atc_btn card-main-atc"
    data-card-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle }}"
    {{ block.shopify_attributes }}
  >
    <product-form
      class="product-form"
      data-hide-errors="{{ gift_card_recipient_feature_active }}"
      data-section-id="{{ section.id }}"
      data-product-handle="{{ product.handle }}"
    >
      <div
        class="product-form__error-message-wrapper"
        role="alert"
        hidden
      >
        <span class="svg-wrapper">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>

        <span class="product-form__error-message"></span>
      </div>

      {%- form 'product',
        product,
        id: product_form_id,
        class: 'form card-product-form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      -%}
        <div
          class="card-quantity-selector"
          id="CardQuantity-{{ section_id }}-{{ product.id }}"
          data-default-quantity="1"
          data-unit-price="{{ selected_variant.price }}"
        >
          <button
            type="button"
            class="card-quantity-trigger"
            aria-expanded="false"
            aria-haspopup="dialog"
          >
            <span class="card-quantity-label"> Quantity </span>

            <span
              class="card-quantity-selected"
            >
              1-Pack
            </span>

            <span class="card-quantity-arrow">
              <svg
                width="10"
                height="6"
                viewBox="0 0 10 6"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M1 1L5 5L9 1"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>
          </button>

          <input
            type="hidden"
            class="card-quantity-input"
            name="quantity"
            value="1"
            min="1"
          >

          <input
            type="hidden"
            name="id"
            value="{{ selected_variant.id }}"
            {% if selected_variant.available == false or quantity_rule_soldout or selected_variant == null %}
              disabled
            {% endif %}
            class="product-variant-id"
          >

          {%- if gift_card_recipient_feature_active -%}
            {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
          {%- endif -%}

          <div class="product-form__buttons new">
            {%- liquid
              assign check_against_inventory = true

              if selected_variant.inventory_management != 'shopify' or selected_variant.inventory_policy == 'continue'
                assign check_against_inventory = false
              endif

              assign quantity_rule_soldout = false

              if selected_variant.quantity_rule.min > selected_variant.inventory_quantity and check_against_inventory
                assign quantity_rule_soldout = true
              endif
            -%}

            <button
              id="ProductSubmitButton-{{ section_id }}-{{ product.id }}"
              type="submit"
              name="add"

              class="cmn_btn product-form__submit button button--full-width {% if show_dynamic_checkout %}button--secondary{% else %}button--primary{% endif %}"

              {% if selected_variant.available == false or quantity_rule_soldout or selected_variant == null %}
                disabled
              {% endif %}
            >
              <span class="product-form-submit-text">
                {%- if selected_variant == null -%}
                  {{ 'products.product.unavailable' | t }}

                {%- elsif selected_variant.available == false or quantity_rule_soldout -%}
                  {{ 'products.product.sold_out' | t }}

                {%- else -%}
                  Add to basket <span class="product-form-submit-price"></span>
                {%- endif -%}
              </span>

              {%- render 'loading-spinner' -%}
            </button>

            {%- if show_dynamic_checkout -%}
              {{ form | payment_button }}
            {%- endif -%}
          </div>
        </div>
      {%- endform -%}
    </product-form>
  </div>

{%- else -%}
  <!--
    ==========================================
         PRODUCT EMPTY
    ===========================================
  -->

  <div class="main_atc_btn">
    <div class="product-form">
      <div class="product-form__buttons form">
        <button
          type="submit"
          name="add"
          class="product-form__submit button button--full-width button--primary"
          disabled
        >
          {{ 'products.product.sold_out' | t }}
        </button>
      </div>
    </div>
  </div>
{%- endif -%}

{%- if show_pickup_availability and product != blank -%}
  {{ 'component-pickup-availability.css' | asset_url | stylesheet_tag }}

  {%- assign pick_up_availabilities = product.selected_or_first_available_variant.store_availabilities
    | where: 'pick_up_enabled', true
  -%}

  <pickup-availability
    class="product__pickup-availabilities quick-add-hidden"

    {% if product.selected_or_first_available_variant.available and pick_up_availabilities.size > 0 %}
      available
    {% endif %}

    data-root-url="{{ routes.root_url }}"

    data-variant-id="{{ product.selected_or_first_available_variant.id }}"

    data-has-only-default-variant="{{ product.has_only_default_variant }}"

    data-product-page-color-scheme="gradient color-{{ section.settings.color_scheme }}"
  >
    <template>
      <pickup-availability-preview
        class="pickup-availability-preview"
      >
        <span class="svg-wrapper">
          {{- 'icon-unavailable.svg' | inline_asset_content -}}
        </span>

        <div class="pickup-availability-info">
          <p class="caption-large">
            {{ 'products.product.pickup_availability.unavailable' | t }}
          </p>

          <button
            class="pickup-availability-button link link--text underlined-link"
          >
            {{ 'products.product.pickup_availability.refresh' | t }}
          </button>
        </div>
      </pickup-availability-preview>
    </template>
  </pickup-availability>

  {% comment %}
    <script
      src="{{ 'pickup-availability.js' | asset_url }}"
      defer="defer"
    ></script>
  {% endcomment %}
{%- endif -%}

<style>
  .card-quantity-selector {
    position: relative;
    width: 100%;
    margin-bottom: 7px;
    display: flex;
    gap:0.5rem;
    max-width: 100%;
    justify-content: space-between;
  }
  .card-quantity-trigger {
    width: 100%;
    /*max-width:140px;*/
    min-height: 40px;
    padding: 5px;
    border: 0;
    background: transparent;
    display: flex;
    align-items: center;
    cursor: pointer;
    color: #000;
    font-family: inherit;
    font-size: 14px;
    text-align: left;
    border: 1px solid #000;
    border-radius: 50px;
    padding: 5px 10px;
  }
  .upsell-actions .card-quantity-trigger,
  .upsell-actions .product-form-submit-price{
    display:none;
  }
  @media screen and (max-width: 767px) {
    .card-quantity-label{
      flex:1;
    }
    .card-quantity-selector {
      flex-direction: column;
      gap:1rem;
      margin-bottom:0;
    }
  }
  {% comment %} .card-quantity-label {
    margin-right: auto;
  } {% endcomment %}

  .card-quantity-selected {
    margin-left: 5px;
    font-weight: 500;
    white-space: nowrap;
  }

  .card-quantity-arrow {
    margin-left: 5px;
    display: flex;
    align-items: center;
    transition: transform .2s ease;
  }

  .card-quantity-trigger[aria-expanded="true"]
  .card-quantity-arrow {
    transform: rotate(180deg);
  }

  .card-quantity-popup {
    position: fixed;

    inset: 0;

    z-index: 999999;

    display: flex;

    align-items: center;
    justify-content: center;
  }

  .card-quantity-popup[hidden] {
    display: none;
  }


  .card-quantity-popup-overlay {
    position: absolute;

    inset: 0;

    background: rgba(0,0,0,.4);
  }


  .card-quantity-popup-inner {

    position: relative;

    z-index: 2;

    width: calc(100% - 30px);
    max-width: 440px;

    max-height: 90vh;

    overflow-y: auto;

    background: #fff;

    border-radius: 16px;

    padding: 20px 16px 18px;

    box-shadow:
      0 15px 50px rgba(0,0,0,.2);
  }

  .card-quantity-close {

    position: absolute;

    top: 8px;
    right: 10px;

    width: 32px;
    height: 32px;

    border: 0;

    background: transparent;

    cursor: pointer;

    font-size: 28px;

    line-height: 1;

    color: #333;

    padding: 0;
  }

  .card-quantity-popup-header {

    padding-right: 35px;

    margin-bottom: 10px;
  }


  .card-quantity-popup-product {

    display: flex;

    align-items: center;

    gap: 12px;
  }


  .card-quantity-popup-image {

    width: 65px;
    height: 65px;

    object-fit: contain;

    flex-shrink: 0;
  }


  .card-quantity-popup-product-info {
    min-width: 0;
  }


  .card-quantity-product-title {

    margin: 0 0 5px;

    font-size: 16px;

    line-height: 1.2;

    font-weight: 700;

    text-transform: uppercase;
  }


  .card-quantity-variant {

    margin: 0;

    font-size: 13px;

    line-height: 1.2;

    font-weight: 600;

    text-transform: uppercase;
  }

  .card-quantity-options {

    border-top: 1px solid #ddd;
  }


  .card-quantity-option {

    width: 100%;

    min-height: 42px;

    display: grid;

    grid-template-columns:
      20px
      1fr
      auto
      auto
      auto;

    align-items: center;

    column-gap: 8px;

    padding: 7px 3px;

    border: 0;

    border-bottom: 1px solid #ddd;

    background: #fff;

    cursor: pointer;

    color: #000;

    font-family: inherit;

    text-align: left;
  }


  .card-quantity-option:hover {
    background: #fafafa;
  }


  .quantity-option-radio {

    width: 16px;
    height: 16px;

    border-radius: 50%;

    border: 1px solid #aaa;

    position: relative;
  }


  .card-quantity-option.is-selected
  .quantity-option-radio {

    border-color: #45ae5a;

    background: #45ae5a;
  }


  .card-quantity-option.is-selected
  .quantity-option-radio::after {

    content: "";

    position: absolute;

    width: 7px;
    height: 4px;

    left: 4px;
    top: 4px;

    border-left: 2px solid #fff;
    border-bottom: 2px solid #fff;

    transform: rotate(-45deg);
  }


  .quantity-option-name {

    font-size: 14px;
  }


  .quantity-option-price {
    font-size: 14px;
    white-space: nowrap;
    min-width: 45px;
    text-align: right;
  }


  .quantity-option-per-can {

    min-width: 68px;

    font-size: 12px;

    text-align: right;

    white-space: nowrap;

    color: #333;
  }

  .quantity-option-discount{
    font-size: 10px;
    background-color: #ffa77e;
    padding: 0px 6px 2px;
    line-height: 1.5;
    border-radius: 20px;
    color: #fff;
    margin-right: 2rem;
  }
  .card-custom-quantity {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 10px;

    padding: 12px 0 10px;

    font-size: 11px;

    color: #777;
  }


  .card-custom-quantity-controls {

    display: flex;

    align-items: center;

    border: 1px solid #ddd;

    border-radius: 20px;

    overflow: hidden;

    height: 34px;
  }


  .card-custom-quantity-controls button {

    width: 32px;
    height: 32px;

    border: 0;

    background: #fff;

    cursor: pointer;

    font-size: 18px;

    line-height: 1;

    color: #000;
  }


  .card-custom-quantity-value {

    min-width: 30px;

    text-align: center;

    font-size: 14px;

    font-weight: 600;

    color: #000;
  }

  .card-popup-add-button {

    width: 100%;

    min-height: 44px;

    border: 0;

    border-radius: 25px;

    background: #000;

    color: #fff;

    cursor: pointer;

    font-family: inherit;

    font-size: 15px;

    font-weight: 600;

    padding: 10px 16px;
  }


  .card-popup-add-button:hover {
    opacity: .9;
  }

  .card-main-atc
  .product-form__buttons {

    width: 100%;
  }


  .card-main-atc
  .product-form__submit {

    min-height: 42px;

    border-radius: 25px;

    font-size: 14px;
  }


  .product-form-submit-price {
    white-space: nowrap;
  }


  /* ==========================================
     DESKTOP
  ========================================== */

  @media screen and (min-width: 768px) {

    .card-quantity-popup-inner {

      width: 430px;

      border-radius: 16px;

    }

  }


  /* ==========================================
     MOBILE
  ========================================== */

  @media screen and (max-width: 767px) {

    .card-quantity-popup {

      align-items: center; /*flex-end;*/

    }


    .card-quantity-popup-inner {

      width: 100%;

      max-width: 100%;

      border-radius: 18px;

      padding-bottom: 22px;

    }


    .card-quantity-option {

      min-height: 44px;

    }


    .quantity-option-name {

      font-size: 13px;

    }


    .quantity-option-price {

      font-size: 13px;

    }


    .quantity-option-per-can {

      font-size: 12px;

    }

  }


  /* Prevent background scrolling */

  body.card-quantity-popup-open {
    overflow: hidden;
  }
</style>

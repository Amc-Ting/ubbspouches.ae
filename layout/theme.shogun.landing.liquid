<script>
        // Check if the cart has already been cleared in this session
        if (!sessionStorage.getItem('cartCleared')) {
          // Fetch the cart to check for any items
          fetch('/cart.js')
            .then((response) => response.json())
            .then((data) => {
              if (data.items.length > 0) {
                // Clear the cart
                fetch('/cart/clear.js', { method: 'POST' })
                  .then(() => {
                    {% comment %} console.log('Cart cleared successfully.'); {% endcomment %}
                    // Mark the cart as cleared in this session
                    sessionStorage.setItem('cartCleared', 'true');
                  })
                  .catch((error) => {
                    console.error('Error clearing cart:', error);
                  });
              }
            });
        }
      </script>

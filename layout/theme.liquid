    {% comment %}
      <script>
        document.addEventListener('DOMContentLoaded', function () {

          const isB2B = {{ customer and customer.tags contains 'Approved' | json }};
          const isLoggedIn = {{ customer | json }} ? true : false;

          /* Detect login/logout change */
          const previousLoginState = sessionStorage.getItem('customerLoggedIn');

          if (previousLoginState !== null && previousLoginState !== String(isLoggedIn)) {
            sessionStorage.setItem('customerLoggedIn', isLoggedIn);
            location.reload(); // force reload so cart validation runs clean
            return;
          }

          sessionStorage.setItem('customerLoggedIn', isLoggedIn);

          function validateCart() {

            fetch('/cart.js', { cache: "no-store" })
              .then(res => res.json())
              .then(cart => {

                if (!cart.items.length) return;

                const updates = {};

                cart.items.forEach(item => {

                  /* B2B → remove retail products */
                  if (isB2B && item.product_type !== 'Wholesale') {
                    updates[item.key] = 0;
                  }

                  /* Retail / logged out → remove wholesale products */
                  if (!isB2B && item.product_type === 'Wholesale') {
                    updates[item.key] = 0;
                  }

                });

                if (Object.keys(updates).length === 0) return;

                fetch('/cart/update.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ updates })
                })
                .then(() => {

                  console.log('Cart cleaned after login/logout state change');

                  /* Refresh cart drawer */
                  document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));

                });

              });

          }

          validateCart();

          setTimeout(validateCart, 1200);

        });
      </script>
    {% endcomment %}

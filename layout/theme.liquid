    <script>
      let w = window.innerWidth;
      {% comment %} console.log('width=' + window.innerWidth); {% endcomment %}
      function bindMouseOverToMegaMenu(item) {
        item.addEventListener('mouseover', () => {
          item.setAttribute('open', true);

          item.querySelector('.mega-menu__content').addEventListener('mouseover', () => {
            item.setAttribute('open', true);
          });
          item.querySelector('.mega-menu__content').addEventListener('mouseleave', () => {
            setTimeout(() => {
              item.removeAttribute('open');
              console.log("set2")
            }, 200);
          });
          item.addEventListener('mouseleave', () => {
            setTimeout(() => {
              item.removeAttribute('open');
              console.log("set2")
            }, 200);
            });
        });
      }
      let items = document.querySelector('.header__inline-menu').querySelectorAll('details.mega-menu');
      let summaryItems = document.querySelector('.header__inline-menu').querySelectorAll('summary.header__menu-item');
      if (w > 1100) {
        items.forEach(bindMouseOverToMegaMenu);
      }
    </script>

    {% if customer and customer.tags contains 'Approved' %}
      <script>
        // Check if the cart has already been cleared in this session
        if (!sessionStorage.getItem('cartCleared')) {
          // Fetch the cart to check for any items
          fetch('/cart.js')
            .then((response) => response.json())
            .then((data) => {
              if (data.items.length > 0) {
                // Clear the cart
                fetch('/cart/clear.js', { method: 'POST' })
                  .then(() => {
                    {% comment %} console.log('Cart cleared successfully.'); {% endcomment %}
                    // Mark the cart as cleared in this session
                    sessionStorage.setItem('cartCleared', 'true');
                  })
                  .catch((error) => {
                    console.error('Error clearing cart:', error);
                  });
              }
            });
        }
      </script>
    {% endif %}
    {% if customer and customer.tags contains 'Approved' %}
      <script>
        // Check if the current page is "/account" and has the "just_logged_in" flag
        const urlParams = new URLSearchParams(window.location.search);
        if (window.location.pathname === '/account' && urlParams.has('just_logged_in')) {
          // Redirect to the wholesale page
          window.location.href = '/pages/wholesale';
        }
      </script>
    {% endif %}


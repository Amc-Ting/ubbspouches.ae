    {% comment %}
      {% if customer and customer.tags contains 'Approved' %}
        <script>
          document.addEventListener('DOMContentLoaded', function () {
            // Wait for the page to load fully
            setTimeout(() => {
              // Fetch the cart data to inspect
              fetch('/cart.js')
                .then((response) => response.json())
                .then((data) => {
                  {% comment %} console.log('Cart items for approved customer:', data.items); {% endcomment %}

                  // Check if the cart contains non-wholesale products (not of product_type "Wholesale")
                  const hasNonWholesaleProducts = data.items.some((item) => {
                    {% comment %} console.log('Checking product type:', item.product_type); // Log to inspect product type {% endcomment %}
                    return item.product_type !== 'Wholesale'; // Check product_type instead of tags
                  });

                  // If non-wholesale products are found, clear the cart
                  if (hasNonWholesaleProducts) {
                    {% comment %} console.log('Cart contains non-wholesale products, clearing cart.'); {% endcomment %}
                    fetch('/cart/clear.js', { method: 'POST' })
                      .then(() => {
                        console.log('Cart cleared successfully for wholesale login.');
                      })
                      .catch((error) => {
                        console.error('Error clearing cart for wholesale login:', error);
                      });
                  } else {
                    console.log('No non-wholesale products in the cart, no action taken.');
                  }
                })
                .catch((error) => {
                  console.error('Error fetching cart data for approved customer:', error);
                });
            }, 500); // Adding delay to ensure content is fully loaded
          });
        </script>
      {% endif %}
    {% endcomment %}

    {% if customer and customer.tags contains 'Approved' and customer.orders_count == 0 %}
      <script>
        var freeGiftProductId = 54897564418423;
        {% comment %} console.log('giftProductId', freeGiftProductId); {% endcomment %}
        var isNewCustomer = true;
      </script>
    {% else %}
      <script>
        var freeGiftProductId = null;
        {% comment %} console.log('giftProductId', freeGiftProductId); {% endcomment %}
        var isNewCustomer = false;
      </script>
    {% endif %}
    {% if customer and customer.tags contains 'Approved' and customer.orders_count == 0 %}
      <script>
        document.addEventListener('DOMContentLoaded', function () {
          if (isNewCustomer && freeGiftProductId) {
            // Fetch current cart data
            fetch('/cart.js')
              .then((response) => response.json())
              .then((cart) => {
                // Check if the free gift is already in the cart
                const giftExists = cart.items.some((item) => item.variant_id == freeGiftProductId);

                if (!giftExists) {
                  // Add the free gift to the cart
                  fetch('/cart/add.js', {
                    method: 'POST',
                    headers: {
                      'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                      id: freeGiftProductId,
                      quantity: 1,
                    }),
                  })
                    .then((response) => {
                      if (response.ok) {
                        {% comment %} console.log('Free gift added to cart!'); {% endcomment %}
                        // Reload the page to show the updated cart
                        window.location.reload();
                      }
                    })
                    .catch((error) => console.error('Error adding free gift:', error));
                }
              });
          }
        });
      </script>
    {% endif %}

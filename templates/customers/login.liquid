{{ 'customer.css' | asset_url | stylesheet_tag }}

<style>
  .customer.login{
        margin-top: 0 !important;
  }
  #login{
    text-align:center;
    margin-top: 20px;
  }
 .login_tab_btns{
    text-align:center;
       margin-bottom: 15px;
   margin-top: 15px;
       display: flex;
    justify-content: center;
    
  }
  .login_tabs.form_btn[aria-selected="false"]{
        background-color: transparent;
    color: #000;
  }
  .login_tabs .form_btn:hover {
    color: #fff;
    border: solid 1px black;
    background: #000;
}

    .login_tabs [role="tablist"] .form_btn {
   background: transparent;
    color: black;
    font-size: 18px;
    padding: 10px 50px;
    opacity: 1 !important;
    cursor: pointer;
    text-align: center;
    border: 1px solid #000;
    margin: 0;
      display:flex;
      align-items: center;
    justify-content: center;
    column-gap: 5px;
    
}

 .login_tabs #retailer_login{
        border-top-left-radius: 50px;
    border-bottom-left-radius: 50px;
  }
  .login_tabs #wholesaler_login{
        border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
  }
  .login_tabs [role="tablist"] .form_btn[aria-selected="true"] {
   background:#000;
    color:#fff;
}
  .login_tabs [role="tablist"] .form_btn[aria-selected="true"] svg,
  .login_tabs [role="tablist"] .form_btn[aria-selected="true"] svg path{
    fill:#fff;
  }
  .wholesaler_tab_login .oxi_social_wrapper{
    display:none;
  }
  .create_account_link{
    margin-top: 15px !important;
    font-size: 18px !important;
    text-decoration: underline !important;
    margin-bottom: 15px !important;
  }

  @media(max-width:767px){
    .login_tabs [role="tablist"] .form_btn{
          padding: 10px 25px;
    }
  }
</style>


  <p id="login" tabindex="-1">
    {{ 'customer.login_page.title' | t }}
  </p>

<div class="login_tabs">
  <div role="tablist" aria-label="login_forms" class="login_tab_btns">
          <button role="tab" class="form_btn" aria-selected="true" id="retailer_login">{% render 'login_icon' %}Customer</button>
          <button role="tab" class="form_btn" aria-selected="false" id="wholesaler_login">{% render 'wholesale_icon' %}Wholesale</button>
        </div>
   <div role="tabpanel" aria-labelledby="retailer_login" class="retailer_tab_login">
<div class="customer login">
  <div class="page-width">
<!-- <div class='oxi-social-login'></div> -->
</div>
  <p id="recover" tabindex="-1">
    {{ 'customer.recover_password.title' | t }}
  </p>
  
  <div>
    <p>
      {{ 'customer.recover_password.subtext' | t }}
    </p>

    {%- form 'recover_customer_password' -%}
      {% assign recover_success = form.posted_successfully? %}
      <div class="field">
        <input type="email"
          value=""
          name="email"
          id="RecoverEmail"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="RecoverEmail-email-error"
            autofocus
          {% endif %}
          placeholder="{{ 'customer.login_page.email' | t }}"
        >
        <label for="RecoverEmail">
          {{ 'customer.login_page.email' | t }}
        </label>
      </div>
      {%- if form.errors -%}
        <small id="RecoverEmail-email-error" class="form__message">
          <svg aria-hidden="true" focusable="false" role="presentation" viewBox="0 0 13 13">
            <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>

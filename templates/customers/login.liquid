      font-size:32px;
      line-height:48px;
    }
  }
</style>
<script>
 const logintab = document.querySelector('.login_tabs');
  const logintabButtons = logintab.querySelectorAll('[role="tab"]');
  const logintabPanels = Array.from(logintab.querySelectorAll('[role="tabpanel"]'));
  const logintabId = document.querySelector('.form_btn').getAttribute('id');

  function tabClickHandler(e) {
    // Hide All Tabpane
    logintabPanels.forEach(panel => {
      panel.hidden = true;
    });

    // Deselect Tab Button
    logintabButtons.forEach(button => {
      button.setAttribute('aria-selected', 'false');
    });

    // Mark New Tab
    e.currentTarget.setAttribute('aria-selected', 'true');

    // Show New Tab
    const { id } = e.currentTarget;
    const currentTab = logintabPanels.find(
      panel => panel.getAttribute('aria-labelledby') === id
    );

    currentTab.hidden = false;

    // Update hash without scrolling
    history.replaceState(null, null, `#${id}`);
  }

  logintabButtons.forEach(button => {
    button.addEventListener('click', tabClickHandler);
  });

  window.addEventListener('load', function() {
    const hash = window.location.hash.replace('#', '');
    if (hash) {
      // Find and trigger the click event on the tab with this ID
      const tabToActivate = Array.from(logintabButtons).find(button => button.id === hash);
      if (tabToActivate) {
        tabToActivate.click();
      }
    }
  });
document.addEventListener("DOMContentLoaded", function () {
    if (window.location.hash === "#wholesaler_login") {
        setTimeout(function () {
            window.scrollTo(0, 0); // Forces the scroll position to the top
        }, 0);
    }
});

                
</script>
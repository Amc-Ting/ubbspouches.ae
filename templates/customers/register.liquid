const tab = document.querySelector('.form_tabs');
  const tabButtons = tab.querySelectorAll('[role="tab"]');
  const tabPanels = Array.from(tab.querySelectorAll('[role="tabpanel"]'));
  const tabId = document.querySelector('.form_btn').getAttribute('id');
  {% comment %} console.log('tabId:', tabId); {% endcomment %}

  function tabClickHandler(e) {
    // Hide All Tabpane
    tabPanels.forEach(panel => {
      panel.hidden = true;
    });

    // Deselect Tab Button
    tabButtons.forEach(button => {
      button.setAttribute('aria-selected', 'false');
    });

    // Mark New Tab
    e.currentTarget.setAttribute('aria-selected', 'true');

    // Show New Tab
    const { id } = e.currentTarget;
    const currentTab = tabPanels.find(
      panel => panel.getAttribute('aria-labelledby') === id
    );

    currentTab.hidden = false;

    // Update hash without scrolling
    history.replaceState(null, null, `#${id}`);
  }

  tabButtons.forEach(button => {
    button.addEventListener('click', tabClickHandler);
  });

  window.addEventListener('load', function() {
    const hash = window.location.hash.replace('#', '');
    if (hash) {
      // Find and trigger the click event on the tab with this ID
      const tabToActivate = Array.from(tabButtons).find(button => button.id === hash);
      if (tabToActivate) {
        tabToActivate.click();
      }
    }
  });
document.addEventListener("DOMContentLoaded", function () {
    if (window.location.hash === "#wholesale_register") {
        setTimeout(function () {
            window.scrollTo(0, 0); // Forces the scroll position to the top
        }, 0);
    }
});
                
</script>

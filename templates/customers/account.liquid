{{ 'customer.css' | asset_url | stylesheet_tag }}

<style>
  .loyalty_points_tracker{
    flex-direction:column;
    border-bottom: 1px solid rgba(0, 0, 0, 0.2);
    margin-bottom: 2rem;
  }
  #progressContainer{
        margin: 5px 0 25px;
    /* border-radius: 15px; */
    width: 100%; 
    position:relative;
  }
  #progressBar{
        /* border-top-left-radius: 10px;
    border-bottom-left-radius: 10px; */
  }
  .checkpoint {
    position: absolute;
    top: 0px;
    bottom: 0;
    width: 20px;
        /* background-color: var(--color_watermelon); */
    height: 20px;
    border-radius: 12px;
}
  .checkpoint .pound_txt{
    position: absolute;
    top: 15px;
        left: -22px;
  }
  .checkpoint .pound_txt img{
    width:15px;
  }
  .checkpoint .clip-path{
    clip-path: polygon(75% 0%, 100% 50%, 75% 100%, 54% 100%, 83% 51%, 56% 0);
    width: 20px;
    height: 18px;
    background: #fff;
    top: 0;
    display: block;
    position: absolute;
    left: -15px;
  }
 
  .checkpoint .points-txt{
    line-height: 11px;
    font-size: 14px;
    text-align: center;
    top: 28px;
    position: absolute;
    width: 100px;
    display: flex;
    align-items: center;
    justify-content:center;
    column-gap: 5px;
    left: -20px;
    border: 1px solid rgba(0,0,0,0.4);
    padding: 5px;
    border-radius: 5px;
  }
  #progressText p{
    font-size: 22px;
    margin-top: 28px;
  }
  .main_current_total{
    margin-top:3rem !important;
  }

  @media(max-width:767px){
    .main_current_total{
        margin-top: 8rem !important;
    }
    .checkpoint .points-txt{
      width: 79px;
      font-size: 12px;
      column-gap: 3px;
      padding: 2px;
      column-gap: 3px;
    }
    .checkpoint .pound_txt img {
      width: 12px;
    }
    .checkpoint:nth-child(4) .points-txt{
      left: -40px;
    }
  }
</style>



          {% comment %}
  {% assign total_account_price = '128000' %} 
{% endcomment %}

       {% unless customer and customer.tags contains "Approved" %}   
          {%- assign points_per_pound = 1 -%}
{%- assign total_price = customer.total_spent | divided_by: 100.0 -%} 
{%- assign main_total_price = total_price | times: points_per_pound | ceil -%}
          <p class="hidden" id="customer_total_spent">{{ main_total_price }}</p>

        <div class="loyalty_points_tracker" id="main_tracker">

          <h2>Loyalty/Reward Points</h2>
          
           <div id="progressContainer" style="background-color: rgba(94,204,200,0.3); border: 1px solid #ccc; height: 20px;border-radius:15px;">
              <div id="progressBar" style="width: 0%; height: 18px; background-color: var(--color_spearmint);border-radius:15px;"></div>

              <!-- Checkpoints -->
              <div class="checkpoint" data-value="250" data-point="50">
                <span class="pound_txt">£250<br>
                  <span class="points-txt">
                    <img src="https://cdn.shopify.com/s/files/1/0559/7075/8753/files/coin.png?v=1745846269" alt="coin_img">
                    50 points
                  </span>
                </span>
                <span class="clip-path"></span>
              </div>
              <div class="checkpoint" data-value="500" data-point="100">
                <span class="pound_txt">£500<br>
                  <span class="points-txt">
                    <img src="https://cdn.shopify.com/s/files/1/0559/7075/8753/files/coin.png?v=1745846269" alt="coin_img">
                    100 points
                  </span>
                </span>
                <span class="clip-path"></span>
              </div>
              <div class="checkpoint" data-value="1000" data-point="200">
                <span class="pound_txt">£1000<br>
                  <span class="points-txt">
                    <img src="https://cdn.shopify.com/s/files/1/0559/7075/8753/files/coin.png?v=1745846269" alt="coin_img">
                    200 points
                  </span>
                </span>
                <span class="clip-path"></span>
              </div>
           </div>

          <div class="hidden" id="progressText" style="margin-top: 5px;"></div>
           
          <p class="main_current_total">Current Total Spent: £{{ main_total_price }}</p>
        </div>

          {% endunless %}
          

<div class="customer account cdp_main_always">
  <div>
    <h1>{{ 'customer.account.title' | t }}</h1>
    <a href="{{ routes.account_logout_url }}">
      <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" fill="none" viewBox="0 0 18 19">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M6 4.5a3 3 0 116 0 3 3 0 01-6 0zm3-4a4 4 0 100 8 4 4 0 000-8zm5.58 12.15c1.12.82 1.83 2.24 1.91 4.85H1.51c.08-2.6.79-4.03 1.9-4.85C4.66 11.75 6.5 11.5 9 11.5s4.35.26 5.58 1.15zM9 10.5c-2.5 0-4.65.24-6.17 1.35C1.27 12.98.5 14.93.5 18v.5h17V18c0-3.07-.77-5.02-2.33-6.15-1.52-1.1-3.67-1.35-6.17-1.35z" fill="currentColor">
      </svg>
      {{ 'customer.log_out' | t }}
    </a>
  </div>
         
  <div>
    <div>
      <h2>{{ 'customer.orders.title' | t }}</h2>

      {% paginate customer.orders by 20 %}
        {%- if customer.orders.size > 0 -%}
          <table role="table" class="order-history">
            <caption class="visually-hidden">{{ 'customer.orders.title' | t }}</caption>
            <thead role="rowgroup">
              <tr role="row">
                <th id="ColumnOrder" scope="col" role="columnheader">{{ 'customer.orders.order_number' | t }}</th>
                <th id="ColumnDate" scope="col" role="columnheader">{{ 'customer.orders.date' | t }}</th>
                <th id="ColumnPayment" scope="col" role="columnheader">{{ 'customer.orders.payment_status' | t }}</th>
                <th id="ColumnFulfillment" scope="col" role="columnheader">{{ 'customer.orders.fulfillment_status' | t }}</th>
                <th id="ColumnTotal" scope="col" role="columnheader">{{ 'customer.orders.total' | t }}</th>
              </tr>
            </thead>
            <tbody role="rowgroup">
              {%- for order in customer.orders -%}
                <tr role="row">
                  <td
                    id="RowOrder"
                    role="cell"
                    headers="ColumnOrder"
                    data-label="{{ 'customer.orders.order_number' | t }}"
                  >
                    <a href="{{ order.customer_url }}" aria-label="{{ 'customer.orders.order_number_link' | t: number: order.name }}">
                      {{ order.name }}
                    </a>
                  </td>
                  <td headers="RowOrder ColumnDate" role="cell" data-label="{{ 'customer.orders.date' | t }}">
                    {{ order.created_at | time_tag: format: 'date' }}
                  </td>
                  <td headers="RowOrder ColumnPayment" role="cell" data-label="{{ 'customer.orders.payment_status' | t }}">
                    {{ order.financial_status_label }}
                  </td>
                  <td headers="RowOrder ColumnFulfillment" role="cell" data-label="{{ 'customer.orders.fulfillment_status' | t }}">
                    {{ order.fulfillment_status_label }}
                  </td>
                  <td headers="RowOrder ColumnTotal" role="cell" data-label="{{ 'customer.orders.total' | t }}">
                    {{ order.total_price | money_with_currency }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- else -%}
          <p>{{ 'customer.orders.none' | t }}</p>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          {%- if paginate.parts.size > 0 -%}
              <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
                <ul role="list">
                {%- if paginate.previous -%}
                  <li>
                    <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">
                      <svg aria-hidden="true" focusable="false" viewBox="0 0 10 6">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
                      </svg>
                    </a>
                  </li>
                {%- endif -%}

                {%- for part in paginate.parts -%}
                  <li>
                    {%- if part.is_link -%}
                      <a href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
                    {%- else -%}
                      {%- if part.title == paginate.current_page -%}
                        <span aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</span>
                      {%- else -%}
                        <span>{{ part.title }}</span>
                      {%- endif -%}
                    {%- endif -%}
                  </li>
                {%- endfor -%}

                {%- if paginate.next -%}
                  <li>
                    <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}" >
                      <svg aria-hidden="true" focusable="false" viewBox="0 0 10 6">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z" fill="currentColor">
                      </svg>
                    </a>
                  </li>
                {%- endif -%}
                </ul>
              </nav>
          {%- endif -%}
        {%- endif -%}
      {% endpaginate %}
    </div>

    <div>
      <h2>{{ 'customer.account.details' | t }}</h2>

      {{ customer.default_address | format_address }}

      <a href="{{ routes.account_addresses_url }}">
        {{ 'customer.account.view_addresses' | t }} ({{ customer.addresses_count }})
      </a>
    </div>

  </div>
</div>

   <script>

     
const goal = 1000;

setTimeout(function () {
  let currentPointsElement = document.querySelector("#customer_total_spent");

  if (currentPointsElement && currentPointsElement.innerText.trim() !== "") {
    let currentPoints = parseInt(currentPointsElement.innerText.trim(), 10);
    {% comment %} console.log("currentPoints:", currentPoints); {% endcomment %}
    updateProgress(currentPoints);
  } else {
    {% comment %} console.log("Element not found or no value."); {% endcomment %}
    updateProgress(0);
  }
}, 2000);

function updateProgress(points) {
  const progressContainer = document.getElementById('progressContainer');
  const progressBar = document.getElementById('progressBar');
  const progressText = document.getElementById('progressText');
  
  const cycleProgress = points % goal;
  const percentage = (cycleProgress / goal) * 100;

  progressBar.style.width = percentage + '%';
  progressText.innerText = `£${cycleProgress} / £${goal}`;

  const checkpoints = document.querySelectorAll('.checkpoint');
  let nextCheckpointValue = goal; // Default to full goal if none found

  checkpoints.forEach(checkpoint => {
    const value = parseInt(checkpoint.getAttribute('data-value'), 10);
    const pointsValue = parseInt(checkpoint.getAttribute('data-point'), 10);
    const positionPercent = (value / goal) * 100;
    checkpoint.style.left = `calc(${positionPercent}% - 1px)`;

    // Find the next checkpoint greater than current progress
    if (cycleProgress < value && value < nextCheckpointValue) {
      nextCheckpointValue = value;
      nextCheckpointPoints = pointsValue;
    }
  });

  // Calculate remaining amount
  const amountRemaining = nextCheckpointValue - cycleProgress;

  // Add dynamic text (or update existing one)
  let goalInfo = document.getElementById('goalInfo');
  if (!goalInfo) {
    goalInfo = document.createElement('div');
    goalInfo.id = 'goalInfo';
    progressContainer.parentNode.insertBefore(goalInfo, progressContainer);
  }
  if (amountRemaining > 0) {
    goalInfo.innerText = `Spend £${amountRemaining} more to unlock ${nextCheckpointPoints} points`;
  } else {
    goalInfo.innerText = `Goal achieved! 🎉`;
  }
}




    </script>

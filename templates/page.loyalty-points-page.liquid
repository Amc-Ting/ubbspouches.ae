<style>
  .main_loyalty_sec{
    margin-top:160px;
  }
  .loyalty_points_tracker{
    flex-direction:column;
    border-bottom: 1px solid rgba(0, 0, 0, 0.2);
    margin-bottom: 2rem;
    display:flex;
  }
  #progressContainer{
        margin: 5px 0 25px;
    /* border-radius: 15px; */
    width: 100%; 
    position:relative;
  }
  #progressBar{
        /* border-top-left-radius: 10px;
    border-bottom-left-radius: 10px; */
  }
  .checkpoint {
    position: absolute;
    top: 0px;
    bottom: 0;

<div class="main_loyalty_sec">

          {%- assign points_per_pound = 1 -%}
{%- assign total_price = customer.total_spent | divided_by: 100.0 -%} 
{%- assign main_total_price = total_price | times: points_per_pound | ceil -%}
          <p class="hidden" id="customer_total_spent">{{ main_total_price }}</p>

        <div class="loyalty_points_tracker page-width" id="main_tracker">

          <h2>Loyalty/Reward Points</h2>
          
           <div id="progressContainer" style="background-color: rgba(94,204,200,0.3); border: 1px solid #ccc; height: 20px;border-radius:15px;">
              <div id="progressBar" style="width: 0%; height: 18px; background-color: var(--color_spearmint);border-radius:15px;"></div>

              <!-- Checkpoints -->
              <div class="checkpoint" data-value="250" data-point="50">
                <span class="pound_txt">£250<br>
                  <span class="points-txt">
                    <img src="https://cdn.shopify.com/s/files/1/0559/7075/8753/files/coin.png?v=1745846269" alt="coin_img">
                    50 points
                  </span>
                </span>
                <span class="clip-path"></span>
              </div>
              <div class="checkpoint" data-value="500" data-point="100">
                <span class="pound_txt">£500<br>
                  <span class="points-txt">
                    <img src="https://cdn.shopify.com/s/files/1/0559/7075/8753/files/coin.png?v=1745846269" alt="coin_img">
                    100 points
                  </span>
                </span>
                <span class="clip-path"></span>
              </div>
              <div class="checkpoint" data-value="1000" data-point="200">
                <span class="pound_txt">£1000<br>
                  <span class="points-txt">
                    <img src="https://cdn.shopify.com/s/files/1/0559/7075/8753/files/coin.png?v=1745846269" alt="coin_img">
                    200 points
                  </span>
                </span>
                <span class="clip-path"></span>
              </div>
           </div>

          <div class="hidden" id="progressText" style="margin-top: 5px;"></div>
           
          <p class="main_current_total">Current Total Spent: £{{ main_total_price }}</p>
        </div>
</div>

   <script>

     
const goal = 1000;

setTimeout(function () {
  let currentPointsElement = document.querySelector("#customer_total_spent");

  if (currentPointsElement && currentPointsElement.innerText.trim() !== "") {
    let currentPoints = parseInt(currentPointsElement.innerText.trim(), 10);
    {% comment %} console.log("currentPoints:", currentPoints); {% endcomment %}
    updateProgress(currentPoints);
  } else {
    {% comment %} console.log("Element not found or no value."); {% endcomment %}
    updateProgress(0);
  }
}, 2000);

function updateProgress(points) {
  const progressContainer = document.getElementById('progressContainer');
  const progressBar = document.getElementById('progressBar');
  const progressText = document.getElementById('progressText');
  
  const cycleProgress = points % goal;
  const percentage = (cycleProgress / goal) * 100;

  progressBar.style.width = percentage + '%';
  progressText.innerText = `£${cycleProgress} / £${goal}`;

  const checkpoints = document.querySelectorAll('.checkpoint');
  let nextCheckpointValue = goal; // Default to full goal if none found

  checkpoints.forEach(checkpoint => {
    const value = parseInt(checkpoint.getAttribute('data-value'), 10);
    const pointsValue = parseInt(checkpoint.getAttribute('data-point'), 10);
    const positionPercent = (value / goal) * 100;
    checkpoint.style.left = `calc(${positionPercent}% - 1px)`;

    // Find the next checkpoint greater than current progress
    if (cycleProgress < value && value < nextCheckpointValue) {
      nextCheckpointValue = value;
      nextCheckpointPoints = pointsValue;
    }
  });

  // Calculate remaining amount
  const amountRemaining = nextCheckpointValue - cycleProgress;

  // Add dynamic text (or update existing one)
  let goalInfo = document.getElementById('goalInfo');
  if (!goalInfo) {
    goalInfo = document.createElement('div');
    goalInfo.id = 'goalInfo';
    progressContainer.parentNode.insertBefore(goalInfo, progressContainer);
  }
  if (amountRemaining > 0) {
    goalInfo.innerText = `Spend £${amountRemaining} more to unlock ${nextCheckpointPoints} points`;
  } else {
    goalInfo.innerText = `Goal achieved! 🎉`;
  }
}


    </script>
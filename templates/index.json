round_color":"#000000","feed_id":"","html_area":""}}},"block_order":["ddf2e947-c0bf-429b-8067-e93465719077"],"settings":{"include_margins":true}},"rich_text_wK3gF7":{"type":"rich-text","blocks":{"heading_htFttL":{"type":"heading","settings":{"heading":"Common FAQs","heading_size":"h0"}}},"block_order":["heading_htFttL"],"disabled":true,"settings":{"desktop_content_position":"center","content_alignment":"center","color_scheme":"background-1","full_width":true,"padding_top":40,"padding_bottom":0}},"faq_tab_accordion_1_A6nrDX":{"type":"faq_tab_accordion_1","blocks":{"text_xdPyqQ":{"type":"text","settings":{"ques":"What are nicotine pouches?","ans":"<p>Nicotine pouches are 100% tobacco, smoke and vape-free flavourful pouches of nicotine. They sit between your lip and gums to give you a fresh nicotine experience for up to 30 minutes.<\/p>"}},"text_yeUjHd":{"type":"text","settings":{"ques":"How do nicotine pouches work?","ans":"<p>Nicotine pouches are extremely easy to use. Follow our 3 step guide below:<br\/><br\/>Step 1 – POP<br\/>Pop the soft, white nicotine pouch under your lip and position it to the side for a more comfortable fit.<br\/><br\/>Step 2 – TINGLE<br\/>You will feel a tingling sensation on your gums and a release of flavour, this is normal and means the pouch is working. We recommend leaving the pouch in for up to 30 minutes.<br\/><br\/>Step 3 - DISCARD<br\/>When you’re done, discard of it in the general waste or store in the top of the can.<br\/><br\/>Übbs Tobacco Free-Nicotine Pouches are designed to be absorbed through the gums and should not be swallowed. If you swallow a pouch and feel unwell, seek medical advice with the can or label at hand.<\/p>"}},"text_YdN9Ma":{"type":"text","settings":{"ques":"How long should I keep nicotine pouches in for?","ans":"<p>We recommend you keep a nicotine pouch in for up to 30 minutes.<\/p>"}},"text_GnK8Xe":{"type":"text","settings":{"ques":"Is übbs the same as snus?","ans":"<p>No, übbs Nicotine Pouches are not the same as snus. While they’re used in a similar way to snus, nicotine pouches are 100% tobacco-free unlike snus which contains tobacco.<\/p>"}},"text_Ha9z8X":{"type":"text","settings":{"ques":"Who can use übbs?","ans":"<p>übbs contains nicotine and are to be used by existing smokers, vapers and nicotine consumers who are aged 18 or over.<br\/><br\/>übbs is not to be used if you are under the age of 18, not an existing tobacco and nicotine consumer, allergic to nicotine and any other ingredients, pregnant\/breast-feeding or are suffering from an unstable heart condition, severe hypertension or diabetes.<\/p>"}}},"block_order":["text_xdPyqQ","text_yeUjHd","text_YdN9Ma","text_GnK8Xe","text_Ha9z8X"],"settings":{"heading":"Common FAQS"}},"1656923393be83e5bf":{"type":"newsletter","blocks":{"1656923393d1b2e7b5-1":{"type":"paragraph","settings":{"text":"<p>FOR THE LATEST NEWS AND UPDATES<\/p>"}},"1656923393d1b2e7b5-0":{"type":"heading","settings":{"heading":"JOIN OUR NEWSLETTER","heading_size":"h1"}},"1656923393d1b2e7b5-2":{"type":"email_form","settings":{}},"info_4UgDNy":{"type":"info","settings":{"btn_label":"Privacy Policy","btn_url":"shopify:\/\/pages\/ccpa-opt-out"}}},"block_order":["1656923393d1b2e7b5-1","1656923393d1b2e7b5-0","1656923393d1b2e7b5-2","info_4UgDNy"],"settings":{"color_scheme":"background-2","full_width":true,"padding_top":40,"padding_bottom":52}}},"order":["custom_announcement_bar_6hxk99","banner_Me3zEA","prmo_card_new_CxrK4H","home_banners_8k7Emb","16570318032743222c","739ceaf6-1a32-4368-9c9e-ff75fe18c1f0","0b183e26-0dea-44a2-89a1-887b38179500","1657021119aaffee13","1657886647b142e86f","product_carousel_section_Y4cTbk","1ae6ae13-a28b-445a-a2ac-c2c475c597a1","9d6e3e8d-ee73-448f-9f7a-5c899013825c","bed8fe33-0b8a-44e9-ac86-aa428c3f9b96","16570257724d20f6b7","ubbs_banner_yDVt99","ubbs_banner_new_wHJBhR","165694805691601eb2","rewards_banner_DDbfJt","pwa_section_yp8ttm","1657036415f7b3ce1d","16569412245a9ab810","16679869356434a9cf","rich_text_wK3gF7","faq_tab_a
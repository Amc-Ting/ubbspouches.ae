{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<link rel="stylesheet" href="{{ 'component-slider.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'template-collection.css' | asset_url }}" media="print" onload="this.media='all'">
{%- if section.settings.enable_quick_add -%}
  <link rel="stylesheet" href="{{ 'quick-add.css' | asset_url }}" media="print" onload="this.media='all'">
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
<noscript>{{ 'component-slider.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'template-collection.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .collection__title--desktop-slider .title{text-transform: uppercase; font-family: 'KronaRegular'; font-weight: 400;}
  /* .title-wrapper-with-link a{border: solid 2px black;transition: var(--transition);} */
  /* .title-wrapper-with-link a:hover{color: #000 !important; border: solid 2px black; background: white;} */
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<style>
    span.price-item.price-item--regular {
      font-size: 30px !important;
      font-weight: bold;
  }
    .prod_img_sec img {
      object-fit: contain !important;
  }
  .collection .product_carousel .card__inner, .collection .card__inner, .product-recommendations .card__inner, .collection .card-wrapper.Bundle .card__inner, .product_carousel .card-wrapper.Bundle .card__inner {
      height: 260px;
  }
    .mobile_view_btn {
      display: none;
  }
  .collection__title .title:not(:only-child) {
      margin-bottom: 0 !important;
  }
  .collection__title.title-wrapper-with-link{
   gap:0;
  }
    @media screen and (min-width: 990px) {
      .product_carousel .slider--desktop.grid--3-col-desktop .grid__item{
       width: calc(33.33% - var(--grid-desktop-horizontal-spacing)* 2 / 3) !important;
    }
         .product_carousel  .slider--desktop .slider__slide:first-child {
          margin-left: unset ;
          scroll-margin-left: unset;
           padding-left: 15px;
      }

      .product_carousel .slider--desktop{
                scroll-padding-left: unset;
        {% comment %} padding-right: 15px; {% endcomment %}
      }
      .product_carousel .left-arrow{
        position:absolute;
        left:0;
        top:40%;
      }
      .product_carousel .right-arrow{
        position:absolute;
        right:0;
        top:40%;
      }
    }
    .card-information {
      position: relative;
  }
  .collection .card__information {
      position: relative;
  }
    .product-grid .jdgm-widget.jdgm-widget{
      position: absolute;
      top: -23px;
    }
   @media(max-width:768px){
        span.jdgm-prev-badge__stars {
          padding-right: 7px !important;
        }
    }
    @media (max-width: 767px){
   .desktop_view_btn {
      display: none;
  }
    .mobile_view_btn {
      display: block;
  }
  .collection__title a.mobile_view_btn {
      background: transparent;
      color: #000 !important;
      border: none;
      display: flex;
      padding: 0;
      margin: 0;
      align-items: center;
      justify-content: center;
    }
  .collection__title a.mobile_view_btn span {
      display: flex;
  }
    span.price-item.price-item--regular {
      font-size: 22px !important;
  }
  }
</style>




{%- liquid
  assign products_to_display = section.settings.collection.all_products_count

  if section.settings.collection.all_products_count > section.settings.products_to_show
    assign products_to_display = section.settings.products_to_show
    assign more_in_collection = true
  endif

  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and products_to_display > columns_mobile_int
    assign show_mobile_slider = true
  endif

  assign show_desktop_slider = false
  if section.settings.enable_desktop_slider and products_to_display > section.settings.columns_desktop
    assign show_desktop_slider = true
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient">
  <div class="collection section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}">
    <div class="page-width">
      <div class="collection__title title-wrapper title-wrapper-with-link title-wrapper--no-top-margin {% if show_mobile_slider %} title-wrapper--self-padded-tablet-down{% endif %}{% if show_desktop_slider %} collection__title--desktop-slider{% endif %}">
        {%- if section.settings.title != blank -%}
          <h2 class="title h1 desk {{ section.settings.heading_size }}">{{ section.settings.title | escape }}</h1>
          <h2 class="title h1 mob {{ section.settings.heading_size }}">
            {{ section.settings.title | escape | replace: 'the', '' | replace: 'range', '' }}
          </h2>
          <div class="view_all_text">
            <a href="/collections/shop" class="arrow-view" id="view_all_btn"> 
           <span class="cmn_btn"> View all</span>
          </a>
          </div>
          {%- if section.settings.show_view_all and more_in_collection -%}
            <a
              href="{{ section.settings.collection.url }}"
              class="cmn_btn desktop_view_btn {% if section.settings.view_all_style == 'link' %}link underlined-link{% elsif section.settings.view_all_style == 'solid' %}button{% else %}button button--secondary{% endif %}"
              aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: section.settings.collection.title }}"
              style="--color-link:255,255,255;"
            >
              {{ 'sections.featured_collection.view_all' | t }}
            </a>
            <a
              href="{{ section.settings.collection.url }}"
              class="mobile_view_btn {% if section.settings.view_all_style == 'link' %}link underlined-link{% elsif section.settings.view_all_style == 'solid' %}button{% else %}button button--secondary{% endif %}"
              aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: section.settings.collection.title }}"
              style="--color-link:255,255,255;"
            >
              {{ 'sections.featured_collection.view_all' | t -}}
              <span>
                <svg xmlns="http://www.w3.org/2000/svg" width="25px" height="25px" viewBox="0 0 24 24" fill="none">
                  <path d="M13.2328 16.4569C12.9328 16.7426 12.9212 17.2173 13.2069 17.5172C13.4926 17.8172 13.9673 17.8288 14.2672 17.5431L13.2328 16.4569ZM19.5172 12.5431C19.8172 12.2574 19.8288 11.7827 19.5431 11.4828C19.2574 11.1828 18.7827 11.1712 18.4828 11.4569L19.5172 12.5431ZM18.4828 12.5431C18.7827 12.8288 19.2574 12.8172 19.5431 12.5172C19.8288 12.2173 19.8172 11.7426 19.5172 11.4569L18.4828 12.5431ZM14.2672 6.4569C13.9673 6.17123 13.4926 6.18281 13.2069 6.48276C12.9212 6.78271 12.9328 7.25744 13.2328 7.5431L14.2672 6.4569ZM19 12.75C19.4142 12.75 19.75 12.4142 19.75 12C19.75 11.5858 19.4142 11.25 19 11.25V12.75ZM5 11.25C4.58579 11.25 4.25 11.5858 4.25 12C4.25 12.4142 4.58579 12.75 5 12.75V11.25ZM14.2672 17.5431L19.5172 12.5431L18.4828 11.4569L13.2328 16.4569L14.2672 17.5431ZM19.5172 11.4569L14.2672 6.4569L13.2328 7.5431L18.4828 12.5431L19.5172 11.4569ZM19 11.25L5 11.25V12.75L19 12.75V11.25Z" fill="#000000"/>
                </svg>
              </span>
            </a>
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.description != blank
          or section.settings.show_description
          and section.settings.collection.description != empty
        -%}
          <div class="collection__description {{ section.settings.description_style }}">
            {%- if section.settings.show_description -%}
              {{ section.settings.collection.description }}
            {%- else -%}
              {{ section.settings.description -}}
            {%- endif %}
          </div>
        {%- endif -%}
      </div>
    </div>

    {% comment %} <div class="product_tabs_sec">
      <div class="product-tabs">
        <button class="tab-btn active" data-tab="tab1">
          {{ section.settings.tab_title_1 }}
        </button>
        <button class="tab-btn" data-tab="tab2">
          {{ section.settings.tab_title_2 }}
        </button>
      </div>
    </div> {% endcomment %}

    <div class="tab-content active" id="tab1">
      
      <slider-component class="slider-mobile-gutter page-width" data-slider>
        <ul
          id="Slider-{{ section.id }}-1"
          class="grid product-grid contains-card grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down slider slider--desktop slider--tablet"
          role="list"
        >
          {% for product in section.settings.collection_1.products limit: section.settings.products_to_show %}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="grid__item slider__slide"
            >
              {% render 'card-product-new',
                card_product: product,
                media_aspect_ratio: section.settings.image_ratio,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: section.settings.show_vendor,
                show_rating: section.settings.show_rating,
                show_quick_add: section.settings.enable_quick_add,
                section_id: section.id
              %}
            </li>
          {% endfor %}
        </ul>

        <div class="slider-buttons no-js-hidden">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
            aria-controls="Slider-{{ section.id }}-1"
          >
            {% comment %}
              {% render 'icon-caret' %}
            {% endcomment %}
            <svg
              class="p-pp left-arrow slick-arrow ggg"
              xmlns="http://www.w3.org/2000/svg"
              xmlns:xlink="http://www.w3.org/1999/xlink"
              fill="#000000"
              height="30px"
              width="30px"

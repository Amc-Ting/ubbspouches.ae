<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('#shopify-section-{{ section.id }}');
    if (!section) return;

    const tabs = section.querySelectorAll('.tab-btn');
    const contents = section.querySelectorAll('.product_carousel .tab-content');

    tabs.forEach((tab) => {
      tab.addEventListener('click', function () {
        tabs.forEach((t) => t.classList.remove('active'));
        contents.forEach((c) => c.classList.remove('active'));

        this.classList.add('active');
        const activeContent = section.querySelector('#' + this.dataset.tab);
        activeContent.classList.add('active');

        setTimeout(() => {
          // 🔥 Proper Dawn 15 slider fix
          activeContent.querySelectorAll('slider-component').forEach((slider) => {
            // Force reflow
            slider.style.display = 'none';
            slider.offsetHeight;
            slider.style.display = '';

            // Trigger resize so Dawn recalculates
            window.dispatchEvent(new Event('resize'));
          });
        }, 150);
      });
    });
  });
</script>
{% comment %}
  <script>
    fetch('/cart.js')
      .then((res) => res.json())
      .then((cart) => {
        document.querySelectorAll('[data-price-id]').forEach((priceBox) => {
          const variantId = priceBox.getAttribute('data-price-id');

          const priceElement = priceBox.querySelector('.price-item--regular');
          if (!priceElement) return;

          // find this variant in cart
          const cartItem = cart.items.find((item) => item.variant_id == variantId);

          if (cartItem) {
            let qty = cartItem.quantity;

            let priceText = priceElement.textContent.trim().replace(/[^\d.]/g, '');
            let price = parseFloat(priceText);

            let total = price * qty;

            priceElement.textContent = '£' + total.toFixed(2);
          }
        });
      });
  </script>
{% endcomment %}

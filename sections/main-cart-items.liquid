{{ 'component-cart.css' | asset_url | stylesheet_tag }}
{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}
{{ 'component-totals.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-discounts.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

    .tt-breadcrumb , .tax-note{
      display : none !important;
    }
  .dot.black, .circle.black {
    background-color: #B18B6D !important;
  }
  .dot.intense{
    background-color:#6392D6;
        margin: 0 2px;
  }

    cart-items{
      padding-top : 60px !important;
    }

    div.cart-items-total{
      padding-bottom:40px;
    }

    header.header{
      padding-top : 10px !important;
      padding-bottom : 10px !important;
    }



      @media screen and (min-width: 750px) {
        .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top }}px;
          padding-bottom: {{ section.settings.padding_bottom }}px;
        }
      }
      .quantity{width:35%;}
      .dot {
        background-color: #CC163A;
        height: 10px;
        width: 10px;
        border-radius: 50%;
        display: inline-block;
        }
      .circle {
        height: 10px;
        width: 10px;
        border: 1px solid #a3a3a3;
        border-radius: 50%;
        display: inline-block;
    }
      label p {
        margin-bottom: 5px;
        letter-spacing: 0;
    }
      label {
        border: 2px solid #e79100 !important;
        display: inline-block;
        margin: .7rem .5rem .2rem 0;
        padding: 1rem 2rem;
        font-size: 1.4rem;
        letter-spacing: .1rem;
        line-height: 1;
        border-radius : 12px;
        text-align: center;
        transition: border var(--duration-short) ease;
        cursor: pointer;
        position: relative;
    }
{%- endstyle -%}

{%- unless settings.cart_type == 'drawer' -%}
  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

<style>
    #discounted_price_sec{
      display:none;
    }
    #discounted_price_sec:nth-child(1){
      display:block;
      font-size: 18px;
    }
  .reward_points_sec {
      display: flex
  ;
      justify-content: flex-end;
  }
     .discounted_info p{
       color:#5ECCC8;
       text-align: right;
     }
     #discounted_price_sec{
      padding: 10px 14px;
      background: #e3efe1;
      color: #0c7300;
      border-radius: 13px;
      margin-bottom: 30px;
     }
     .discount_msg{
       padding-top:15px !important;
     }
    .cart-items-total{
      background-color: #fff;
      padding: 1px 30px;
    }
    .wholesale_disclaimer p{
          font-size: 18px;
      margin-bottom: 15px;
      text-align:center;
    }
    .collateral_disclaimer{
          font-size: 16px;
      position: absolute;
      bottom: -32px;
      color:red;
    }
    .main_page-wholesale #discounted_price_sec{
      display:none;
    }
    #accBtn{
      appearance: none;
      background: transparent;
      border: none;
      font-family: 'BlinkerRegular';
      font-size: 20px;
      text-decoration: underline;
      cursor: pointer;
    }
</style>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

<cart-items class=" isolate{% if cart == empty %} is-empty{% else %} section-{{ section.id }}-padding{% endif %}">
  <div class="page-width">
    <div class="title-wrapper-with-link">
      <h1 class="title title--primary">{{ 'sections.cart.title' | t }}</h1>
      {% comment %}
        <a href="{{ routes.all_products_collection_url }}" class="underlined-link">
          {{- 'general.continue_shopping' | t -}}
        </a>
      {% endcomment %}
    </div>

    <div class="cart__warnings">
      <h1 class="cart__empty-text">{{ 'sections.cart.empty' | t }}</h1>
      {% comment %}
        <a href="{{ routes.all_products_collection_url }}" class="button">
          {{ 'general.continue_shopping' | t }}
        </a>
      {% endcomment %}

      {%- if shop.customer_accounts_enabled and customer == null -%}
        <h2 class="cart__login-title">{{ 'sections.cart.login.title' | t }}</h2>
        <p class="cart__login-paragraph">
          {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
        </p>
      {%- endif -%}
    </div>

    <form action="{{ routes.cart_url }}" class="cart__contents critical-hidden" method="post" id="cart">
      <div class="cart__items" id="main-cart-items" data-id="{{ section.id }}">
        <div class="js-contents">
          {% comment %}
            {% if cart.item_count > 0 %}
              {% render 'multiple-offer' %}
            {% endif %}
          {% endcomment %}
          {%- if cart != empty -%}
            <table class="cart-items">
              <caption class="visually-hidden">
                {{ 'sections.cart.title' | t }}
              </caption>
              <thead class="small-hide">
                <tr>
                  <th class="caption-with-letter-spacing" colspan="2" scope="col">
                    {{ 'sections.cart.headings.product' | t }}
                  </th>
                  <th class="cart-items__heading--wide small-hide caption-with-letter-spacing" colspan="1" scope="col">
                    Price
                  </th>

                  <th class="medium-hide large-up-hide right caption-with-letter-spacing" colspan="1" scope="col">
                    {{ 'sections.cart.headings.total' | t }}
                  </th>
                  <th
                    class="cart-items__heading--wide cart-items__heading--quantity small-hide caption-with-letter-spacing"
                    colspan="1"
                    scope="col"
                  >
                    {{ 'sections.cart.headings.quantity' | t }}
                  </th>
                  <th class="small-hide right caption-with-letter-spacing" colspan="1" scope="col">
                    {{ 'sections.cart.headings.total' | t }}
                  </th>
                </tr>
              </thead>

              <tbody>
                {%- for item in cart.items -%}
                  <tr
                    class="cart-item {% if item.parent_relationship.parent != null %}cart-item__nested-line{% endif %}"
                    id="CartItem-{{ item.index | plus: 1 }}"
                    {% if item.parent_relationship.parent != null %}
                      aria-label="{{- 'products.product.nested_label' | t: title: item.product.title, parent_title: item.parent_relationship.parent.title | escape -}}"
                    {% endif %}
                  >
                    {% comment %}
                      <td class="cart-item__media">
                        {% if item.image %}
                          {% comment %} Leave empty space due to a:empty CSS display: none rule {% endcomment %}
                          <a href="{{ item.url }}" class="cart-item__link" aria-hidden="true" tabindex="-1"> </a>
                          <div class="cart-item__image-container gradient {% if item.parent_relationship.parent == null %}global-media-settings{% endif %}">
                            <img
                              src="{{ item.image | image_url: width: 300 }}"
                              class="cart-item__image {% if item.parent_relationship.parent != null %}global-media-settings{% endif %}"
                              alt="{{ item.image.alt | escape }}"
                              loading="lazy"
                              width="150"
                              height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                            >
                          </div>
                        {% endif %}
                      </td>

                      <td class="cart-item__details">
                        {%- if settings.show_vendor -%}
                          <p class="caption-with-letter-spacing">{{ item.product.vendor }}</p>
                        {%- endif -%}

                        <a href="{{ item.url }}" class="cart-item__name h4 break">{{ item.product.title | escape }}</a>
                          <div class="variant_price_section">
                          <div class="ppp variant_price {{ item.product.handle }}">
                            {%- if item.product.has_only_default_variant == false
                              or item.properties.size != 0
                              or item.selling_plan_allocation != null
                            -%}
                              <dl>
                                {%- if item.product.has_only_default_variant == false -%}
                                  {%- for option in item.options_with_values -%}
                                    <div class="product-option">
                                      <!-- <dt>{{ option.name }}: </dt> -->
                                      <!-- <dd>{{ option.value }}</dd> -->
                                      <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">
                                        <p class="font_text">{{ option.value }}</p>
                                        {% if option.value == 'Regular: 6mg' %}
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="circle"></span>
                                          <span class="circle"></span>
                                        {% elsif option.value == 'Strong: 11mg' %}
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                        {% elsif option.value == 'Mild: 4mg' %}
                                          <span class="dot"></span>
                                          <span class="circle"></span>
                                          <span class="circle"></span>
                                          <span class="circle"></span>
                                        {% elsif option.value == 'Intense: 20mg' %}
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                        {% else %}
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                        {% endif %}
                                      </label>
                                    </div>
                                  {%- endfor -%}
                                {%- endif -%}

                              </dl>
                            {%- endif -%}
                          </div>
                        </div>
                        {%- if item.original_price != item.final_price -%}
                          <div class="cart-item__discounted-prices">
                            <span class="visually-hidden">
                              {{ 'products.product.price.regular_price' | t }}
                            </span>
                            <s class="cart-item__old-price product-option">
                              {{- item.original_price | money -}}
                            </s>
                            <span class="visually-hidden">
                              {{ 'products.product.price.sale_price' | t }}
                            </span>
                            <strong class="cart-item__final-price product-option">
                              {{ item.final_price | money }}
                            </strong>
                          </div>
                        {%- else -%}
                          <div class="product-option" style="display:none;">
                            {{ item.original_price | money }}
                          </div>
                        {%- endif -%}

                        {%- if item.product.has_only_default_variant == false
                          or item.properties.size != 0
                          or item.selling_plan_allocation != null
                        -%}
                          <dl>
                            {%- if item.product.has_only_default_variant == false -%}
                              {%- for option in item.options_with_values -%}
                                <div class="product-option" style="display:none;">
                                  <dt>{{ option.name }}:</dt>
                                  <dd>{{ option.value }}</dd>
                                </div>
                              {%- endfor -%}
                            {%- endif -%}

                            {%- for property in item.properties -%}
                              {%- assign property_first_char = property.first | slice: 0 -%}
                              {%- if property.last != blank and property_first_char != '_' -%}
                                <div class="product-option">
                                  <dt>{{ property.first }}:</dt>
                                  <dd>
                                    {%- if property.last contains '/uploads/' -%}
                                      <a href="{{ property.last }}" class="link" target="_blank">
                                        {{ property.last | split: '/' | last }}
                                      </a>
                                    {%- else -%}
                                      {{ property.last }}
                                    {%- endif -%}
                                  </dd>
                                </div>
                              {%- endif -%}
                            {%- endfor -%}
                          </dl>

                          <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                        {%- endif -%}

                        <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                          {%- for discount in item.line_level_discount_allocations -%}
                            <li class="discounts__discount">
                              {{- 'icon-discount.svg' | inline_asset_content -}}
                              {{ discount.discount_application.title | escape }}
                            </li>
                          {%- endfor -%}
                        </ul>
                      </td>
                    {% endcomment %}

                    <td class="cart-item__media">
                      {% if item.image %}
                        <div>
                          <a href="{{ item.url }}" class="cart-item__link" aria-hidden="true" tabindex="-1"> </a>
                        </div>
                        <div class="cart-item__image-container gradient {% if item.parent_relationship.parent == null %}global-media-settings{% endif %}">
                          <img
                            src="{{ item.image | image_url: width: 300 }}"
                            class="cart-item__image {% if item.parent_relationship.parent != null %}global-media-settings{% endif %}"
                            alt="{{ item.image.alt | escape }}"
                            loading="lazy"
                            width="150"
                            height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
                          >
                        </div>
                      {% endif %}
                      {%- if settings.show_vendor -%}
                        <p class="caption-with-letter-spacing">{{ item.product.vendor }}</p>
                      {%- endif -%}
                      <div>
                        <div>
                          <a href="{{ item.url }}" class="cart-item__name h4 break">
                            {{- item.product.title | escape -}}
                          </a>
                        </div>
                        <div class="variant_price_section">
                          <div class="ppp variant_price {{ item.product.handle }}">
                            {%- if item.product.has_only_default_variant == false
                              or item.properties.size != 0
                              or item.selling_plan_allocation != null
                            -%}
                              <dl>
                                {%- if item.product.has_only_default_variant == false -%}
                                  {%- for option in item.options_with_values -%}
                                    <div class="product-option">
                                      <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">
                                        <p class="font_text">{{ option.value }}</p>
                                        {% if option.value == 'Regular: 6mg' %}
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="circle"></span>
                                          <span class="circle"></span>
                                        {% elsif option.value == 'Strong: 11mg' %}
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                        {% elsif option.value == 'Mild: 4mg' %}
                                          <span class="dot"></span>
                                          <span class="circle"></span>
                                          <span class="circle"></span>
                                          <span class="circle"></span>
                                        {% elsif option.value == 'Intense: 20mg' %}
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                        {% else %}
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                          <span class="dot"></span>
                                        {% endif %}
                                      </label>
                                    </div>
                                  {%- endfor -%}
                                {%- endif -%}

                                {%- for property in item.properties -%}
                                  {%- assign property_first_char = property.first | slice: 0 -%}
                                  {%- if property.last != blank and property_first_char != '_' -%}
                                    <div class="product-option">
                                      <dt>{{ property.first }}:</dt>
                                      <dd>
                                        {%- if property.last contains '/uploads/' -%}
                                          <a href="{{ property.last }}" class="link" target="_blank">
                                            {{ property.last | split: '/' | last }}
                                          </a>
                                        {%- else -%}
                                          {{ property.last }}
                                        {%- endif -%}
                                      </dd>
                                    </div>
                                  {%- endif -%}
                                {%- endfor -%}
                              </dl>

                              <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                            {%- endif -%}
                          </div>
                        </div>
                      </div>
                      {% comment %}
                        {%- if item.original_price != item.final_price -%}
                          <div class="cart-item__discounted-prices" >
                            <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                            <s class="cart-item__old-price product-option">{{- item.original_price | money -}}</s>
                            <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
                            <strong class="cart-item__final-price product-option">{{ item.final_price | money }}</strong>
                          </div>
                        {%- endif -%}

                        <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                          {%- for discount in item.line_level_discount_allocations -%}
                            <li class="discounts__discount">
                              {{- 'icon-discount.svg' | inline_asset_content -}}
                              {{ discount.discount_application.title | escape }}
                            </li>
                          {%- endfor -%}
                        </ul>
                      {% endcomment %}
                    </td>

                    <td class="cart-item__details" style="display:none;">
                      {%- if settings.show_vendor -%}
                        <p class="caption-with-letter-spacing">{{ item.product.vendor }}</p>
                      {%- endif -%}

                      <a href="{{ item.url }}" class="cart-item__name h4 break">{{ item.product.title | escape }}</a>

                      <div class="variant_price_section">
                        <div class="ppp variant_price {{ item.product.handle }}">
                          {%- if item.product.has_only_default_variant == false
                            or item.properties.size != 0
                            or item.selling_plan_allocation != null
                          -%}
                            <dl>
                              {%- if item.product.has_only_default_variant == false -%}
                                {%- for option in item.options_with_values -%}
                                  <div class="product-option">
                                    <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">
                                      <p class="font_text">{{ option.value }}</p>
                                      {% if option.value == 'Regular: 6mg' %}
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                        <span class="circle"></span>
                                        <span class="circle"></span>
                                      {% elsif option.value == 'Strong: 11mg' %}
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                      {% elsif option.value == 'Mild: 4mg' %}
                                        <span class="dot"></span>
                                        <span class="circle"></span>
                                        <span class="circle"></span>
                                        <span class="circle"></span>
                                      {% elsif option.value == 'Intense: 20mg' %}
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                      {% else %}
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                        <span class="dot"></span>
                                      {% endif %}
                                    </label>
                                  </div>
                                {%- endfor -%}
                              {%- endif -%}

                              {%- for property in item.properties -%}
                                {%- assign property_first_char = property.first | slice: 0 -%}
                                {%- if property.last != blank and property_first_char != '_' -%}
                                  <div class="product-option">
                                    <dt>{{ property.first }}:</dt>
                                    <dd>
                                      {%- if property.last contains '/uploads/' -%}
                                        <a href="{{ property.last }}" class="link" target="_blank">
                                          {{ property.last | split: '/' | last }}
                                        </a>
                                      {%- else -%}
                                        {{ property.last }}
                                      {%- endif -%}
                                    </dd>
                                  </div>
                                {%- endif -%}
                              {%- endfor -%}
                            </dl>

                            <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                          {%- endif -%}
                        </div>
                      </div>

                      {%- if item.original_price != item.final_price -%}
                        <div class="cart-item__discounted-prices">
                          <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                          <s class="cart-item__old-price product-option">{{- item.original_price | money -}}</s>
                          <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
                          <strong class="cart-item__final-price product-option">{{ item.final_price | money }}</strong>
                        </div>
                      {%- endif -%}

                      <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                        {%- for discount in item.line_level_discount_allocations -%}
                          <li class="discounts__discount">
                            {{- 'icon-discount.svg' | inline_asset_content -}}
                            {{ discount.discount_application.title | escape }}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </td>

                    <td class="cart_product_individual_price small-hide">
                      {%- if item.original_price != item.final_price -%}
                        <div class="cart-item__discounted-pricesxxx product-option">
                          <span class="visually-hidden">
                            {{ 'products.product.price.regular_price' | t }}
                          </span>
                          <s class="cart-item__old-price product-option">
                            {{- item.original_price | money -}}
                          </s>
                          <span class="visually-hidden">
                            {{ 'products.product.price.sale_price' | t }}
                          </span>
                          <strong class="cart-item__final-price product-option">
                            {{ item.final_price | money }}
                          </strong>
                        </div>
                      {% elsif item.properties._upsell == '1' %}
                        <div class="cart-item__discounted-pricesxxx product-option">
                          <span class="visually-hidden">
                            {{ 'products.product.price.regular_price' | t }}
                          </span>
                          <s class="cart-item__old-price product-option">
                            {{- item.product.compare_at_price | money -}}
                          </s>
                          <span class="visually-hidden">
                            {{ 'products.product.price.sale_price' | t }}
                          </span>
                          <strong class="cart-item__final-price product-option">
                            {{ item.final_price | money }}
                          </strong>
                        </div>
                      {%- else -%}
                        <div class="product-option" {{ item.product.compare_at_price | money }}>
                          {{ item.original_price | money }}
                        </div>
                      {%- endif -%}
                    </td>

                    <td class="cart-item__totals right medium-hide large-up-hide desktop">
                      {%- render 'loading-spinner' -%}
                      <div class="cart-item__price-wrapper">
                        {%- if item.original_line_price != item.final_line_price -%}
                          <dl class="cart-item__discounted-prices">
                            <dt class="visually-hidden">
                              {{ 'products.product.price.regular_price' | t }}
                            </dt>
                            <dd>
                              <s class="cart-item__old-price price price--end">
                                {{ item.original_line_price | money }}
                              </s>
                            </dd>
                            <dt class="visually-hidden">
                              {{ 'products.product.price.sale_price' | t }}
                            </dt>
                            <dd class="price price--end">
                              {{ item.final_line_price | money }}
                            </dd>
                          </dl>
                        {%- else -%}
                          <span class="price price--end">
                            {{ item.original_line_price | money }}
                          </span>
                        {%- endif -%}

                        {%- if item.variant.available and item.unit_price_measurement -%}
                          {% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}
                        {%- endif -%}
                      </div>
                      <ul
                        class="discounts list-unstyled cart-item__discounted-prices"
                        role="list"
                        aria-label="{{ 'customer.order.discount' | t }}"
                      >
                        {%- for discount in item.discounts -%}
                          <li class="discounts__discount">
                            {%- render 'icon-discount' -%}
                            {{ discount.title }}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </td>
                    {%- liquid
                      assign has_qty_rules = false
                      if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                        assign has_qty_rules = true
                      endif

                      assign has_vol_pricing = false
                      if item.variant.quantity_price_breaks.size > 0
                        assign has_vol_pricing = true
                      endif
                    -%}
                    <td class="cart-item__quantity{% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}">
                      <quantity-popover>
                        <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
                          <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
                            {{ 'products.product.quantity.label' | t }}
                          </label>
                          <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                            {%- if has_qty_rules or has_vol_pricing -%}
                              <button
                                type="button"
                                aria-expanded="false"
                                class="quantity-popover__info-button quantity-popover__info-button--icon-only button button--tertiary small-hide medium-hide"
                              >
                                {{- 'icon-info.svg' | inline_asset_content -}}
                              </button>
                            {%- endif -%}
                            <cart-remove-button
                              id="Remove-{{ item.index | plus: 1 }}"
                              data-index="{{ item.index | plus: 1 }}"
                              style="{% if item.properties._upsell == '1' %}display:none{% endif %}"
                            >
                              <a
                                href="{{ item.url_to_remove }}"
                                class="button button--tertiary"
                                aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}"
                              >
                                <img
                                  src="https://cdn.shopify.com/s/files/1/0559/7075/8753/files/delete-icon.svg?v=1727063505"
                                  alt="del"
                                >
                              </a>
                            </cart-remove-button>
                            <quantity-input class="quantity cart-quantity">
                              {% assign can_update_quantity = item.instructions.can_update_quantity | default: true %}
                              <button
                                class="quantity__button"
                                name="minus"
                                type="button"
                                {% if can_update_quantity == false %}
                                  disabled
                                {% endif %}
                              >
                                <span class="visually-hidden">
                                  {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
                                </span>
                                <span class="svg-wrapper">
                                  {{- 'icon-minus.svg' | inline_asset_content -}}
                                </span>
                              </button>
                              <input
                                class="quantity__input"
                                data-quantity-variant-id="{{ item.variant.id }}"
                                type="number"
                                name="updates[]"
                                value="{{ item.quantity }}"
                                {% # theme-check-disable %}
                                data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                min="0"
                                data-min="{{ item.variant.quantity_rule.min }}"
                                {% if item.variant.quantity_rule.max != null %}
                                  max="{{ item.variant.quantity_rule.max }}"
                                {% endif %}
                                step="{{ item.variant.quantity_rule.increment }}"
                                {% # theme-check-enable %}
                                aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                id="Quantity-{{ item.index | plus: 1 }}"
                                data-index="{{ item.index | plus: 1 }}"
                                {% if can_update_quantity == false %}
                                  disabled
                                {% endif %}
                              >
                              <button
                                class="quantity__button"
                                name="plus"
                                type="button"
                                {% if can_update_quantity == false %}
                                  disabled
                                {% endif %}
                              >
                                <span class="visually-hidden">
                                  {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
                                </span>
                                <span class="svg-wrapper">
                                  {{- 'icon-plus.svg' | inline_asset_content -}}
                                </span>
                              </button>
                            </quantity-input>
                          </div>
                        </div>
                        {%- if has_qty_rules or has_vol_pricing -%}
                          <button
                            type="button"
                            class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary large-up-hide"
                            aria-expanded="false"
                          >
                            {{- 'icon-info.svg' | inline_asset_content -}}
                            <span>
                              {%- if has_vol_pricing -%}
                                {{ 'products.product.volume_pricing.note' | t }}
                              {%- elsif has_qty_rules -%}
                                {{ 'products.product.quantity.note' | t }}
                              {%- endif -%}
                            </span>
                          </button>
                        {%- endif -%}
                        {%- if has_vol_pricing or has_qty_rules -%}
                          <div
                            class="cart-items__info global-settings-popup quantity-popover__info"
                            tabindex="-1"
                            hidden
                          >
                            {%- if has_qty_rules == false -%}
                              <span class="volume-pricing-label caption">
                                {{- 'products.product.volume_pricing.title' | t -}}
                              </span>
                            {%- endif -%}
                            <div class="quantity__rules caption">
                              {%- if item.variant.quantity_rule.increment > 1 -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.multiples_of'
                                    | t: quantity: item.variant.quantity_rule.increment
                                  -}}
                                </span>
                              {%- endif -%}
                              {%- if item.variant.quantity_rule.min > 1 -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.min_of'
                                    | t: quantity: item.variant.quantity_rule.min
                                  -}}
                                </span>
                              {%- endif -%}
                              {%- if item.variant.quantity_rule.max != null -%}
                                <span class="divider">
                                  {{-
                                    'products.product.quantity.max_of'
                                    | t: quantity: item.variant.quantity_rule.max
                                  -}}
                                </span>
                              {%- endif -%}
                            </div>
                            <button
                              class="button-close button button--tertiary large-up-hide"
                              type="button"
                              aria-label="{{ 'accessibility.close' | t }}"
                            >
                              <span class="svg-wrapper">
                                {{- 'icon-close.svg' | inline_asset_content -}}
                              </span>
                            </button>
                            {%- if item.variant.quantity_price_breaks.size > 0 -%}
                              <volume-pricing class="parent-display">
                                <ul class="list-unstyled">
                                  <li>
                                    <span>{{ item.variant.quantity_rule.min }}+</span>
                                    {%- assign price = item.variant.price | money_with_currency -%}
                                    <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                  </li>
                                  {%- for price_break in item.variant.quantity_price_breaks -%}
                                    <li>
                                      <span>
                                        {{- price_break.minimum_quantity -}}
                                        <span aria-hidden="true">+</span></span
                                      >
                                      {%- assign price = price_break.price | money_with_currency -%}
                                      <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </volume-pricing>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                        <div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
                          <small class="cart-item__error-text"></small>
                          <span class="svg-wrapper">
                            {{- 'icon-error.svg' | inline_asset_content -}}
                          </span>
                        </div>
                      </quantity-popover>
                    </td>

                    <td class="cart-item__totals right">
                      {%- render 'loading-spinner' -%}
                      <div class="cart-item__price-wrapper">
                        {%- if item.original_line_price != item.final_line_price -%}
                          <dl class="cart-item__discounted-prices">
                            <dt class="visually-hidden">
                              {{ 'products.product.price.regular_price' | t }}
                            </dt>
                            <dd>
                              <s class="cart-item__old-price price price--end">
                                {{ item.original_line_price | money }}
                              </s>
                            </dd>
                            <dt class="visually-hidden">
                              {{ 'products.product.price.sale_price' | t }}
                            </dt>
                            <dd class="price price--end">
                              {{ item.final_line_price | money }}
                            </dd>
                          </dl>
                        {%- else -%}
                          <span class="price price--end">
                            {{ item.original_line_price | money }}
                          </span>
                        {%- endif -%}

                        {%- if item.variant.available and item.unit_price_measurement -%}
                          {% render 'unit-price', price: item.unit_price, measurement: item.unit_price_measurement %}
                        {%- endif -%}
                      </div>
                      <ul
                        class="discounts list-unstyled cart-item__discounted-prices"
                        role="list"
                        aria-label="{{ 'customer.order.discount' | t }}"
                      >
                        {%- for discount in item.discounts -%}
                          <li class="discounts__discount">
                            {%- render 'icon-discount' -%}
                            {{ discount.title }}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
            {% comment %}
              {% unless customer and customer.tags contains 'Approved' %}
                {% comment %}{% endcomment %}
                {% assign ProBundle = 0 %}

                {% assign ProDiscounted = cart.item_count | minus: count %}
                {% assign ProDiscounted = ProDiscounted | minus: ProBundle %}

                {% if ProDiscounted < 48 %}
                  <div class="discounted_info yug" {{ ProDiscounted }}>
                    {% comment %}
                      {% if ProDiscounted == 1 %}
                        {% assign ProDiscountedPercent = ProDiscounted | divided_by: 3.0 %}
                        <p {{ ProDiscountedPercent }}>Buy {{ 3 | minus: ProDiscounted }} more for £6.01</p>
                      {% elsif ProDiscounted == 2 %}
                        {% assign ProDiscountedPercent = ProDiscounted | divided_by: 3.0 %}
                        <p {{ ProDiscountedPercent }}>Buy {{ 3 | minus: ProDiscounted }} more for £0.02</p>
                    {% endcomment %}
                    {% if ProDiscounted < 3 %}
                      {% assign ProDiscountedPercent = ProDiscounted | divided_by: 3.0 %}
                      <p {{ ProDiscountedPercent }}>Buy {{ 3 | minus: ProDiscounted }} more and get 41.67% on each product</p>

                    {% elsif ProDiscounted >= 3 and ProDiscounted < 6 %}
                      {% assign ProDiscountedPercent = ProDiscounted | divided_by: 6.0 %}
                      <p {{ ProDiscountedPercent }}>Buy {{ 6 | minus: ProDiscounted }} more and get 50% on each product</p>

                    {% elsif ProDiscounted >= 6 and ProDiscounted < 12 %}
                      {% assign ProDiscountedPercent = ProDiscounted | divided_by: 12.0 %}
                      <p {{ ProDiscountedPercent }}>Buy {{ 12 | minus: ProDiscounted }} more and get 65% on each product</p>

                    {% elsif ProDiscounted >= 12 and ProDiscounted < 24 %}
                      {% assign ProDiscountedPercent = ProDiscounted | divided_by: 24.0 %}
                      <p {{ ProDiscountedPercent }}>Buy {{ 24 | minus: ProDiscounted }} more and get 66% on each product</p>

                      {% comment %}
                    {% elsif ProDiscounted >= 24 and ProDiscounted < 48 %}
                      {% assign ProDiscountedPercent = ProDiscounted | divided_by: 48.0 %}
                      <p {{ ProDiscountedPercent }}>Buy {{ 48 | minus: ProDiscounted }} more and get 50% on each product</p>

                        {% elsif ProDiscounted >= 24 and ProDiscounted < 36 %}
                          {% for item in cart.items %}
                            {% if item.product.tags contains 'mint' %}
                              <p>Buy {{ 36 | minus: ProDiscounted }} more and get 50% on each product</p>
                            {% endif %}
                          {% endfor %}
                      {% endcomment %}
                    {% endif %}
                    {% if ProDiscountedPercent > 0 %}
                      <div class="progress">
                        <div class="bar" style="width:{{ ProDiscountedPercent | times:100 }}%">
                          <p class="percent"></p>
                        </div>
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              {% endunless %}
            {% endcomment %}

            {% for block in section.blocks %}
              {%- case block.type -%}
                {%- when '@app' -%}
                  {% render block %}
                {%- when 'subtotal' -%}
                  <div class="js-contents cart-items-total" {{ block.shopify_attributes }}>
                    <div class="totals">
                      <h3 class="totals__subtotal">
                        Total
                        <small
                          ><br>
                          VAT included</small
                        >
                      </h3>
                      {% assign discount = cart.total_price | divided_by: 1.05 | times: 0.05 %}
                      <div>
                        <div class="total-and-discount-wrapper">
                          {% comment %}
                            {% unless customer and customer.tags contains 'Approved' %}
                              <div class="original_total_price">
                                {% if cart.item_count >= 3 %}
                                  <p>{{ cart.original_total_price | money_with_currency }}</p>
                                {% endif %}
                              </div>
                            {% endunless %}
                          {% endcomment %}
                          <p data-hulkapps-cart-total class="totals__subtotal-value">
                            {{ cart.total_price | money_with_currency }}
                          </p>
                        </div>
                        <div class="vat-class right">{{ discount | money_with_currency }}</div>
                      </div>
                    </div>

                    {% comment %}
                      <div class="reward_points_sec">
                        {%- assign points_per_pound = 1 -%}
                        {%- assign total_price = cart.total_price | divided_by: 100.0 -%}
                        {%- assign smile_points = total_price | times: points_per_pound | ceil -%}

                        {% if customer %}
                          <p>Earn {{ smile_points }} points for this order</p>
                        {% else %}
                          <p>
                            <span id="accBtn">Log in</span> before purchasing to earn {{ smile_points }} points for this
                            order
                          </p>
                        {% endif %}
                      </div>
                    {% endcomment %}
                    <div>
                      {%- if cart.cart_level_discount_applications.size > 0 -%}
                        <ul
                          class="discounts list-unstyled"
                          role="list"
                          aria-label="{{ 'customer.order.discount' | t }}"
                        >
                          {%- for discount in cart.cart_level_discount_applications -%}
                            <li class="discounts__discount discounts__discount--position">
                              {%- render 'icon-discount' -%}
                              {{ discount.title }}
                              (-{{ discount.total_allocated_amount | money }})
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </div>

                    <small class="tax-note caption-large rte">
                      {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                        {{
                          'sections.cart.taxes_included_and_shipping_policy_html'
                          | t: link: shop.shipping_policy.url
                        }}
                      {%- elsif cart.taxes_included -%}
                        {{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}
                      {%- elsif shop.shipping_policy.body != blank -%}
                        {{
                          'sections.cart.taxes_and_shipping_policy_at_checkout_html'
                          | t: link: shop.shipping_policy.url
                        }}
                      {%- else -%}
                        {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
                      {%- endif -%}
                    </small>
                    <div class="methods-of-payment-wrapper">
                      <p>
                        <span
                          ><img
                            src="https://cdn.shopify.com/s/files/1/0559/7075/8753/files/padlock.svg?v=1736249729"
                            width="20px"
                            height="15px"
                        ></span>
                        All transactions are secure and encrypted
                      </p>
                      <div>{% render 'methods-of-payment' %}</div>
                    </div>
                  </div>
                {%- else -%}
                  <div class="cart__ctas" {{ block.shopify_attributes }}>
                    <noscript>
                      <button type="submit" class="cart__update-button button button--secondary" form="cart">
                        {{ 'sections.cart.update' | t }}
                      </button>
                    </noscript>
                    <button
                      type="submit"
                      id="checkout"
                      class="jjj cart__checkout-button cmn_btn"
                      name="checkout"
                      {% if cart == empty %}
                        disabled
                      {% endif %}
                      form="cart"
                    >
                      {{ 'sections.cart.checkout' | t }}
                    </button>
                  </div>

                  {%- if additional_checkout_buttons -%}
                    <div class="cart__dynamic-checkout-buttons additional-checkout-buttons">
                      {{ content_for_additional_checkout_buttons }}
                    </div>
                  {%- endif -%}
              {%- endcase -%}
            {% endfor %}
          {%- endif -%}
        </div>
      </div>

      <style>
        #cart-errors { display: none !important }
        .cart-item__error { display: none !important }
        .watermelon .dot{background-color: var(--color_watermelon);}
        .berry .dot{background-color: var(--color_berry);}
        .menthol .dot{background-color: var(--color_menthol);}
        .peppermint .dot{background-color: var(--color_peppermint);}
        .spearmint .dot{background-color: var(--color_spearmint);}
        .cola-ice .dot{background-color: var(--color_cola);}
        .salted-caramel .dot{background-color: var(--color_salted_caramel);}
        .peach-passion .dot{background-color: var(--color_peach_passion);}
        .zest-ice .dot{background-color: var(--color_zest_ice);}

        .progress {margin:10px 0 0 auto; padding:0; width:100%; max-width:330px; height:10px; overflow:hidden; background:#e5e5e5; border-radius:10px;}
        .bar {position:relative; float:left; min-width:1%; height:100%; background-color:#5ECCC8;}
              /* .cart-items tbody{
          display:grid;
              }
        .cart-items tr.upsell-discountxxxx{ grid-row:10;} */
        .card__badge.points_badge{
          top: 0;
          position: absolute;
          z-index: 7;
          display: flex;
          column-gap: 8px;
          width:100%;
        }
        .card__badge.points_badge p{
          display: block;
          border-radius: 20px;
          text-transform: uppercase;
          text-align: left;
          padding: 3px 10px;
          height: 18px;
          font-size: 8px;
          font-family: 'KronaRegular';
          line-height: inherit;
          background-color: var(--color_cherry) !important;
          border-color: var(--color_cherry) !important;

        }
      </style>

      <p class="visually-hidden" id="cart-live-region-text" aria-live="polite" role="status"></p>
      <p
        class="visually-hidden"
        id="shopping-cart-line-item-status"
        aria-live="polite"
        aria-hidden="true"
        role="status"
      >
        {{ 'accessibility.loading' | t }}
      </p>
    </form>
  </div>
</cart-items>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}

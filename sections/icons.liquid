{% comment %}
  Section: Ways to Earn (with schema settings)
  Author: Custom by Priya
{% endcomment %}

<section class="ways-to-earn" id="ways-to-earn-{{ section.id }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="ways-to-earn__title">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="ways-to-earn__grid">
      {% for block in section.blocks %}
        <div class="ways-to-earn__item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <div class="icon">
              <img
                src="{{ block.settings.icon | image_url: width: 100 }}"
                alt="{{ block.settings.title | escape }}"
                loading="lazy">
            </div>
          {% endif %}
          {% if block.settings.title != blank %}
            <h4>{{ block.settings.title }}</h4>
          {% endif %}
          {% if block.settings.points != blank or block.settings.description != blank %}
            <p>
              {% if block.settings.points != blank %}
                <strong>{{ block.settings.points }}</strong>
              {% endif %}
            </p>
             <p class="icon_des">
              {% if block.settings.description != blank %}
                {{ block.settings.description }}
              {% endif %}
            </p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.ways-to-earn {
  padding: 60px 0;
  background: #fff;
  text-align: center;
}
.ways-to-earn__title {
    font-size: 64px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 50px;
    letter-spacing: 1px;
    font-family: KronaRegular;
}
.ways-to-earn__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 40px;
}

.ways-to-earn__item {
  background: #f9fafb;
  border-radius: 12px;
  padding: 30px 20px;
  transition: all 0.3s ease;
  border: 1px solid #e5e7eb;
}

.ways-to-earn__item:hover {
  transform: translateY(-5px);
  box-shadow: 0 4px 20px rgba(0,0,0,0.08);
  background: #fff;
}

.ways-to-earn__item .icon {
  margin-bottom: 15px;
}

.ways-to-earn__item .icon img {
  width: 60px;
  height: 60px;
  object-fit: contain;
}

.ways-to-earn__item h4 {
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 10px;
}

.ways-to-earn__item p {
  font-size: 0.95rem;
  color: #555;
  line-height: 1.6;
}
.ways-to-earn__item strong {
    display: block;
    color: #111;
    font-weight: 700;
    margin-bottom: 4px;
    font-size: 18px;
    line-height: 1.2;
}
p.icon_des {
    font-size: 22px;
    line-height: 1.2;
}
@media (min-width: 768px) {
  .ways-to-earn__grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
@media (max-width:480px){
 .ways-to-earn__title {
    font-size: 24px;
    margin-bottom: 20px;
}
p.icon_des {
    font-size: 15px;
}
.ways-to-earn__item .icon img {
    width: 50px;
    height: 50px;
}
.ways-to-earn {
    padding: 20px 0;
}
}
</style>

{% schema %}
{
  "name": "icons",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Ways to Earn"
    }
  ],
  "blocks": [
    {
      "type": "earn_item",
      "name": "Way to Earn",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Sign up"
        },
        {
          "type": "text",
          "id": "points",
          "label": "Points Text",
          "default": "10 POINTS"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Receive 10 points for registering your account."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "icons",
      "category": "Custom Sections",
      "blocks": [
        {
          "type": "earn_item"
        },
        {
          "type": "earn_item"
        },
        {
          "type": "earn_item"
        }
      ]
    }
  ]
}
{% endschema %}

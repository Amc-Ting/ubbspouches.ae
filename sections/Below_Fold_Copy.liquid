{% comment %} {%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .below_fold_copy .metafield-rich_text_field>*{margin: 1rem 0;}
  .below_fold_copy ul li {
    list-style-type: "— ";
    margin: 0.5rem 0;
  }
  .below_fold_table_copy{
    width: 100%;
    overflow: auto;
    padding: 1px;
  }
  .below_fold_table_copy table {
    width:100%;
  }
  .below_fold_table_copy table tr{
    font-size:20px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .section-{{ section.id }}-padding a{
      font-size:20px;
      color: rgba(var(--color-foreground));
      text-decoration: underline;
    }
    .section-{{ section.id }}-padding table a.block{
      display:block;
    }
  }
  @media screen and (max-width: 750px) {
    .below_fold_table_copy table th,
    .below_fold_table_copy table td {
      font-size: 16px;
      padding: .75rem;
    }
  }
{%- endstyle -%}
<div class="section-{{ section.id }}-padding below_fold_copy">
  <div class="page-width">
    {{ collection.metafields.custom.below_the_fold_copy | metafield_tag }}
    {% if collection.metafields.custom.below_the_fold_table_copy.value != blank %}
      <div class="metafield-rich_text_field below_fold_table_copy">
        {% assign table_data = collection.metafields.custom.below_the_fold_table_copy.value %}

        {% if table_data != blank %}
          <table>
            {% for row in table_data %}
              {% if forloop.first %}
                <thead>
                  <tr>
                    {% for key_value in row %}
                      <th>{{ key_value[1] }}</th>
                    {% endfor %}
                  </tr>
                </thead>
                <tbody>
              {% else %}
                <tr>
                  {% for key_value in row %}
                    <td>{{ key_value[1] }}</td>
                  {% endfor %}
                </tr>
              {% endif %}
            {% endfor %}
            </tbody>
          </table>
        {% endif %}
        
      </div>
    {% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Below Fold Copy",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Below Fold Copy"
    }
  ]
}
{% endschema %} {% endcomment %}



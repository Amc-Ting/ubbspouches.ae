{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{{ 'ubbs-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_social_icons = false
  if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_tiktok_link != blank or settings.social_twitter_link != blank or settings.social_pinterest_link != blank or settings.social_snapchat_link != blank or settings.social_tumblr_link != blank or settings.social_vimeo_link != blank
    assign has_social_icons = true
  endif

  assign footer_logo_block = blank
  assign footer_help_block = blank
  for block in section.blocks
    case block.type
      when 'image'
        if footer_logo_block == blank
          assign footer_logo_block = block
        endif
      when 'text'
        if footer_help_block == blank
          assign footer_help_block = block
        endif
    endcase
  endfor

  assign has_language = false
  if section.settings.enable_language_selector and localization.available_languages.size > 1
    assign has_language = true
  endif

  assign has_country = false
  if section.settings.enable_country_selector and localization.available_countries.size > 1
    assign has_country = true
  endif
-%}

<footer
  id="UbbsFooter-{{ section.id }}"
  class="custom_footer ubbs-footer color-{{ section.settings.color_scheme }} gradient"
  style="--ubbs-footer-padding-top: {{ section.settings.padding_top }}px; --ubbs-footer-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="ubbs-footer__inner">
    <div class="ubbs-footer__main">
      <div class="ubbs-footer__left">
        <div class="ubbs-footer__brand">
          <div
            class="ubbs-footer__logo"
            {% if footer_logo_block != blank %}
              {{- footer_logo_block.shopify_attributes -}}
            {% endif %}
          >
            <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
              {%- if footer_logo_block != blank and footer_logo_block.settings.image != blank -%}
                {{
                  footer_logo_block.settings.image
                  | image_url: width: 300
                  | image_tag: loading: 'lazy', widths: '100,150,200,300', width: 100, alt: shop.name
                }}
              {%- elsif settings.brand_image != blank -%}
                {{
                  settings.brand_image
                  | image_url: width: 300
                  | image_tag: loading: 'lazy', widths: '100,150,200,300', width: 100, alt: shop.name
                }}
              {%- elsif settings.logo != blank -%}
                {{
                  settings.logo
                  | image_url: width: 300
                  | image_tag: loading: 'lazy', widths: '100,150,200,300', width: 100, alt: shop.name
                }}
              {%- else -%}
                {{ shop.name }}
              {%- endif -%}
            </a>
          </div>

          <p class="ubbs-footer__desc">
            Long-lasting flavour. Pharmaceutical-grade quality. Precision-crafted satisfaction in every pouch.
          </p>

          <span class="ubbs-footer__email-label">Email us at</span>
          <a class="ubbs-footer__email" href="mailto:customerservices@ubbspouches.ae">
            customerservices@ubbspouches.ae
          </a>

          <div class="ubbs-footer__contacts">
            <a class="ubbs-footer__contact-btn" href="mailto:customerservices@ubbspouches.ae">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="m3 7 9 6 9-6"></path>
              </svg>
              <span>customerservices@ubbspouches.ae</span>
            </a>
            <a class="ubbs-footer__contact-btn" href="tel:+97180069800">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.6 21 3 13.4 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.2.2 2.4.57 3.6a1 1 0 0 1-.25 1l-2.22 2.2Z"></path>
              </svg>
              <span>+971 800 69 800</span>
            </a>
          </div>

          {%- if section.settings.newsletter_enable -%}
            <div class="ubbs-footer__newsletter">
              {%- if section.settings.newsletter_heading != blank -%}
                <h2 class="footer-block__heading inline-richtext">{{ section.settings.newsletter_heading }}</h2>
              {%- endif -%}
              {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="newsletter-form__field-wrapper">
                  <div class="field">
                    <input
                      id="NewsletterForm--{{ section.id }}"
                      type="email"
                      name="contact[email]"
                      class="field__input"
                      value="{{ form.email }}"
                      aria-required="true"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      {% if form.errors %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="ContactFooter-error"
                      {% elsif form.posted_successfully? %}
                        aria-describedby="ContactFooter-success"
                      {% endif %}
                      placeholder="{{ 'newsletter.label' | t }}"
                      required
                    >
                    <label class="field__label" for="NewsletterForm--{{ section.id }}">
                      {{ 'newsletter.label' | t }}
                    </label>
                    <button
                      type="submit"
                      class="newsletter-form__button field__button"
                      name="commit"
                      id="Subscribe-{{ section.id }}"
                      aria-label="{{ 'newsletter.button_label' | t }}"
                    >
                      <span class="svg-wrapper">
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                      </span>
                    </button>
                  </div>
                  {%- if form.errors -%}
                    <small class="newsletter-form__message form__message" id="ContactFooter-error">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email -}}
                    </small>
                  {%- endif -%}
                </div>
                {%- if form.posted_successfully? -%}
                  <h3
                    class="newsletter-form__message newsletter-form__message--success form__message"
                    id="ContactFooter-success"
                    tabindex="-1"
                    autofocus
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-success.svg' | inline_asset_content -}}
                    </span>
                    {{- 'newsletter.success' | t }}
                  </h3>
                {%- endif -%}
              {%- endform -%}
            </div>
          {%- endif -%}

          {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
            <div class="ubbs-footer__follow-shop">
              {{ shop | login_button: action: 'follow' }}
            </div>
          {%- endif -%}
        </div>

        {%- assign nav_col = 1 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'link_list' -%}
            {%- assign nav_col = nav_col | plus: 1 -%}
            {%- assign nav_panel_id = 'ubbs-footer-nav-' | append: block.id -%}
            <div class="ubbs-footer__nav" style="--nav-col: {{ nav_col }};" {{ block.shopify_attributes }}>
              <button
                type="button"
                class="ubbs-footer__nav-heading"
                aria-expanded="false"
                aria-controls="{{ nav_panel_id }}"
              >
                <span>{{ block.settings.heading | default: 'Menu' }}</span>
                <span class="ubbs-footer__nav-arrow" aria-hidden="true">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </button>
              <div class="ubbs-footer__nav-panel" id="{{ nav_panel_id }}">
                {%- if block.settings.menu != blank -%}
                  <ul class="ubbs-footer__links list-unstyled">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a
                          href="{{ link.url }}"
                          class="ubbs-footer__link{% if link.active %} ubbs-footer__link--active{% endif %}"
                        >
                          {{ link.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- assign help_col = nav_col | plus: 1 -%}
        <div
          class="ubbs-footer__nav ubbs-footer__nav--help"
          style="--nav-col: {{ help_col }};"
          {% if footer_help_block != blank %}
            {{- footer_help_block.shopify_attributes -}}
          {% endif %}
        >
          <button
            type="button"
            class="ubbs-footer__nav-heading"
            aria-expanded="false"
            aria-controls="ubbs-footer-nav-help-{{ section.id }}"
          >
            <span class="ubbs-footer__help-label">
              {%- if footer_help_block != blank and footer_help_block.settings.heading != blank -%}
                {{ footer_help_block.settings.heading }}
              {%- else -%}
                Need a Hand?
              {%- endif -%}
            </span>
            <span class="ubbs-footer__help-label-mobile">Help</span>
            <span class="ubbs-footer__nav-arrow" aria-hidden="true">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </button>
          <div class="ubbs-footer__nav-panel" id="ubbs-footer-nav-help-{{ section.id }}">
            {%- if footer_help_block != blank and footer_help_block.settings.subtext != blank -%}
              <div class="ubbs-footer__help-text rte">{{ footer_help_block.settings.subtext }}</div>
            {%- else -%}
              <ul class="ubbs-footer__links list-unstyled">
                <li><a href="tel:+97180069800">+971 800 69 800</a></li>
                <li><a href="/pages/contact">Contact us</a></li>
                <li><a href="/pages/faq">FAQs</a></li>
              </ul>
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="ubbs-footer__right">
        <div class="ubbs-footer__top">
          <div class="ubbs-footer__social">
            {%- if section.settings.show_social and has_social_icons -%}
              {%- render 'social-icons', class: 'footer__list-social' -%}
            {%- endif -%}
          </div>
        </div>

        <div class="ubbs-footer__age-row">
          <div class="ubbs-footer__age">
            <div class="ubbs-footer__age-icon" aria-hidden="true">
              <span>18+</span>
              <span class="ubbs-footer__age-check">
                <svg viewBox="0 0 12 10" fill="none" aria-hidden="true">
                  <path d="M1 5.2 4.2 8.4 11 1.6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
            </div>
            <div class="ubbs-footer__age-copy">
              <p class="ubbs-footer__age-title">{{ section.settings.age_title | escape }}</p>
              <p class="ubbs-footer__age-sub">
                {{ section.settings.age_verification_text | escape }}
                {%- if section.settings.age_verification_link != blank -%}
                  <a href="{{ section.settings.age_verification_link }}">
                    {{- section.settings.age_verification_link_label | escape -}}
                  </a>
                {%- endif -%}
              </p>
            </div>
            {%- if section.settings.agechecked_logo != blank or section.settings.trading_standards_logo != blank -%}
              <div class="ubbs-footer__verification-logos">
                {%- if section.settings.agechecked_logo != blank -%}
                  <div class="ubbs-footer__verification-logo ubbs-footer__verification-logo--agechecked">
                    {{
                      section.settings.agechecked_logo
                      | image_url: width: 500
                      | image_tag: loading: 'lazy', widths: '180,300,500', alt: 'AgeChecked'
                    }}
                  </div>
                {%- endif -%}
                {%- if section.settings.trading_standards_logo != blank -%}
                  <div class="ubbs-footer__verification-logo ubbs-footer__verification-logo--standards">
                    {{
                      section.settings.trading_standards_logo
                      | image_url: width: 500
                      | image_tag: loading: 'lazy', widths: '180,300,500', alt: 'Trading Standards'
                    }}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          <div class="ubbs-footer__localization">
            {%- if has_language -%}
              <div class="ubbs-footer__loc-group">
                <localization-form>
                  {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
                    <h2 class="ubbs-footer__loc-label" id="UbbsFooterLanguageLabel">
                      {{ 'localization.language_label' | t }}
                    </h2>
                    {%- render 'language-localization', localPosition: 'UbbsFooterLanguage' -%}
                  {%- endform -%}
                </localization-form>
              </div>
            {%- endif -%}

            {%- if has_country -%}
              <div class="ubbs-footer__loc-group ubbs-footer__loc-group--country">
                <localization-form>
                  {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
                    <h2 class="ubbs-footer__loc-label" id="UbbsFooterCountryLabel">
                      {{ 'localization.country_label' | t }}
                    </h2>
                    {%- render 'country-localization', localPosition: 'UbbsFooterCountry' -%}
                  {%- endform -%}
                </localization-form>
              </div>
            {%- endif -%}
          </div>
        </div>

        {%- if section.settings.trustpilot_image != blank -%}
          <div class="ubbs-footer__trustpilot">
            {%- if section.settings.trustpilot_url != blank -%}
              <a href="{{ section.settings.trustpilot_url }}" target="_blank" rel="noopener noreferrer">
            {%- endif -%}
            {{
              section.settings.trustpilot_image
              | image_url: width: 700
              | image_tag: loading: 'lazy', widths: '250,450,700', alt: 'Trustpilot reviews'
            }}
            {%- if section.settings.trustpilot_url != blank -%}</a>{%- endif -%}
          </div>
        {%- endif -%}

        <div class="ubbs-footer__payments">
          {%- if section.settings.payment_enable -%}
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            {%- render 'ubbs-footer-payments' -%}
          {%- endif -%}
        </div>

        <div class="ubbs-footer__legal">
          <p class="ubbs-footer__disclaimer">
            18+ only. This product contains nicotine, which is a highly addictive substance. Not suitable for pregnant
            and lactating women. Please read all the safety information on the übbs can before consumption. Keep übbs
            products away from children at all times.
          </p>
          <p class="ubbs-footer__copyright">&copy; übbs Nicotine Pouches {{ 'now' | date: '%Y' }}</p>
          {%- if section.settings.company_details != blank -%}
            <p class="ubbs-footer__company-details">{{ section.settings.company_details | escape }}</p>
          {%- endif -%}
          {%- if section.settings.show_policy -%}
            <ul class="policies list-unstyled">
              {%- for policy in shop.policies -%}
                {%- if policy != blank -%}
                  <li>
                    <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Übbs custom footer",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.link_list.settings.heading.default",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label"
        }
      ]
    },
    {
      "type": "brand_information",
      "name": "t:sections.footer.blocks.brand_information.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.brand_information.settings.paragraph.content"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "default": true,
          "label": "t:sections.footer.blocks.brand_information.settings.show_social.label",
          "info": "t:sections.footer.blocks.brand_information.settings.show_social.info"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.text.settings.heading.default",
          "label": "t:sections.footer.blocks.text.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "default": "t:sections.footer.blocks.text.settings.subtext.default",
          "label": "t:sections.footer.blocks.text.settings.subtext.label"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "footer_copy_text",
          "label": "Footer Text"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 50,
          "max": 550,
          "step": 5,
          "unit": "px",
          "label": "Width",
          "default": 100
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            {
              "value": "",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__1.content",
      "info": "t:sections.footer.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "t:sections.footer.settings.newsletter_enable.label"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "default": "t:sections.footer.settings.newsletter_heading.default",
      "label": "t:sections.footer.settings.newsletter_heading.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__9.content"
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "default": true,
      "label": "t:sections.footer.settings.enable_follow_on_shop.label",
      "info": "t:sections.footer.settings.enable_follow_on_shop.info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "t:sections.footer.settings.show_social.label",
      "info": "t:sections.footer.settings.show_social.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": true,
      "label": "t:sections.footer.settings.enable_country_selector.label",
      "info": "t:sections.footer.settings.enable_country_selector.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": true,
      "label": "t:sections.footer.settings.enable_language_selector.label",
      "info": "t:sections.footer.settings.enable_language_selector.info"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "t:sections.footer.settings.payment_enable.label"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "default": true,
      "label": "t:sections.footer.settings.show_policy.label",
      "info": "t:sections.footer.settings.show_policy.info"
    },
    {
      "type": "header",
      "content": "Age verification and trust"
    },
    {
      "type": "text",
      "id": "age_title",
      "label": "Age verification heading",
      "default": "For adult nicotine users only."
    },
    {
      "type": "text",
      "id": "age_verification_text",
      "label": "Age verification text",
      "default": "Every order is age verified by AgeChecked before it ships."
    },
    {
      "type": "url",
      "id": "age_verification_link",
      "label": "Age verification information URL"
    },
    {
      "type": "text",
      "id": "age_verification_link_label",
      "label": "Age verification link label",
      "default": "How it works"
    },
    {
      "type": "image_picker",
      "id": "agechecked_logo",
      "label": "AgeChecked logo"
    },
    {
      "type": "image_picker",
      "id": "trading_standards_logo",
      "label": "Trading Standards logo"
    },
    {
      "type": "image_picker",
      "id": "trustpilot_image",
      "label": "Trustpilot rating graphic"
    },
    {
      "type": "url",
      "id": "trustpilot_url",
      "label": "Trustpilot reviews URL"
    },
    {
      "type": "textarea",
      "id": "company_details",
      "label": "Company legal details",
      "default": "RV Karma Limited. Company no. 13811906. Room 2, 1st Floor, 7 Blighs Walk, Sevenoaks, England, TN13 1DB"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.margin_top.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Übbs custom footer",
      "blocks": [
        { "type": "link_list", "settings": { "heading": "Shop" } },
        { "type": "link_list", "settings": { "heading": "Discover" } },
        { "type": "link_list", "settings": { "heading": "Policies" } },
        { "type": "text", "settings": { "heading": "Need a Hand?" } }
      ]
    }
  ]
}
{% endschema %}

<script>
  (function () {
    function initUbbsFooterAccordions() {
      var footer = document.getElementById('UbbsFooter-{{ section.id }}');
      if (!footer || footer.dataset.accordionsInitialized === 'true') return;
      footer.dataset.accordionsInitialized = 'true';

      var navs = footer.querySelectorAll('.ubbs-footer__nav');
      var mobileQuery = window.matchMedia('(max-width: 749px)');

      function closeAll() {
        navs.forEach(function (nav) {
          nav.classList.remove('is-open');
          var button = nav.querySelector('.ubbs-footer__nav-heading');
          if (button) button.setAttribute('aria-expanded', 'false');
        });
      }

      navs.forEach(function (nav) {
        var button = nav.querySelector('.ubbs-footer__nav-heading');
        if (!button) return;

        button.addEventListener('click', function () {
          if (!mobileQuery.matches) return;

          var isOpen = nav.classList.contains('is-open');
          closeAll();

          if (!isOpen) {
            nav.classList.add('is-open');
            button.setAttribute('aria-expanded', 'true');
          }
        });
      });

      function handleViewportChange(event) {
        if (!event.matches) closeAll();
      }

      if (typeof mobileQuery.addEventListener === 'function') {
        mobileQuery.addEventListener('change', handleViewportChange);
      } else if (typeof mobileQuery.addListener === 'function') {
        mobileQuery.addListener(handleViewportChange);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initUbbsFooterAccordions);
    } else {
      initUbbsFooterAccordions();
    }
  })();
</script>

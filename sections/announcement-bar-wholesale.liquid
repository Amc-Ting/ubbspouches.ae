<div class="announcement-bar 1 color-accent-1 gradient" role="region" aria-label="{{ 'sections.header.announcement' | t }}" {{ block.shopify_attributes }}>
  {%- for block in section.blocks -%}
    <div class="announcement-bar__message h5" {% if block.settings.link != blank %}onclick="window.location.href='{{ block.settings.link }}';{% endif %}"><p><span class="icon-sec">{{ block.settings.icon }}</span> <span>{{ block.settings.text }} </span> {%- if block.settings.link != blank -%}  <span class="link_sec">{{ block.settings.link_label }}<span></span> {%- endif -%}</p> </div>
  {%- endfor -%}
</div>
<style>
  .announcement-bar{margin-bottom:0px;display: flex;
    justify-content: space-around;    padding: 5px 0; }
  .announcement-bar__message {text-align: center; padding: 0.5rem 2rem; margin: 0; letter-spacing: .1rem; font-size: 12px;
    font-weight: 600;}
 .announcement-bar .announcement-bar__message:nth-child(3) .icon-sec{
        margin: -5px 5px;
  }
</style>
{% comment %}
  {%- case block.type -%}
    {%- when 'announcement' -%}
      <div class="announcement-bar color-{{ block.settings.color_scheme }} gradient" role="region" aria-label="{{ 'sections.header.announcement' | t }}" {{ block.shopify_attributes }}>
        {%- if block.settings.text != blank -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="announcement-bar__link link link--text focus-inset animate-arrow">
          {%- endif -%}
              <p class="announcement-bar__message h5">
                {{ block.settings.text | escape }}
                {%- if block.settings.link != blank -%}
                  {% render 'icon-arrow' %}
                {%- endif -%}
              </p>
          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
  {%- endcase -%}
{% endcomment %}

<style>
#shopify-section-announcement-bar-wholesale{
  display:none;
}
  
  #shopify-section-announcement-bar-wholesale {
     top: 0px;
}
   @media (min-width: 768px) and (max-width: 1023px){
      #shopify-section-announcement-bar-wholesale {
    top: 0px;
}
   }
  .announcement-bar svg{
    width:15px;
  }

  .announcement-bar p{
        display: flex;
    justify-content: center;
    align-items: end;
  }

  .announcement-bar .icon-sec{
    margin: -3px 5px;
  }

@media (min-width: 1024px) and (max-width: 1279px) {
  .announcement-bar p{
    font-size:14px;
    letter-spacing:0.5px;
  }
}

@media (min-width: 768px) and (max-width: 1023px) {
  .announcement-bar p{
    font-size:14px;
    letter-spacing:0.5px;
  }
}
@media (max-width: 768px){
     #shopify-section-announcement-bar-wholesale {
    top: 0px;
}
   .announcement-bar{
     padding:0;
   }
  .announcement-bar p{
    font-size:14px;
    letter-spacing:0.5px;
    line-height:1.2;
  }
.announcement-bar__message {
  padding: 0.5rem 2rem;
}
}
  
</style>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "Add icon code"
        },
        {
          "type": "text",
          "id": "text",
          "default": "Welcome to our store",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "select",
          "id": "color_scheme",
          "options": [
            {
              "value": "accent-1",
              "label": "t:sections.all.colors.accent_1.label"
            },
            {
              "value": "accent-2",
              "label": "t:sections.all.colors.accent_2.label"
            },
            {
              "value": "background-1",
              "label": "t:sections.all.colors.background_1.label"
            },
            {
              "value": "background-2",
              "label": "t:sections.all.colors.background_2.label"
            },
            {
              "value": "inverse",
              "label": "t:sections.all.colors.inverse.label"
            }
          ],
          "default": "accent-1",
          "label": "t:sections.all.colors.label"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Add Button Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement"
      }
    ]
  }
}
{% endschema %}

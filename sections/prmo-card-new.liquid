{% comment %}
  <div class="columns-with-slider" data-section-id="{{ section.id }}">
    <div class="page-width">
      {% if section.settings.enable_slider %}
        <div class="columns-slider swiper">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div class="swiper-slide">
                <div class="column-item">
                  {% if block.settings.image != blank %}
                    <img src="{{ block.settings.image | img_url: '600x' }}" alt="{{ block.settings.heading | escape }}">
                  {% endif %}

                  {% if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank %}
                    <div class="text-content">
                      {% if block.settings.heading != blank %}
                        <h3>{{ block.settings.heading }}</h3>
                      {% endif %}
                      {% if block.settings.text != blank %}
                        <p>{{ block.settings.text }}</p>
                      {% endif %}
                      {% if block.settings.button_label != blank and block.settings.button_link != blank %}
                        <a href="{{ block.settings.button_link }}" class="cmn_btn">
                          {{ block.settings.button_label }}
                        </a>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% else %}
        <div class="columns-grid">
          {% for block in section.blocks %}
            <div class="column-item">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | img_url: '600x' }}" alt="{{ block.settings.heading | escape }}">
              {% endif %}

              {% if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank %}
                <div class="text-content">
                  {% if block.settings.heading != blank %}
                    <h3>{{ block.settings.heading }}</h3>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <p>{{ block.settings.text }}</p>
                  {% endif %}
                  {% if block.settings.button_label != blank and block.settings.button_link != blank %}
                    <a href="{{ block.settings.button_link }}" class="cmn_btn">
                      {{ block.settings.button_label }}
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>

  {% if section.settings.enable_slider %}
    <script src="{{ 'swiper-bundle.min.js' | asset_url }}"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        new Swiper('.columns-slider', {
          slidesPerView: 4,
          spaceBetween: 20,
          loop: false,
          navigation: {
            nextEl: '.swiper-button-next',
            prevEl: '.swiper-button-prev',
          },
          breakpoints: {
            768: { slidesPerView: 2 },
            1024: { slidesPerView: 3 },
            1280: { slidesPerView: 4 },
          },
        });
      });
    </script>
  {% endif %}
{% endcomment %}
<div class="columns-with-slider" data-section-id="{{ section.id }}">
  <div class="page-width">
    {% if section.settings.enable_slider %}
      <div class="columns-slider swiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide">
              {% assign card_link = block.settings.button_link %}

              {% if card_link != blank %}
                <a href="{{ card_link }}" class="column-item card-link">
              {% else %}
                <div class="column-item">
              {% endif %}

              {% if block.settings.image %}
                <img
                  src="{{ block.settings.image | image_url: width: 600, format: 'webp' }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 300, format: 'webp' }} 300w,
                    {{ block.settings.image | image_url: width: 450, format: 'webp' }} 450w,
                    {{ block.settings.image | image_url: width: 600, format: 'webp' }} 600w
                  "
                  sizes="(max-width: 768px) 50vw, (max-width: 1024px) 33vw, 600px"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  alt="{{ block.settings.heading | escape }}"
                  style="aspect-ratio: 1/1; object-fit: cover;"
                >
              {% endif %}

              {% if block.settings.heading or block.settings.text or block.settings.button_label %}
                <div class="text-content">
                  {% if block.settings.heading %}
                    <h3>{{ block.settings.heading }}</h3>
                  {% endif %}

                  {% if block.settings.text %}
                    <p>{{ block.settings.text }}</p>
                  {% endif %}

                  {% if block.settings.button_label %}
                    <span class="cmn_btn">
                      {{ block.settings.button_label }}
                    </span>
                  {% endif %}
                </div>
              {% endif %}

              {% if card_link != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>

    {% else %}
      <div class="columns-grid">
        {% for block in section.blocks %}
          {% assign card_link = block.settings.button_link %}

          {% if card_link != blank %}
            <a href="{{ card_link }}" class="column-item card-link">
          {% else %}
            <div class="column-item">
          {% endif %}

          {% if block.settings.image %}
            <img
              src="{{ block.settings.image | image_url: width: 600, format: 'webp' }}"
              alt="{{ block.settings.heading | escape }}"
              style="aspect-ratio: 1/1; object-fit: cover;"
            >
          {% endif %}

          {% if block.settings.heading or block.settings.text or block.settings.button_label %}
            <div class="text-content">
              {% if block.settings.heading %}
                <h3 class="promo-heading">{{ block.settings.heading }}</h3>
              {% endif %}

              {% if block.settings.text %}
                <p>{{ block.settings.text }}</p>
              {% endif %}

              {% if block.settings.button_label %}
                <span class="cmn_btn">
                  {{ block.settings.button_label }}
                </span>
              {% endif %}
            </div>
          {% endif %}

          {% if card_link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% if section.settings.enable_slider %}
  <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>

  <script defer>
    document.addEventListener('DOMContentLoaded', () => {
      new Swiper('.columns-slider', {
        slidesPerView: 1.2,
        spaceBetween: 16,
        lazy: true,
        preloadImages: false,

        breakpoints: {
          640: { slidesPerView: 2 },
          1024: { slidesPerView: 3 },
          1280: { slidesPerView: 4 },
        },
      });
    });
  </script>
{% endif %}

<style>
  .columns-with-slider {
      padding: 40px 0;
  }
  .columns-with-slider .columns-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
  }
  .columns-with-slider .column-item {
    text-align: center;
    overflow: hidden;
        height: auto;
      align-self: normal;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
  }

  .columns-with-slider .column-item img {
    max-width: 100%;
    display: block;
    /*min-height: 310px;*/
    object-fit: cover;
    object-position: right;
  }

  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: 0.3s ease;
  }


  /* ✅ Background only for text part */
  .columns-with-slider .text-content {
    background: #f7f7f7; /* Change this color as you want */
    padding: 20px;
    border-radius: 0;
        height: 100%;
      align-self: normal;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
  }
  .columns-with-slider .text-content .promo-heading {
      margin-bottom: 10px;
      font-size: 18px;
      font-family: KronaRegular !important;
      line-height: 1.2;
      min-height: 40px;
      font-weight: 400 !important;
      letter-spacing: normal;
  }
  .columns-with-slider .text-content p {
      margin-bottom: 10px;
      color: #000;
      min-height: 72px;
      font-size: 20px;
      /* margin-bottom: 15px; */
      font-family: BlinkerRegular;
      font-weight: 400;
      font-size: 20px;
      line-height: 1.2;
  }
  .columns-with-slider .text-content .button {
    display: inline-block;
    margin-top: 10px;
  }
  @media (max-width:767px){
    .columns-with-slider .column-item img {
        min-height: unset;
    }
   .columns-with-slider .columns-with-slider {
      padding: 20px 0;
  }
  .columns-with-slider .text-content .promo-heading {
      font-size: 17px;
      min-height: unset;
  }
  .columns-with-slider .text-content p {
      min-height: unset;
      font-size: 16px;
  }
  .columns-with-slider .columns-grid {
      gap: 0px;
  }
  .columns-with-slider .text-content {
      text-align: center;
  }
  }
</style>

{% schema %}
{
  "name": "Columns with Slider",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Enable slider view",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Columns with Slider",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

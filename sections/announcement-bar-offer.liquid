<div
  class="announcement-bar color-accent-1 gradient"
  role="region"
  aria-label="{{ 'sections.header.announcement' | t }}"
  {{ block.shopify_attributes }}
>
  {%- for block in section.blocks -%}
    <div
      class="announcement-bar__message h5"
      {% if block.settings.link != blank %}
        onclick="window.location.href='{{ block.settings.link }}';"
      {% endif %}
    >
      <p>
        <span class="icon-sec">{{ block.settings.icon }}</span>
        <span>{{ block.settings.text }} </span>
        {%- if block.settings.link != blank -%}
          <span class="link_sec">{{ block.settings.link_label }}</span>
        {%- endif -%}
        {% comment %}{% endcomment %}
      </p>
    </div>
  {%- endfor -%}
</div>
{% comment %}
  {%- case block.type -%}
    {%- when 'announcement' -%}
      <div class="announcement-bar color-{{ block.settings.color_scheme }} gradient" role="region" aria-label="{{ 'sections.header.announcement' | t }}" {{ block.shopify_attributes }}>
        {%- if block.settings.text != blank -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="announcement-bar__link link link--text focus-inset animate-arrow">
          {%- endif -%}
              <p class="announcement-bar__message h5">
                {{ block.settings.text | escape }}
                {%- if block.settings.link != blank -%}
                  {% render 'icon-arrow' %}
                {%- endif -%}
              </p>
          {%- if block.settings.link != blank -%}
            </a>
          {%- endif -%}
        {%- endif -%}
      </div>
  {%- endcase -%}
{% endcomment %}

<style>
  #shopify-section-announcement-bar-offer {
      z-index: 6;
       position: fixed;
       width: 100%;
       /* top:42px; */
  }
  @media (min-width: 768px) and (max-width: 991px){
    /* #shopify-section-announcement-bar-offer {
      top:38px;
    } */

  }
   body.cart #shopify-section-announcement-bar-offer {
      display: none;
  }
   .announcement-bar{
      margin-bottom:0px;
      display: flex;
       justify-content: center;
      padding: 5px 0;
      background:transparent;
      /* background: linear-gradient(90deg, rgba(230,46,59,1) 0%, rgba(240,128,136,1) 100%); */
  }
   .announcement-bar__message {
      text-align: center;
      line-height: 32px;
       padding: 0rem 0rem;
       margin: 0;
       letter-spacing:normal;
      font-weight: 400;
  }
   .announcement-bar .announcement-bar__message:nth-child(3) .icon-sec{
       margin: -5px 5px;
  }
   #shopify-section-announcement-bar {
      top: 0px;
  }
   .link_sec{
      background-color: black;
       border-radius: 20px;
       padding: 4px 20px;
       font-size:16px;
       line-height:19px;
       text-decoration: none;
       color: white;
       margin-left: 10px;
       font-weight: 400;
       letter-spacing: normal;
  }
   @media (min-width: 768px) and (max-width: 1023px){
       #shopify-section-announcement-bar {
          top: -1px;
      }
       .announcement-bar{
          padding: 5px 10rem;
      }
  }
   .announcement-bar svg{
      width:10px;
  }
   .announcement-bar p{
      display: flex;
       justify-content: center;
       align-items:center;
  }
   .announcement-bar .icon-sec{
      margin: -3px 5px;
  }
   @media (min-width: 1024px) and (max-width: 1279px) {
       .announcement-bar p{
          font-size:14px;
           letter-spacing:normal;
      }
  }
   @media (min-width: 768px) and (max-width: 1023px) {
       .announcement-bar p{
          font-size:14px;
           letter-spacing:normal;
      }
  }
   @media (max-width: 768px){
       #shopify-section-announcement-bar {
          top: -2px;
      }
       .announcement-bar{
          padding:0;
      }
       .announcement-bar p{
          font-size:14px;
           letter-spacing:normal;
           line-height:1.5;
      }
       .announcement-bar__message {
          padding: 1rem 0rem;
      }
  }
   @media (max-width: 350px){
       .announcement-bar p{
          font-size:8px;
           letter-spacing:normal;
           line-height:22px;
      }
  }
</style>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "Add icon code"
        },
        {
          "type": "text",
          "id": "text",
          "default": "Welcome to our store",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        },
        {
          "type": "select",
          "id": "color_scheme",
          "options": [
            {
              "value": "accent-1",
              "label": "t:sections.all.colors.accent_1.label"
            },
            {
              "value": "accent-2",
              "label": "t:sections.all.colors.accent_2.label"
            },
            {
              "value": "background-1",
              "label": "t:sections.all.colors.background_1.label"
            },
            {
              "value": "background-2",
              "label": "t:sections.all.colors.background_2.label"
            },
            {
              "value": "inverse",
              "label": "t:sections.all.colors.inverse.label"
            }
          ],
          "default": "accent-1",
          "label": "t:sections.all.colors.label"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Add Button Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement"
      }
    ]
  }
}
{% endschema %}

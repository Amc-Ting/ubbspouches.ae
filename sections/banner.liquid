<section class="banner-slider-section">
  <div class="swiper banner-slider">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide index-{{ forloop.index }}">
          {% assign banner_link = block.settings.button_link %}

          {% if banner_link != blank %}
            <a href="{{ banner_link }}" class="banner-slide banner-link">
          {% else %}
            <div class="banner-slide">
          {% endif %}

          {% if block.settings.use_video and block.settings.video != blank %}
            <div class="banner-video-wrapper desktop_video">
              {{
                block.settings.video
                | video_tag:
                  autoplay: true,
                  loop: false,
                  muted: true,
                  controls: false,
                  preload: 'none',
                  playsinline: true,
                  alt: 'banner'
              }}
            </div>

            {% if block.settings.tablet_video != blank %}
              <div class="banner-video-wrapper tablet_video">
                {{
                  block.settings.tablet_video
                  | video_tag:
                    autoplay: true,
                    loop: false,
                    muted: true,
                    controls: false,
                    preload: 'none',
                    playsinline: true,
                    alt: 'banner'
                }}
              </div>
            {% endif %}

            {% if block.settings.mobile_video != blank %}
              <div class="banner-video-wrapper mobile_video">
                {{
                  block.settings.mobile_video
                  | video_tag:
                    autoplay: true,
                    loop: false,
                    muted: true,
                    controls: false,
                    preload: 'none',
                    playsinline: true,
                    alt: 'banner'
                }}
              </div>
            {% endif %}

          {% else %}
            <picture>
              {% if block.settings.mobile_image != blank %}
                <source
                  srcset="{{ block.settings.mobile_image | image_url: width: 400, format: 'webp' }}"
                  media="(max-width: 767px)"
                >
              {% endif %}

              {% if block.settings.tablet_image != blank %}
                <source
                  srcset="{{ block.settings.tablet_image | image_url: width: 800, format: 'webp' }}"
                  media="(max-width: 1024px)"
                >
              {% endif %}

              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 1600, format: 'webp' }}"
                  alt="{{ block.settings.image_alt | escape }}"
                  loading="lazy"
                  class="banner-image"
                >
              {% endif %}
            </picture>
          {% endif %}

          <div
            class="banner-content banner-content--{{ block.settings.content_position }}"
            style="
              text-align: {{ block.settings.text_align }};
              color: {{ block.settings.text_color }};
            "
          >
            <div class="banner_content_text {% if block.settings.use_video %}no-bg{% endif %}">
              {% if block.settings.heading != blank %}
                <h2 class="banner__heading h1" style="color: {{ block.settings.text_color }}">
                  {{ block.settings.heading }}
                </h2>
              {% endif %}

              {% if block.settings.subheading != blank %}
                <p class="banner-subheading" style="color: {{ block.settings.subheading_color }};">
                  {{ block.settings.subheading }}
                </p>
              {% endif %}

              {% if block.settings.button_label != blank %}
                <span class="cmn_btn">
                  {{ block.settings.button_label }}
                </span>
              {% endif %}

              {% if block.settings.text != blank %}
                <p class="banner-text">
                  {{ block.settings.text }}
                </p>
              {% endif %}
            </div>
          </div>

          {% if banner_link != blank %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="swiper-pagination"></div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Swiper !== 'undefined') {
      new Swiper('.banner-slider', {
        loop: true,
        autoplay: false,
        autoHeight: true,
        pagination: {
          el: '.swiper-pagination',
          clickable: true,
        },
      });
    }
  });
</script>
{% schema %}
{

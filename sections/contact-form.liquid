{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
   .contact{
       display: flex;
       justify-content: space-between;
       align-items: center;
  }
   .form_section{
       width:60%;
  }
   .contact .icon_caption{
       display:flex;
       flex-direction: column;
  }
   .contact .icon{
       display: flex;
       align-items: center;
       margin-bottom: 20px;
  }
   .contact .icon img{
       padding:0 10px !important;
  }
   .contact .icon p{
       font-size: 16px;
       font-family: BlinkerRegular;
       line-height: 1.2;
       color: #000;
  }
   .contact .field:after,.contact .field:hover.field:after{
       border:none;
       box-shadow:none;
       border-bottom: 1px solid #000;
  }
   .contact .field__label,.contact .customer .field label,.contact .field__input:focus~.field__label{
       left:0 ;
       font-family: 'BlinkerRegular';
       letter-spacing: 0;
  }
   .contact__button .button{
       border-radius: 30px;
       font-family: 'BlinkerRegular';
       font-size: 18px;
       padding: 0 3rem;
      border: solid 1px black;
  }
   .contact__button .button:hover{
      background-color:white;
      color:black;
      transition: var(--transition);
  }
   .contact__button .button:after, .contact__button .button:hover:after{
       border: none;
       box-shadow: none;
  }
   .contact_info_sec .icon p a{
       text-decoration:none;
       color:#000;
  }
   .contact .field__input:focus{
       box-shadow: none;
       padding: 2.2rem 1.5rem 0.8rem 0rem;
  }
   .form-control[placeholder="Email*"]{
       display:none !important;
  }
   @media(max-width:767px){
       .contact{
           flex-direction:column;
      }
       .form_section {
           width: 100%;
      }
       .contact_info_sec{
           margin-top: 40px;
      }
  }
   .section-{
      {
           section.id
      }
  }
  -padding {
       padding-top: {
          {
               section.settings.padding_top | times: 0.75 | round: 0
          }
      }
      px;
       padding-bottom: {
          {
               section.settings.padding_bottom | times: 0.75 | round: 0
          }
      }
      px;
  }
   @media screen and (min-width: 750px) {
       .section-{
          {
               section.id
          }
      }
      -padding {
           padding-top: {
              {
                   section.settings.padding_top
              }
          }
          px;
           padding-bottom: {
              {
                   section.settings.padding_bottom
              }
          }
          px;
      }
  }
{%- endstyle -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact page-width section-{{ section.id }}-padding">
    <div class="form_section">
      {% if customer and customer.tags contains 'Approved' %}
        <div style="margin:0 auto;" class="pxFormGenerator" id="kn6HuPp7TvFyR5EpVNzVsQ"></div>
      {% else %}
        <div style="margin:0 auto 4rem;" class="pxFormGenerator" id="jFP46J-zDoTcJSLx0I_R4w"></div>
      {% endif %}
    </div>
    <div class="ppp contact_info_sec">
      {% for block in section.blocks %}
        <div class="icon">
          <img src="{{ block.settings.icon | img_url: 'master' }}" class="img-responsive">
          <p>{{ block.settings.caption }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.contact-form.settings.title.default",
      "label": "t:sections.contact-form.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Add Icon"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Add Caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}

<script async src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css">

<style>
  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
    font-family: 'KronaRegular';
    text-transform: uppercase;
  }
  .header-title {
    font-size: 24px;
    font-weight: bold;
  }
  /* .header-button {
    padding: 10px 20px;
    background: #73bd42;
    color: #fff;
    font-size: 16px;
    border: none;
    cursor: pointer;
  } */
  .tabs {
    display: flex;
    justify-content: center;
    margin-bottom: 20px;
  }
  .tab {
    /* padding: 20px 20px; */
    padding:5px;
    cursor: pointer;
    border: 1px solid #ccc;
   background: #fff;
    /* margin: 0 5px; */
    width: 20%;
    text-align: center;
    font-size: 25px;
    /* font-weight: 700; */
  }
  .tab:nth-child(1) {
    border-top-left-radius: 30px;
    border-bottom-left-radius: 30px;
  }
  .tab:nth-child(4) {
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
  }
  .tab.active:nth-child(2){
     background-color: var(--color_peach_passion);
  }
  .tab.active:nth-child(4){
     background-color:var(--color_spearmint);
  }
  .tab.active {
    background: #000;
    color: #fff;
    border-color: #000;
  }
  .product_carousel .tab-content {
    display: none;
  }
  .product_carousel .tab-content.active {
    display: block;
  }

  .main {
    position: relative;
    padding: 0 2%;
    margin-top: 6%;
    margin-bottom: 6%;
  }
  .slider-button--prev {
    position: absolute;
    top: 50%;
    left: 0;
    z-index: 1;
  }
  .slider-button--next {
    position: absolute;
    top: 50%;
    right: 0;
    z-index: 1;
  }
   @media screen and (min-width: 990px) {
    .product_carousel .slider--desktop.grid--3-col-desktop .grid__item{
     width: calc(33.33% - var(--grid-desktop-horizontal-spacing)* 2 / 3) !important;
  }
       .product_carousel  .slider--desktop .slider__slide:first-child {
        margin-left: unset ;
        scroll-margin-left: unset;
         padding-left: 15px;
    }
    
    .product_carousel .slider--desktop{
              scroll-padding-left: unset;
      padding-right: 15px;
    }
    .product_carousel .left-arrow{
      position:absolute;
      left:0;
      top:40%;
    }
    .product_carousel .right-arrow{
      position:absolute;
      right:0;
      top:40%;
    }
  }

    
  

   .card-wrapper.Bundle .quantity_variant_sec .product-form__input.radio_btn{
          background: var(--color_spearmint) !important;
   
    }
    .card-wrapper.Bundle selected.active{
          border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    }
    .bundle_product.product-form__input input[type=radio]:checked+label{
      border:none !important;
    }
    .bundle_product.product-form__input input[type=radio]:checked+label .dot,
  .card-wrapper.single_product .product-form__input input[type=radio]:checked+label .dot{
      background-color:#fff !important;
    }
    .card-wrapper.Bundle .quantity_variant_sec .product-form__input.radio_btn div:hover input[type=radio]:checked+label .dot,
  .card-wrapper.single_product .quantity_variant_sec .product-form__input.radio_btn div:hover input[type=radio]:checked+label .dot{
      background-color:#000 !important;
    }
    </style>


<div class="page-width overflow-hidden main">
  <div class="header-container">
    <h2 class="header-title">{{ section.settings.heading }}</h2>
    <a href="/collections/all" class="button">  {{ section.settings.button_text }}</a>
  </div>
  
  <div class="tabs">
    {% for block in section.blocks %}
      <div class="tab" data-tab="tab-{{ forloop.index }}">{{ block.settings.tab_title }}</div>
    {% endfor %}
  </div>
  
  {% for block in section.blocks %}
    <div class="tab-content" id="tab-{{ forloop.index }}">
      <div class="swiper-container swiper-tab-{{ forloop.index }}">
        <div class="swiper-wrapper">
          {%- for product in block.settings.collection.products limit: section.settings.products_to_show -%}
            <div class="swiper-slide grid__item">
               {% render 'card-product-new',
              card_product: product,
              media_aspect_ratio: section.settings.image_ratio,
              show_secondary_image: section.settings.show_secondary_image,
              show_vendor: section.settings.show_vendor,
              show_rating: section.settings.show_rating,
              show_quick_add: section.settings.enable_quick_add,
              section_id: section.id
            %}
            </div>
          {%- endfor -%}
        </div>
        <div class="slider-buttons no-js-hidden">
          <button type="button" class="slider-button slider-button--prev" name="previous">
            <img class="left-arrow slick-arrow" src="https://cdn.shopify.com/s/files/1/0559/7075/8753/files/left_arrow.png?v=1696511384">
          </button>
          <button type="button" class="slider-button slider-button--next" name="next">
            <img class="right-arrow slick-arrow" src="https://cdn.shopify.com/s/files/1/0559/7075/8753/files/right_arrow.png?v=1696511384">
          </button>
        </div>
      </div>
    </div>
  {% endfor %}
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    let tabs = document.querySelectorAll(".tab");
    let contents = document.querySelectorAll(".tab-content");
    
    tabs.forEach(tab => {
      tab.addEventListener("click", function() {
        let target = this.getAttribute("data-tab");
        
        tabs.forEach(t => t.classList.remove("active"));
        contents.forEach(c => c.classList.remove("active"));
        
        this.classList.add("active");
        document.getElementById(target).classList.add("active");
      });
    });
    
    if (tabs.length > 0 && contents.length > 0) {
      tabs[0].classList.add("active");
      contents[0].classList.add("active");
    }

    document.querySelectorAll('.swiper-container').forEach((slider, index) => {
      new Swiper(slider, {
        slidesPerView: 1,
        navigation: {
          nextEl: ".slider-button--next",
          prevEl: ".slider-button--prev"
        },
        spaceBetween: 45,
        breakpoints: {
          768: {
            slidesPerView: 2
          },
          1024: {
            slidesPerView: 3
          }
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Tabbed Collection Slider",
  "class": "section product_carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collections"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "View All"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab Title"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabbed Collection Slider",
      "category": "Collection",
      "blocks": [
        { "type": "tab" },
        { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}

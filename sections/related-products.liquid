{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-related-products.css' | asset_url | stylesheet_tag }}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <product-recommendations
    id="related_products_sec"
    class="related-products scroll-section page-width 22 product-recommendations"
    data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product.id }}"
  >
    {% if recommendations.performed and recommendations.products_count > 0 %}
      <h2
        class="            font_heading text_xxxl text_400 product-recommendations__heading"
        style="color: {{product.metafields.custom.product_color}}"
      >
        {{ section.settings.heading }}
      </h2>
      <h2 class="related-products__heading inline-richtext {{ section.settings.heading_size }}">
        {{ section.settings.heading1 }}
      </h2>

      {% assign skip_card_product_styles = false %}
      {% assign filtered_count = 0 %}

      {% for recommendation in recommendations.products %}
        {% if product.tags contains 'Bundle' %}
          {% unless recommendation.tags contains 'single_product'
            or recommendation.tags contains 'peach_passion_copy'
            or recommendation.tags contains 'coffee_copy'
            or recommendation.tags contains 'peppermint_copy'
            or recommendation.tags contains 'main_wholesale_product'
          %}
            {% assign filtered_count = filtered_count | plus: 1 %}
          {% endunless %}
        {% else %}
          {% if recommendation.tags contains 'single_product' %}
            {% assign filtered_count = filtered_count | plus: 1 %}
          {% endif %}
        {% endif %}
      {% endfor %}

      {% if filtered_count > 0 %}
        <ul
          id="product-grid"
          data-id="{{ section.id }}"
          class="
            pro_slider
            grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
            grid--{{ section.settings.columns_desktop }}-col-desktop
          "
        >
          {% assign skip_card_product_styles = false %}

          {% for recommendation in recommendations.products %}
            {% if product.tags contains 'Bundle' %}
              {% unless recommendation.tags contains 'single_product'
                or recommendation.tags contains 'peach_passion_copy'
                or recommendation.tags contains 'coffee_copy'
                or recommendation.tags contains 'peppermint_copy'
                or recommendation.tags contains 'main_wholesale_product'
              %}
                <li class="grid__item">
                  {% render 'card-product-new',
                    card_product: recommendation,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: section.settings.image_shape,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    skip_styles: skip_card_product_styles
                  %}
                </li>
                {% assign skip_card_product_styles = true %}
              {% endunless %}
            {% else %}
              {% if recommendation.tags contains 'single_product' %}
                <li class="grid__item single-product-item">
                  {% render 'card-product-new',
                    card_product: recommendation,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: section.settings.image_shape,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    skip_styles: skip_card_product_styles
                  %}
                </li>
                {% assign skip_card_product_styles = true %}
              {% endif %}
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
    {% endif %}
  </product-recommendations>
  {% if section.settings.image_shape == 'arch' %}
    {{ 'mask-arch.svg' | inline_asset_content }}
  {%- endif -%}
</div>


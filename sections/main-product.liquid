<script>
  document.addEventListener('DOMContentLoaded', function () {
    var readMoreTxt = ' Read more';
    var readLessTxt = ' Read less';
    var wordLimit = 25; // ← change this number

    document.querySelectorAll('.add-read-more1').forEach(function (el) {
      var fullText = el.textContent.trim();
      if (!fullText) return;

      var words = fullText.split(/\s+/); // split into words

      if (words.length <= wordLimit) {
        // Not enough words → no Read More needed
        return;
      }

      var shortText = words.slice(0, wordLimit).join(' ') + '...';

      // store values
      el.dataset.fullText = fullText;
      el.dataset.shortText = shortText;
      el.dataset.expanded = 'false';

      // initial collapsed state
      el.innerHTML =
        '<span class="desc-text">' +
        shortText +

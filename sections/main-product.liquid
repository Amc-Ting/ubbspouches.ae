  <script>
  document.addEventListener("DOMContentLoaded", function () {
    var readMoreTxt = " Read more";
    var readLessTxt = " Read less";

    document.querySelectorAll(".add-read-more").forEach(function (el) {
      var fullText = el.textContent.trim();
      if (!fullText) return;

      // find end of first sentence (. ! ? + space/end)
      var sentenceEnd = fullText.search(/[\.\!\?](\s|$)/);
      if (sentenceEnd === -1 || sentenceEnd >= fullText.length - 1) {
        // no proper sentence end → don't apply read more
        return;
      }

      var shortText = fullText.substring(0, sentenceEnd + 1);

      // store for later
      el.dataset.fullText = fullText;
      el.dataset.shortText = shortText;
      el.dataset.expanded = "false";

      // initial state: show short text + "Read more"
      el.innerHTML =
        '<span class="desc-text">' + shortText + '</span>' +
        '<span class="read-toggle" style="cursor:pointer;">' + readMoreTxt + '</span>';
    });

    // click handler (uses event delegation)
    document.addEventListener("click", function (e) {
      if (!e.target.classList.contains("read-toggle")) return;

      var wrapper = e.target.closest(".add-read-more");
      if (!wrapper) return;

      var textSpan = wrapper.querySelector(".desc-text");
      var expanded = wrapper.dataset.expanded === "true";

      if (!expanded) {
        // show full content
        textSpan.textContent = wrapper.dataset.fullText;
        e.target.textContent = " " + readLessTxt.trim(); // " Read less"
        wrapper.dataset.expanded = "true";
      } else {
        // show only first sentence
        textSpan.textContent = wrapper.dataset.shortText;
        e.target.textContent = " " + readMoreTxt.trim(); // " Read more"
        wrapper.dataset.expanded = "false";
      }
    });
  });
  </script>

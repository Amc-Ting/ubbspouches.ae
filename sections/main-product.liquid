  <script>
    if (window.innerWidth > 767) {
      document.addEventListener('DOMContentLoaded', function () {
        const stickyATC = document.getElementById('StickyATC');
        const sentinel = document.getElementById('product_sec');

        if (!stickyATC || !sentinel) return;

        let lastScrollTop = window.pageYOffset || document.documentElement.scrollTop;
        let isSentinelVisible = false;

        // Observe product section visibility
        const observer = new IntersectionObserver(
          function (entries) {
            entries.forEach((entry) => {
              isSentinelVisible = entry.isIntersecting;

              // If product section is visible, always hide sticky
              if (isSentinelVisible) {
                stickyATC.classList.remove('active');
              }
            });
          },
          {
            threshold: 0,
          }
        );

        observer.observe(sentinel);

        // Detect scroll direction
        window.addEventListener('scroll', function () {
          const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

          if (isSentinelVisible) {
            // If Add to basket section is visible, keep sticky hidden
            stickyATC.classList.remove('active');
          } else {
            if (scrollTop > lastScrollTop) {
              // Scrolling down → show sticky
              stickyATC.classList.add('active');
            } else {
              // Scrolling up → hide sticky
              stickyATC.classList.remove('active');
            }
          }

          lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
        });
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      const stickyRadios = document.querySelectorAll('.sticky-atc__variant-radio');
      const stickyVariantInput = document.getElementById('StickyVariantId');
      const mainForm = document.getElementById('{{ product_form_id }}');

      if (!stickyRadios.length || !stickyVariantInput || !mainForm) return;

      const mainVariantInput = mainForm.querySelector('input[name="id"], select[name="id"]');

      // Sticky radio -> hidden input + main form
      stickyRadios.forEach((radio) => {
        radio.addEventListener('change', function () {
          if (!this.checked) return;

          stickyVariantInput.value = this.value;

          if (mainVariantInput) {
            mainVariantInput.value = this.value;
            mainVariantInput.dispatchEvent(new Event('change', { bubbles: true }));
          }
          const selectedVariantId = this.value;
          // Find the matching radio in the main fieldset by data-variant-id
          const matchingInput = document.querySelector(
            `.product__info-wrapper input[data-variant-id="${selectedVariantId}"]`
          );

          if (matchingInput) {
            matchingInput.checked = true;
            matchingInput.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      });

      // Main form -> sticky radios sync
      if (mainVariantInput) {
        mainVariantInput.addEventListener('change', function () {
          stickyVariantInput.value = this.value;

          stickyRadios.forEach((radio) => {
            radio.checked = radio.value === this.value;
          });
        });
      }
    });

    if (window.innerWidth <= 767) {
      document.addEventListener('DOMContentLoaded', function () {
        const stickyATC = document.getElementById('StickyATC');
        const originalATC = document.querySelector('.main_atc_btn');
        // change selector if your original add to cart wrapper is different

        if (!stickyATC || !originalATC) return;

        const observer = new IntersectionObserver(
          function (entries) {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                // Original Add to Cart is visible → hide sticky ATC
                stickyATC.classList.remove('active');
              } else {
                // Original Add to Cart is NOT visible → show sticky ATC
                stickyATC.classList.add('active');
              }
            });
          },
          {
            root: null,
            threshold: 0.1, // even small visibility hides sticky
          }
        );

        observer.observe(originalATC);
      });
    }
  </script>

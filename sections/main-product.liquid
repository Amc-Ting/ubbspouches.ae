<product-info
  id="MainProduct-{{ section.id }}"
  class="page-width section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-rte.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {%- style -%}
                            .product_titles {
                                  font-size: 18px;
                                  font-weight: 500;
                                  font-family: 'KronaRegular';
                                  margin: 0;
                                  line-height: normal;
                                  color:#000;
                                  padding-bottom: 10px;
                                  text-transform: uppercase;
                            }

                            .flavour-content {
      max-height: 0;

      opacity: 0;
      transition:
        max-height 0.4s ease,
        opacity 0.3s ease;
        visibility:hidden;

    }

                .flavour-content p{
                  font-size:14px;
                  margin-bottom: 5px;
                }

                .flavour-header {
                  display: flex;
                  align-items: center;

                  cursor: pointer;
                }

                .flavour-header h3{
                  font-size:16px;
                }
                @media(max-width:767px){
                  .flavour-header h3{
                  font-size:12px;
                }
                }

                .flavour-toggle {
                  font-size: 18px;
                  transition: transform 0.3s ease;
                  cursor: pointer;
                }
                .flavour-card.active .flavour-content {
                  max-height: 500px; /* large enough value */
                  opacity: 1;
                  visibility:visible;
                  margin-bottom: 15px;
                  margin-left: 20px;
                }

                .flavour-card.active .flavour-toggle {
                  transform: rotate(180deg);
                }


                .flavour_title h3{
                  font-family: 'BlinkerRegular' !important;
                  text-transform: capitalize;
                  color: #7f7f7f;
                  margin: 20px 0;
                }

                            .flavour-grid{
                              display:grid;
                              grid-template-columns:1fr 1fr;
                            }

                            @media(min-width:768px) and (max-width:1024px){
                              .flavour-grid{
                              display:block;

                            }
                            }

                            .flavour-card img{
                              width:60px;
                              border:none;
                            }




                    a.flavour-btn{
                      color:white;
                      text-decoration:none;
                      border-radius:20px;
                      background-color:#000;
                      padding:5px 15px;
                      font-size:14px;
                    }

                    a.flavour-btn:hover{
                      color:white;
                    }

                    .flavour-header h3 {
          margin: 0;
          flex: 1;
        }

            .flavour-card .arrow-drop{
                      width:24px;
                      border:none;
                    }
                              .product-title {
                                  font-size: 26px;
                                  font-weight: 500;
                                  font-family: 'KronaRegular';
                                  margin: 0;
                                  line-height: normal;
                                  color:#000;
                                  text-transform: uppercase;
                            }
                              .desc_split_text {
                                  font-weight: 900;
                                  padding-bottom: 8px;
                                  padding-top: 6px;
                                  text-transform: capitalize;

                            }
                              .product__info-wrapper .product-form__input .form__label {
                                  margin-bottom: 25px;
                                  font-size: 14px;
                                  font-family: BlinkerRegular !important;
                                  color: #a3a3a3;
                                  color: #000;
                                  letter-spacing: 0;
                                  font-size: 16px;
                                  margin-right: 15px;
                            }
                            .product__info-wrapper span.read-less {
                              display: none;
                            }
                            .product__info-wrapper span.read-more {
                              display: none;
                            }
                              .product__description.rte.font_text.font_black {
                                  margin-top: 0;
                            }
                              .product__info-wrapper .product-form__input.product-form__quantity {
                                  gap: 10px !important;
                            }
                              .product__info-wrapper .qunatity_cart_section {
                                  margin-top: 38px;
                            }
                              .product__info-wrapper quantity-input.quantity {
                                  margin: 0 !important;
                                  margin-bottom: 0px !important;
                                  margin-left: 17px !important;
                            }
                              .product__info-wrapper .product-form__input .form__label {
                                  margin-bottom: 5px;
                                  margin-top: 5px;
                            }
                              .product__info-wrapper .product-form__input.product-form__quantity {
                                  display: flex;
                                  align-items: center;
                                  max-width: 230px !important;
                                  flex: unset !important;
                                  width: 100% !important;
                                  gap: 0 !important;
                            }
                              .product__info-wrapper .quantity__input {
                                  width: 25px;
                                  color: #000;
                            }
                              .product__info-wrapper quantity-input.quantity {
                                  margin: 0 !important;
                                  margin-bottom: 0px !important;
                                  margin-left: 17px !important;
                            }
                              .product__info-wrapper .quantity__button {
                                  height: 25px;
                                  width: 25px;
                                  border: 1px solid #000;
                                  opacity: 1 !important;
                                  border-radius: 50px;
                            }
                              .quick-buy-wrapper {
                                  display: flex;
                                  gap: 10px;
                                  overflow-x: auto;
                                  -webkit-overflow-scrolling: touch;
                                  padding-bottom: 10px;
                                  cursor: pointer;
                            }
                              .quick-buy-wrapper::-webkit-scrollbar {
                                  height: 6px;
                            }
                              .quick-buy-wrapper::-webkit-scrollbar-thumb {
                                  background-color: #ccc;
                                  border-radius: 3px;
                            }
                            .card__badge.top.new_design_badge {
                                margin-bottom: 10px;
                            }
                              .section-{
                                {
                                      section.id
                                }
                            }
                            -padding {
                                  padding-top: {
                                    {
                                          section.settings.padding_top | times: 0.75 | round: 0
                                    }
                                }
                                px;
                                  padding-bottom: {
                                    {
                                          section.settings.padding_bottom | times: 0.75 | round: 0
                                    }
                                }
                                px;
                            }
                              .quick-buy-box {
                                  background: #ffffff;
                                  border-radius: 8px;
                                /* padding: 20px;
                                  */
                            }
                              .qb-title {
                                  font-size: 18px;
                                  font-weight: 700;
                                  padding:10px 0;
                            }
                              .qb-options {
                                  display: flex;
                                  gap: 10px;
                                  overflow-x: auto;
                                  padding-bottom: 5px;
                            }
                              .qb-item {
                                  flex: 0 0 auto;
                            }

                        .qb-box {
                            border: 2px solid;
                            /* padding: 12px 15px; */
                            border-radius: 18px;
                            overflow: hidden;
                            text-align: center;
                            min-width: 140px;
                            cursor: pointer;
                            transition: 0.2s ease;
                            border-color: {{product.metafields.custom.product_color}} !important;
                          }
                              .qb-box:hover {
                                  border-color: #000;
                            }
                              .qb-pack {
                                  font-size: 18px;
                                  font-weight: 600;
                                  margin-bottom: 5px;
                                  background: {{product.metafields.custom.product_color}} !important;
                                  margin-top: 6px;
                                  color: #000;
                            }
                              .qb-price {
                                  font-size: 16px;
                                }
                                .PDP-price{
                                  display: flex;
                                  flex-direction: column;
                                }
                                .qb-discounted-price {
                                  font-family: KronaRegular !important;
                                  font-weight: bold;
                                  color: #000;
                                  background-color: {{product.metafields.custom.product_color}}22 !important;
                                  width: 40px;
                                  margin: 10px auto;
                                  height: 40px;
                                  line-height: 40px;
                                  border-radius: 50px;
                            }
                              .qb-unit {
                                  display: block;
                                  font-size: 18px;
                                  color: #000;
                            }
                              .box_d {
                                  display: flex;
                            }
                            /* Style the + / - icon */
                              .accordion-toggle-icon {
                                  font-size: 22px;
                                  font-weight: 700;
                                  margin-left: auto;
                                  transition: 0.2s ease-in-out;
                                  display: inline-block;
                            }
                            /* Change icon position inside summary */
                              summary {
                                  display: flex;
                                  align-items: center;
                                  justify-content: space-between;
                                  cursor: pointer;
                            }
                            /* Remove triangle default browser icon */
                              summary::-webkit-details-marker {
                                  display: none;
                            }
                              .xmas-offer{
                                background: linear-gradient(90deg, rgba(230, 46, 59, 1) 0%, rgba(240, 128, 136, 1) 100%);
                                border-radius: 20px;
                                  color: #fff;
                                  line-height: 26px;
                                  text-align: center;
                            }

                              @media screen and (min-width: 750px) {
                                  .section-{
                                    {
                                          section.id
                                    }
                                }
                                -padding {
                                      padding-top: {
                                        {
                                              section.settings.padding_top
                                        }
                                    }
                                    px;
                                      padding-bottom: {
                                        {
                                              section.settings.padding_bottom
                                        }
                                    }
                                    px;
                                }
                            }
                              .price-review_section{
                                  align-items:end;
                            }
                            .product .price-review_section {

                              align-items:unset;
                            }
                              .offer_sec{
                                  display:none;
                            }
                              .d_f{
                                  display:flex;
                                  gap:10px;
                                  align-items: end;
                            }
                              /* button.read-more-btn {
                                  position: absolute;
                                  top: 73%;
                                  right: 44%;
                                  border: none;
                                  background: transparent;
                                  font-size: 17px;
                                  color: #00000082;
                                  border-bottom: 1px solid;
                            }
                        .product-menthol button.read-more-btn {
                            position: absolute;
                            top: 73%;
                            right: 47%;
                            border: none;
                            background: transparent;
                            font-size: 17px;
                            color: #00000082;
                            border-bottom: 1px solid;
                        } */
                              .product__description.rte.font_text.font_black {
                                  position: relative !important;
                            }
                              .card__badge.top.new_design_badge {
                                  z-index: 0;
                            }
                              .main_product .new_badge, .main_product .new_design_badge {
                                      top: -36px !important;
                                      left: 3px !important;
                                }


                              @media (max-width:767px){
                                  .qb-title {
                                      font-size: 14px;
                                              padding-bottom: 0;
                                }
                                  .qb-pack {
                                      font-size: 15px;
                                }
                                  .qb-price {
                                      font-size: 20px;
                                }
                                  .qb-unit {
                                      font-size: 15px;
                                }
                                  .quick-buy-box {
                                      padding: 5px;
                                }
                                .product-title{
                                  font-size:25px;
                                }
                                .product__info-wrapper .qunatity_cart_section {
                                  margin-top: 0px;
                                }

                              .qb-old-price{
                                font-size: 16px;
                              }
                              .qb-discounted-price{
                                font-size: 16px;
                              }
                            }
                            @media(max-width: 375px){
                              .product__info-wrapper quantity-input.quantity {
                                margin: 0 !important;
                            }
                            }
  {%- endstyle -%}

  <style>
          .main_product .new_badge,.main_product .new_design_badge{
              top: -36px !important;
              left: 50px !important;
              position: unset !important;
        }
          @media (max-width:1024px){
              button.read-more-btn {
                  top: 74%;
                  right: 36%;
            }
        }
          @media(max-width:768px){
              button.read-more-btn {
                  top: 78%;
                  right: 44%;
                  font-size: 14px;
            }
              .truncated {
                  font-size: 16px;
            }
        }
          @media(max-width:767px){
              .main_product .new_badge,.main_product .new_design_badge{
                  left: 0;
            }
            .flavour-grid{
              grid-template-columns: 1fr;
            }
            .flavour-card img{
              width: 50px;
            }
        }
          .product__info-wrapper.grid__item {
              position: relative;
        }
          @media (max-width:480px){
              button.read-more-btn {
                  top: 65%;
                  right: 26%;
            }

              .d_f {
                  align-items: center;
            }
              .product__info-container .product-form__input .form__label {
                  margin-bottom: 10px !important;
            }
        }
          @media (max-width:375px){
              button.read-more-btn {
                  top: 75%;
                  right: 5%;
            }
              button.read-more-btn {
                  margin-top: 30px !important;
            }
        }

        @media (min-width: 1024px) and (max-width: 1279px) {
          .product__info-wrapper.grid__item{
            padding:0;
          }
          .d_f{
            align-items: center;
          }
          .price__container span.price-item.price-item--regular{
        font-size: 28px;
      }
        }

        @media (min-width: 768px) and (max-width: 1023px) {
          .product__info-wrapper.grid__item{
            padding:0;
          }
          .d_f {
              display: flex;
              gap: 0;
              align-items: flex-start;
              flex-direction: column;
              margin-bottom: 8px;
          }
          .price-review_section {
            display: flex;
            justify-content: space-between;
        }
        .price_review_sec {
        width: 90%;
    }
    .price__container span.price-item.price-item--regular{
      font-size: 28px;
    }
        }
  </style>

  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  <div
    id="product_sec"
    class="product-part product product--{{ section.settings.media_size }} product--{{ section.settings.gallery_layout }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}"
  >
    <div class="grid__item product__media-wrapper">
      {% if product.tags contains 'new_design' %}
        <div class="card__badge top new_design_badge medium-hide large-up-hide">
          <span
            style="
              font-family: 'KronaRegular';
                  text-transform: uppercase;
                  border-radius: 0;
                  clip-path: unset;
              padding-right: 40px;    clip-path: polygon(0 0, 100% 0, 90% 50%, 80% 100%, 0 100%);  text-transform: capitalize; display:block; background-color:{{ product.metafields.custom.product_color }} !important; border-color:{{ product.metafields.custom.product_color }} !important;
            "
            class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}"
            >New Design
            <span
              style="margin-top: 5px !important;display:block;font-size:6px;padding: 0px 4px;line-height:inherit;text-align:left; "
              class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}"
            >
              Same Great Flavour</span
            ></span
          >
        </div>
      {% endif %}

      {%- assign product_form_id = 'product-form-' | append: section.id -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            {% comment %}
              <div class="product__title" {{ block.shopify_attributes }}>
                <h1 class="text_400 font_heading font_black text_lg">
                  {% if product.tags contains 'main_wholesale_product' %}
                    {{ product.metafields.custom.wholesale_product_title.value }}
                  {% elsif product.tags contains 'Bundle' %}
                    {{ product.metafields.custom.card_product_title.value }}
                  {% else %}
                    {{ product.title | escape }}
                  {% endif %}
                </h1>

                <a href="{{ product.url }}" class="product__title quick-add-hidden">
                  <h2 class="h1">
                    {{ product.title | escape }}
                  </h2>
                </a>

                <div
                  class="wc_product_review_badge"
                  data-handle="{{ product.handle }}"
                  data-product_id="{{ product.id }}"
                ></div>
              </div>
            {% endcomment %}

            <div class="product_titles medium-hide large-up-hide">
              {% if product.tags contains 'main_wholesale_product' %}
                <div class="product-title">
                  {{ product.metafields.custom.wholesale_product_title.value }}
                </div>
              {% else %}
                <div class="product-title">
                  {{ product.title | escape }}
                </div>
              {% endif %}
            </div>
            {% unless product.tags contains 'wholesale_product' %}
              {% if product.metafields.custom.product_title %}
                <div class="product-title medium-hide large-up-hide">
                  {{ product.metafields.custom.product_title }}
                </div>
              {% endif %}
            {% endunless %}

          {%- when 'price' -%}
            <div
              class="no-js-hidden price-review_section medium-hide large-up-hide"
              id="price-{{ section.id }}"
              role="status"
              {{ block.shopify_attributes }}
            >
              <div class="d_f price_review_sec">
                {%- render 'price',
                  product: product,
                  use_variant: true,
                  show_badges: true,
                  price_class: 'price--large'
                -%}
                {% unless product.tags contains 'Bundle' %}
                  {% comment %}
                    <div class="multibuy_title_text">
                      From <b>£2.00</b> with <a href="javascript:void(0)" class="Click-here underlined-link">Multibuy</a>.
                    </div>
                  {% endcomment %}
                {% endunless %}
              </div>
              {% comment %}
                {% render 'judgeme_widgets',
                  widget_type: 'judgeme_preview_badge',
                  jm_style: '',
                  concierge_install: false,
                  product: product
                %}
              {% endcomment %}
            </div>
        {%- endcase -%}
      {% endfor %}

      <media-gallery
        id="MediaGallery-{{ section.id }}"
        role="region"
        {% if section.settings.enable_sticky_info %}
          class="product__media-gallery"
        {% endif %}
        aria-label="{{ 'products.product.media.gallery_viewer' | t }}"
        data-desktop-layout="{{ section.settings.gallery_layout }}"
      >
        <div id="GalleryStatus-{{ section.id }}" class="visually-hidden" role="status"></div>
        <slider-component
          id="GalleryViewer-{{ section.id }}"
          class="slider-mobile-gutter main-gallery-img desktop_view"
        >
          {% comment %}
            <div class="new_badge_sec">
              <p>
                {% if product.tags contains 'New' %}New{% endif %}
              </p>
            </div>
          {% endcomment %}
          <a class="skip-to-content-link button visually-hidden quick-add-hidden" href="#ProductInfo-{{ section.id }}">
            {{ 'accessibility.skip_to_product_info' | t }}
          </a>
          <ul
            id="Slider-Gallery-{{ section.id }}"
            class="product__media-list contains-media grid grid--peek list-unstyled slider slider--mobile"
            role="list"
          >
            {%- liquid
              assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src'
              assign media_count = product.media.size
              if section.settings.hide_variants
                assign media_count = media_count | minus: variant_images.size | plus: 1
              endif

              if section.settings.media_size == 'large'
                assign media_width = 0.65
              elsif section.settings.media_size == 'medium'
                assign media_width = 0.55
              elsif section.settings.media_size == 'small'
                assign media_width = 0.45
              endif
            -%}
            {%- if product.selected_or_first_available_variant.featured_media != null -%}
              {%- assign featured_media = product.selected_or_first_available_variant.featured_media -%}
              <li
                id="Slide-{{ section.id }}-{{ featured_media.id }}"
                data-img="{{ featured_media.alt }}"
                class="product__media-item grid__item slider__slide is-active{% if featured_media.media_type != 'image' %} product__media-item--full{% endif %}{% if section.settings.hide_variants and variant_images contains featured_media.src %} product__media-item--variant{% endif %}"
                data-media-id="{{ section.id }}-{{ featured_media.id }}"
              >
                {%- assign media_position = 1 -%}
                {% render 'product-thumbnail',
                  media: featured_media,
                  position: media_position,
                  loop: section.settings.enable_video_looping,
                  modal_id: section.id,
                  xr_button: true,
                  media_width: media_width,
                  lazy_load: false
                %}
              </li>
            {%- endif -%}
            {%- for media in product.media -%}
              {%- unless media.id == product.selected_or_first_available_variant.featured_media.id -%}
                <li
                  id="Slide-{{ section.id }}-{{ media.id }}"
                  data-img="{{ media.alt }}"
                  class="product__media-item grid__item slider__slide{% if product.selected_or_first_available_variant.featured_media == null and forloop.index == 1 %} is-active{% endif %}{% if media.media_type != 'image' %} product__media-item--full{% endif %}{% if section.settings.hide_variants and variant_images contains media.src %} product__media-item--variant{% endif %}"
                  data-media-id="{{ section.id }}-{{ media.id }}"
                >
                  {%- assign media_position = media_position | default: 0 | plus: 1 -%}
                  {% render 'product-thumbnail',
                    media: media,
                    position: media_position,
                    loop: section.settings.enable_video_looping,
                    modal_id: section.id,
                    xr_button: true,
                    media_width: media_width,
                    lazy_load: true
                  %}
                </li>
              {%- endunless -%}
            {%- endfor -%}
          </ul>
          <div class="slider-buttons no-js-hidden quick-add-hidden{% if media_count < 2 or section.settings.mobile_thumbnails == 'show' %} small-hide{% endif %}">
            <button
              type="button"
              class="slider-button slider-button--prev"
              name="previous"
              aria-label="{{ 'general.slider.previous_slide' | t }}"
            >
              {% render 'icon-caret' %}
            </button>
            <div class="slider-counter caption">
              <span class="slider-counter--current">1</span>
              <span aria-hidden="true"> / </span>
              <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
              <span class="slider-counter--total">{{ media_count }}</span>
            </div>
            <button
              type="button"
              class="slider-button slider-button--next"
              name="next"
              aria-label="{{ 'general.slider.next_slide' | t }}"
            >
              {% render 'icon-caret' %}
            </button>
          </div>
        </slider-component>
        {%- if first_3d_model -%}
          <button
            class="button button--full-width product__xr-button"
            type="button"
            aria-label="{{ 'products.product.xr_button_label' | t }}"
            data-shopify-xr
            data-shopify-model3d-id="{{ first_3d_model.id }}"
            data-shopify-title="{{ product.title | escape }}"
            data-shopify-xr-hidden
          >
            {% render 'icon-3d-model' %}
            {{ 'products.product.xr_button' | t }}
          </button>
        {%- endif -%}
        {%- if media_count > 1
          and section.settings.gallery_layout != 'stacked'
          or section.settings.mobile_thumbnails == 'show'
        -%}
          <slider-component
            id="GalleryThumbnails-{{ section.id }}"
            class="thumbnail-slider slider-mobile-gutter quick-add-hidden{% if section.settings.mobile_thumbnails == 'hide' %} small-hide{% endif %}{% if media_count <= 3 %} thumbnail-slider--no-slide{% endif %}"
          >
            <button
              type="button"
              class="slider-button slider-button--prev{% if media_count <= 3 %} small-hide{% endif %}{% if media_count <= 4 %} medium-hide large-up-hide{% endif %}"
              name="previous"
              aria-label="{{ 'general.slider.previous_slide' | t }}"
              aria-controls="GalleryThumbnails-{{ section.id }}"
              data-step="3"
            >
              {% render 'icon-caret' %}
            </button>
            <ul
              id="Slider-Thumbnails-{{ section.id }}"
              class="thumbnail-list list-unstyled slider slider--mobile{% if section.settings.gallery_layout == 'thumbnail_slider' %} slider--tablet-up{% endif %}"
            >
              {%- if featured_media != null -%}
                {%- liquid
                  capture media_index
                    if featured_media.media_type == 'model'
                      increment model_index
                    elsif featured_media.media_type == 'video' or featured_media.media_type == 'external_video'
                      increment video_index
                    elsif featured_media.media_type == 'image'
                      increment image_index
                    endif
                  endcapture
                  assign media_index = media_index | plus: 1
                -%}
                <li
                  id="Slide-Thumbnails-{{ section.id }}-0"
                  class="thumbnail-list__item slider__slide{% if section.settings.hide_variants and variant_images contains featured_media.src %} thumbnail-list_item--variant{% endif %}"
                  data-variant="{{ featured_media.alt }}"
                  data-target="{{ section.id }}-{{ featured_media.id }}"
                  data-media-position="{{ media_index }}"
                >
                  <button
                    class="thumbnail global-media-settings global-media-settings--no-shadow {% if featured_media.preview_image.aspect_ratio > 1 %}thumbnail--wide{% else %}thumbnail--narrow{% endif %}"
                    aria-label="{%- if featured_media.media_type == 'image' -%}{{ 'products.product.media.load_image' | t: index: media_index }}{%- elsif featured_media.media_type == 'model' -%}{{ 'products.product.media.load_model' | t: index: media_index }}{%- elsif featured_media.media_type == 'video' or featured_media.media_type == 'external_video' -%}{{ 'products.product.media.load_video' | t: index: media_index }}{%- endif -%}"
                    aria-current="true"

                    aria-controls="GalleryViewer-{{ section.id }}"
                    aria-describedby="Thumbnail-{{ section.id }}-0"
                  >
                    <img
                      id="Thumbnail-{{ section.id }}-0"
                      srcset="
                        {% if featured_media.preview_image.width >= 54 %}{{ featured_media.preview_image | image_url: width: 54 }} 54w,{% endif %}
                        {% if featured_media.preview_image.width >= 74 %}{{ featured_media.preview_image | image_url: width: 74 }} 74w,{% endif %}
                        {% if featured_media.preview_image.width >= 104 %}{{ featured_media.preview_image | image_url: width: 104 }} 104w,{% endif %}
                        {% if featured_media.preview_image.width >= 162 %}{{ featured_media.preview_image | image_url: width: 162 }} 162w,{% endif %}
                        {% if featured_media.preview_image.width >= 208 %}{{ featured_media.preview_image | image_url: width: 208 }} 208w,{% endif %}
                        {% if featured_media.preview_image.width >= 324 %}{{ featured_media.preview_image | image_url: width: 324 }} 324w,{% endif %}
                        {% if featured_media.preview_image.width >= 416 %}{{ featured_media.preview_image | image_url: width: 416 }} 416w,{% endif %},
                        {{ featured_media.preview_image | image_url }} {{ media.preview_image.width }}w
                      "
                      src="{{ featured_media | image_url: width: 416 }}"
                      sizes="(min-width: {{ settings.page_width }}px) calc(({{ settings.page_width | minus: 100 | times: media_width | round }} - 4rem) / 4), (min-width: 990px) calc(({{ media_width | times: 100 }}vw - 4rem) / 4), (min-width: 750px) calc((100vw - 15rem) / 8), calc((100vw - 14rem) / 3)"
                      alt="{{ featured_media.alt | escape }}"
                      height="208"
                      width="208"
                      loading="lazy"
                    >
                  </button>
                </li>
              {%- endif -%}
              {%- for media in product.media -%}
                {%- unless media.id == product.selected_or_first_available_variant.featured_media.id -%}
                  {%- liquid
                    capture media_index
                      if media.media_type == 'model'
                        increment model_index
                      elsif media.media_type == 'video' or media.media_type == 'external_video'
                        increment video_index
                      elsif media.media_type == 'image'
                        increment image_index
                      endif
                    endcapture
                    assign media_index = media_index | plus: 1
                  -%}
                  <li
                    id="Slide-Thumbnails-{{ section.id }}-{{ forloop.index }}"
                    class="thumbnail-list__item slider__slide{% if section.settings.hide_variants and variant_images contains media.src %} thumbnail-list_item--variant{% endif %}"
                    data-variant="{{ media.alt }}"
                    data-target="{{ section.id }}-{{ media.id }}"
                    data-media-position="{{ media_index }}"
                  >
                    {%- if media.media_type == 'model' -%}
                      <span class="thumbnail__badge" aria-hidden="true">
                        {%- render 'icon-3d-model' -%}
                      </span>
                    {%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}
                      <span class="thumbnail__badge" aria-hidden="true">
                        {%- render 'icon-play' -%}
                      </span>
                    {%- endif -%}
                    <button
                      class="thumbnail global-media-settings global-media-settings--no-shadow {% if media.preview_image.aspect_ratio > 1 %}thumbnail--wide{% else %}thumbnail--narrow{% endif %}"
                      aria-label="{%- if media.media_type == 'image' -%}{{ 'products.product.media.load_image' | t: index: media_index }}{%- elsif media.media_type == 'model' -%}{{ 'products.product.media.load_model' | t: index: media_index }}{%- elsif media.media_type == 'video' or media.media_type == 'external_video' -%}{{ 'products.product.media.load_video' | t: index: media_index }}{%- endif -%}"
                      {% if media == product.selected_or_first_available_variant.featured_media
                        or product.selected_or_first_available_variant.featured_media == null
                        and forloop.index == 1
                      %}
                        aria-current="true"
                      {% endif %}
                      aria-controls="GalleryViewer-{{ section.id }}"
                      aria-describedby="Thumbnail-{{ section.id }}-{{ forloop.index }}"
                    >
                      <img
                        id="Thumbnail-{{ section.id }}-{{ forloop.index }}"
                        srcset="
                          {% if media.preview_image.width >= 59 %}{{ media.preview_image | image_url: width: 59 }} 59x,{% endif %}
                          {% if media.preview_image.width >= 118 %}{{ media.preview_image | image_url: width: 118 }} 118w,{% endif %}
                          {% if media.preview_image.width >= 84 %}{{ media.preview_image | image_url: width: 84 }} 84w,{% endif %}
                          {% if media.preview_image.width >= 168 %}{{ media.preview_image | image_url: width: 168 }} 168w,{% endif %}
                          {% if media.preview_image.width >= 130 %}{{ media.preview_image | image_url: width: 130 }} 130w,{% endif %}
                          {% if media.preview_image.width >= 260 %}{{ media.preview_image | image_url: width: 260 }} 260w{% endif %}
                        "
                        src="{{ media | image_url: width: 84, height: 84 }}"
                        sizes="(min-width: 1200px) calc((1200px - 19.5rem) / 12), (min-width: 750px) calc((100vw - 16.5rem) / 8), calc((100vw - 8rem) / 5)"
                        alt="{{ media.alt | escape }}"
                        height="200"
                        width="200"
                        loading="lazy"
                      >
                    </button>
                  </li>
                {%- endunless -%}
              {%- endfor -%}
            </ul>
            <button
              type="button"
              class="slider-button slider-button--next{% if media_count <= 3 %} small-hide{% endif %}{% if media_count <= 4 %} medium-hide large-up-hide{% endif %}"
              name="next"
              aria-label="{{ 'general.slider.next_slide' | t }}"
              aria-controls="GalleryThumbnails-{{ section.id }}"
              data-step="3"
            >
              {% render 'icon-caret' %}
            </button>
          </slider-component>
        {%- endif -%}
      </media-gallery>
    </div>
    <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}">
      <div
        id="ProductInfo-{{ section.id }}"
        class="product__info-container{% if section.settings.enable_sticky_info %} product__info-container--sticky{% endif %}"
      >
        {% if product.tags contains 'new_design' %}
          <div class="card__badge top new_design_badge small-hide">
            <span
              style="
                font-family: 'KronaRegular';
                    text-transform: uppercase;
                    border-radius: 0;
                    clip-path: unset;
                padding-right: 40px;    clip-path: polygon(0 0, 100% 0, 90% 50%, 80% 100%, 0 100%);  text-transform: capitalize; display:block; background-color:{{ product.metafields.custom.product_color }} !important; border-color:{{ product.metafields.custom.product_color }} !important;
              "
              class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}"
              >New Design
              <span
                style="margin-top: 5px !important;display:block;font-size:6px;padding: 0px 4px;line-height:inherit;text-align:left; "
                class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}"
              >
                Same Great Flavour</span
              ></span
            >
          </div>
        {% endif %}

        {%- assign product_form_id = 'product-form-' | append: section.id -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'text' -%}
              <p
                class="product__text quick-add-hidden font_heading font_black{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.text -}}
              </p>

            {%- when 'title' -%}
              {% comment %}
                <div class="product__title" {{ block.shopify_attributes }}>
                  <h1 class="text_400 font_heading font_black text_lg">
                    {% if product.tags contains 'main_wholesale_product' %}
                      {{ product.metafields.custom.wholesale_product_title.value }}
                    {% elsif product.tags contains 'Bundle' %}
                      {{ product.metafields.custom.card_product_title.value }}
                    {% else %}
                      {{ product.title | escape }}
                    {% endif %}
                  </h1>

                  <a href="{{ product.url }}" class="product__title quick-add-hidden">
                    <h2 class="h1">
                      {{ product.title | escape }}
                    </h2>
                  </a>

                  <div
                    class="wc_product_review_badge"
                    data-handle="{{ product.handle }}"
                    data-product_id="{{ product.id }}"
                  ></div>
                </div>
              {% endcomment %}

              <div class="product_titles small-hide">
                {% if product.tags contains 'main_wholesale_product' %}
                  <div class="product-title small-hide">
                    {{ product.metafields.custom.wholesale_product_title.value }}
                  </div>
                {% else %}
                  <div class="product-title small-hide">
                    {{ product.title | escape }}
                  </div>
                {% endif %}
              </div>

              {% unless product.tags contains 'wholesale_product' %}
                {% if product.metafields.custom.product_title %}
                  <div class="product-title small-hide">
                    {{ product.metafields.custom.product_title }}
                  </div>
                {% endif %}
              {% endunless %}

            {%- when 'price' -%}
              <div
                class="no-js-hidden price-review_section small-hide"
                id="price-{{ section.id }}"
                role="status"
                {{ block.shopify_attributes }}
              >
                <div class="d_f price_review_sec ">
                  {%- render 'price',
                    product: product,
                    use_variant: true,
                    show_badges: true,
                    price_class: 'price--large'
                  -%}
                  {% unless product.tags contains 'Bundle' %}
                    {% comment %}
                      <div class="multibuy_title_text">
                        From <b>£2.00</b> with
                        <a href="javascript:void(0)" class="Click-here underlined-link">Multibuy</a>.
                      </div>
                    {% endcomment %}
                  {% endunless %}
                </div>

                {% render 'judgeme_widgets',
                  widget_type: 'judgeme_preview_badge',
                  jm_style: '',
                  concierge_install: false,
                  product: product
                %}

                {% comment %}
                  {% assign all_skus = '' %}

                  {% for variant in product.variants %}
                    {% if variant.sku != blank %}
                      {% assign all_skus = all_skus | append: variant.sku | append: ',' %}
                    {% endif %}
                  {% endfor %}

                  {% assign all_skus = all_skus | remove_last: ',' %}
                  {% unless product.tags contains 'wholesale_product' %}
                    <!-- TrustBox widget - Product Mini MultiSource -->
                    <div
                      class="trustpilot-widget"
                      data-locale="en-US"
                      data-template-id="577258fb31f02306e4e3aaf9"
                      data-businessunit-id="635414ed2d0f99d637c4b0f1"
                      data-style-height="24px"
                      data-style-width="100%"
                      data-token="48318e46-f9f6-444b-82ea-d18f3c5921b3"
                      data-sku="{{ all_skus }}"
                      data-no-reviews="show"
                      data-scroll-to-list="true"
                      data-style-alignment="right"
                    >
                      <a href="https://www.trustpilot.com/review/ubbspouches.com" target="_blank" rel="noopener"
                        >Trustpilot</a
                      >
                    </div>
                    <!-- End TrustBox widget -->
                  {% endunless %}
                {% endcomment %}
              </div>

              <!--
                {%- if shop.taxes_included or shop.shipping_policy.body != blank -%}
                  <div class="product__tax caption rte">
                    {%- if shop.taxes_included -%}
                      {{ 'products.product.include_taxes' | t }}
                    {%- endif -%}
                    {%- if shop.shipping_policy.body != blank -%}
                      {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              -->

              <div {{ block.shopify_attributes }}>
                {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  {{ form | payment_terms }}
                {%- endform -%}
              </div>
            {%- when 'description' -%}
              {%- if product.description != blank -%}
                {% assign parts = product.description | split: '20 nicotine pouches per can' %}

                <div class="product__description rte font_text font_black" id="main_description">
                  <div class="main_desc {% if product.tags contains 'collateral_product' %}collateral_desc{% endif %}">
                    <div class="desc_split_text">{% if product.tags contains 'ice_mint' %} 15 {% else %}20 {% endif %} nicotine pouches per can</div>

                    <div class="desc_part_1">
                      {{ parts[0] }}
                    </div>

                    <div class="desc_part_2-wrapper">
                      <div class="desc_part_2 add-read-more1">
                        {{ parts[1] | strip_html }}
                      </div>
                    </div>

                    {% assign flavour_cards = product.metafields.custom.flavour_cards.value %}

                    {% if product.tags contains 'Bundle' %}
                      <div class="flavour_title">
                        <h3>What's Included</h3>
                      </div>
                    {% endif %}

                    <div class="flavour-grid">
                      {% for flavour in flavour_cards %}
                        <div class="flavour-card">
                          <!-- Top Section (Always Visible) -->
                          <div class="flavour-header">
                            {% if flavour.image.value != blank %}
                              <img
                                src="{{ flavour.image.value | image_url: width: 300 }}"
                                alt="{{ flavour.title.value | escape }}"
                              >
                            {% endif %}

                            {% if flavour.title.value != blank %}
                              <h3>{{ flavour.title.value }}</h3>
                            {% endif %}

                            <!-- Dropdown Arrow -->
                            <img
                              src="https://cdn.shopify.com/s/files/1/0559/7075/8753/files/down-arrow.png?v=1772172684"
                              alt=""
                              class="arrow-drop"
                            >
                          </div>

                          <!-- Hidden Content -->
                          <div class="flavour-content">
                            {% if flavour.description.value != blank %}
                              <p>{{ flavour.description.value }}</p>
                            {% endif %}

                            {% if flavour.button_text.value != blank %}
                              <a href="{{ flavour.link.value }}" class="flavour-btn">
                                {{ flavour.button_text.value }}
                              </a>
                            {% endif %}
                          </div>
                        </div>
                      {% endfor %}
                    </div>
                  </div>
                </div>

                {% unless product.tags contains 'Bundle' %}
                  <div class="offer_sec">
                    <div class="questions_answer">
                      <div class="accordion">
                        <h4 class="header4 font_text font_black">
                          <span>MULTIBUY UPTO 50% OFF</span> <span class="i-icon">i</span>
                        </h4>
                        <div class="content">
                          <p class=" font_text font_black">Save when you buy 3, 6, 12, 24 or more cans.</p>
                          <div class="text_sec">
                            <p>
                              <span>Add 3 or more cans</span> <span>Add 6 or more cans</span>
                              <span>Add 12 or more cans</span> <span>Add 24 or more cans</span
                              ><span>Add 48 or more cans</span>
                            </p>
                            <p>
                              <span>10% Off | <b>£5.40</b> per can </span>
                              <span>20% Off | <b>£4.80</b> per can </span>
                              <span>30% Off | <b>£4.20</b> per can </span>
                              <span>40% Off | <b>£3.60</b> per can </span>
                              <span>50% Off | <b>£3.00</b> per can </span>
                            </p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                {% endunless %}

                {% if product.tags contains 'main_wholesale_product' or product.tags contains 'display_unit_product' %}
                  <div class="wholesale_price_sec">
                    <div class="wholesale_price main_price">
                      <p>Wholesale Price</p>
                      <span>
                        {%- if product.tags contains 'display_unit_product' %}£30.00{% else %}£10.00{% endif -%}
                      </span>
                      <p>
                        {% if product.tags contains 'display_unit_product' %}£36{% else %}£12{% endif %} inc VAT
                      </p>
                    </div>
                    <div class="price_per_can main_price">
                      <p>Price Per Can</p>
                      <span>
                        {%- if product.tags contains 'display_unit_product' %}£1.66{% else %}£2.00{% endif -%}
                      </span>
                      <p>
                        {% if product.tags contains 'display_unit_product' %}£2.00{% else %}£2.40{% endif %} inc VAT
                      </p>
                    </div>
                    <div class="price_per_can_percentage main_price">
                      <p>POR</p>
                      <span>
                        {%- if product.tags contains 'display_unit_product' %}66%{% else %}60%{% endif -%}
                      </span>
                      <p>
                        RRP {% if product.tags contains 'display_unit_product' %}£5.99{% else %}£5.99{% endif %}
                      </p>
                    </div>
                  </div>
                {% endif %}
                </div>
              {%- endif -%}
            {%- when 'custom_liquid' -%}
              {{ block.settings.custom_liquid }}
            {%- when 'collapsible_tab' -%}
              <div
                class="product__accordion accordion quick-add-hidden{% if block.settings.heading contains 'Multibuy' %} multibuy-popup {% endif %}"
                {{ block.shopify_attributes }}
              >
                <details id="Details-{{ block.id }}-{{ section.id }}">
                  <summary>
                    <div class="summary__title">
                      {% render 'icon-accordion', icon: block.settings.icon %}
                      <h2 class="h4 accordion__title">
                        {{ block.settings.heading | default: block.settings.page.title }}
                      </h2>
                    </div>

                    <!-- Plus / Minus Toggle Icon -->
                    <span class="accordion-toggle-icon">+</span>
                  </summary>

                  <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
                    {% if block.settings.content != blank %}
                      {{ block.settings.content }}
                    {% elsif block.settings.page.content != blank %}
                      {{ block.settings.page.content }}
                    {% endif %}
                  </div>
                </details>
              </div>

            {%- when 'quantity_selector' -%}
              <div class="qunatity_cart_section">
                {%- assign cart_qty = cart | item_count_for_variant: product.selected_or_first_available_variant.id -%}
                <div
                  class="product-form__input product-form__quantity{% if settings.inputs_shadow_vertical_offset != 0 and settings.inputs_shadow_vertical_offset < 0 %} product-form__quantity-top{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  <label class="form__label" for="Quantity-{{ section.id }}">
                    {% if product.tags contains 'main_wholesale_product' %}
                      <span class="wholesale_quantity"
                        >Roll of 5<br>
                        <b>Quantity</b></span
                      >
                    {% else %}
                      {{ 'products.product.quantity.label' | t }}
                    {% endif %}
                    <span class="quantity__rules-cart no-js-hidden{% if cart_qty == 0 %} hidden{% endif %}">
                      {%- render 'loading-spinner' -%}
                      <!--
                        <span
                          >(
                          {{- 'products.product.quantity.in_cart_html' | t: quantity: cart_qty -}}
                          )</span
                        >
                      -->
                    </span>
                  </label>

                  <quantity-input class="quantity">
                    <button class="quantity__button no-js-hidden" name="minus" type="button">
                      <span class="visually-hidden">
                        {{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}
                      </span>
                      {% render 'icon-minus' %}
                    </button>

                    <input
                      class="quantity__input"
                      type="number"
                      name="quantity"
                      id="Quantity-{{ section.id }}"
                      data-cart-quantity="{{ cart_qty }}"
                      data-min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                      min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                      {% if product.tags contains 'collateral_product' %}
                        data-max="5" max="5"

                      {% else %}
                        {% if product.selected_or_first_available_variant.quantity_rule.max != null %}
                          data-max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                          max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                        {% endif %}
                      {% endif %}
                      step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
                      value="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                      form="{{ product_form_id }}"
                    >
                    <button class="quantity__button no-js-hidden" name="plus" type="button">
                      <span class="visually-hidden">
                        {{- 'products.product.quantity.increase' | t: product: product.title | escape -}}
                      </span>
                      {% render 'icon-plus' %}
                    </button>
                  </quantity-input>
                </div>

                {% comment %}
                  <div class="free_sample_text">
                  <p class="free_sample_head">New to Übbs? </p>
                  <p>Claim your first can for free, use code <b>FREESAMPLE</b> at checkout.</p>
                  </div>
                {% endcomment %}
            {%- when 'popup' -%}
              <modal-opener
                class="product-popup-modal__opener no-js-hidden quick-add-hidden"
                data-modal="#PopupModal-{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                <button
                  id="ProductPopup-{{ block.id }}"
                  class="product-popup-modal__button link"
                  type="button"
                  aria-haspopup="dialog"
                >
                  {{ block.settings.text | default: block.settings.page.title }}
                </button>
              </modal-opener>
              <a href="{{ block.settings.page.url }}" class="product-popup-modal__button link no-js">
                {{- block.settings.text -}}
              </a>
            {%- when 'share' -%}
              <share-button
                id="Share-{{ section.id }}"
                class="share-button quick-add-hidden"
                {{ block.shopify_attributes }}
              >
                <button class="share-button__button hidden">
                  {% render 'icon-share' %}
                  {{ block.settings.share_label | escape }}
                </button>
                <details id="Details-{{ block.id }}-{{ section.id }}">
                  <summary class="share-button__button">
                    {% render 'icon-share' %}
                    {{ block.settings.share_label | escape }}
                  </summary>
                  <div id="Product-share-{{ section.id }}" class="share-button__fallback motion-reduce">
                    <div class="field">
                      <span id="ShareMessage-{{ section.id }}" class="share-button__message hidden" role="status">
                      </span>
                      <input
                        type="text"
                        class="field__input"

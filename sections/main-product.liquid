{% comment %}{% endcomment %}
<div class="sticky-atc" id="StickyATC">
  <div class="sticky-atc__inner">
    <div class="sticky_img_title_sec small-hide medium-hide">
      <img
        src="{{ product.selected_or_first_available_variant.featured_image | img_url:'master' }}"
        alt="sticky_pdp_img"
        width=""
        height=""
      >

      <span class="sticky_title">{{ product.title }}</span>
    </div>

    {% unless product.has_only_default_variant %}
      <div class="sticky-atc__variants  {{ product.handle }}">
        {% for variant in product.variants %}
          <label class="sticky-atc__variant-item {% unless variant.available %}is-disabled{% endunless %}">
            <input
              type="radio"
              name="sticky_variant_id"
              value="{{ variant.id }}"
              class="sticky-atc__variant-radio"
              {% if variant.id == product.selected_or_first_available_variant.id %}
                checked
              {% endif %}
              {% unless variant.available %}
                disabled
              {% endunless %}
            >
            <span class="sticky-atc__variant-label">
              {{
                variant.title
                | remove: 'Regular:'
                | remove: 'Strong:'
                | remove: 'Max:'
                | remove: 'Mild:'
                | remove: 'Intense:'
              }}
            </span>
          </label>
        {% endfor %}
      </div>
    {% endunless %}

    <!-- Hidden input connected to product form -->
    <input
      type="hidden"
      name="id"
      value="{{ product.selected_or_first_available_variant.id }}"
      id="StickyVariantId"
    >
    <button
      type="submit"
      class="cmn_btn button button--primary sticky-atc__btn"
    >
      Add to basket
    </button>
  </div>
</div>
<script>
  (function () {
    'use strict';

    function updateDawnCart(sectionsHTML) {
      const parser = new DOMParser();

      // ── Cart icon bubble ──────────────────────────────────────────────
      if (sectionsHTML['cart-icon-bubble']) {
        const doc = parser.parseFromString(sectionsHTML['cart-icon-bubble'], 'text/html');
        const newBubble = doc.querySelector('.cart-count-bubble');
        const existBubble = document.querySelector('.cart-count-bubble');

        if (existBubble && newBubble) {
          existBubble.innerHTML = newBubble.innerHTML;
        } else if (!existBubble && newBubble) {
          const cartIconBtn = document.querySelector(
            '#cart-icon-bubble, a[href="/cart"].header__icon, .header__icon--cart'
          );
          if (cartIconBtn) cartIconBtn.insertAdjacentHTML('beforeend', newBubble.outerHTML);
        }
      }

      // ── Cart drawer ───────────────────────────────────────────────────
      if (sectionsHTML['cart-drawer']) {
        const doc = parser.parseFromString(sectionsHTML['cart-drawer'], 'text/html');
        const newDrawer = doc.querySelector('cart-drawer');
        const liveDrawer = document.querySelector('cart-drawer');

        if (newDrawer && liveDrawer) {
          // ✅ Sync element-level attributes first.
          // When cart goes empty → has items, Dawn changes classes/attrs on
          // the <cart-drawer> element itself (e.g. removes 'is-empty', changes
          // aria-hidden, inert, etc.). innerHTML-only swap misses all of these.
          Array.from(newDrawer.attributes).forEach(function (attr) {
            liveDrawer.setAttribute(attr.name, attr.value);
          });

          // Remove any attributes present on live but absent from new
          // (e.g. Dawn may have added 'inert' on the empty-cart render)
          Array.from(liveDrawer.attributes).forEach(function (attr) {
            if (!newDrawer.hasAttribute(attr.name)) {
              liveDrawer.removeAttribute(attr.name);
            }
          });

          // ✅ Update content without replacing the custom-element instance
          // (replaceWith() would destroy Dawn's registered event listeners)
          liveDrawer.innerHTML = newDrawer.innerHTML;
        }
      }

      // ── Open the drawer ───────────────────────────────────────────────
      const cartDrawerEl = document.querySelector('cart-drawer');
      if (!cartDrawerEl) return;

      // Small tick lets Dawn's MutationObserver / reactive bindings
      // process the new child nodes before open() queries them
      requestAnimationFrame(function () {
        if (typeof cartDrawerEl.open === 'function') {
          cartDrawerEl.open();
        } else {
          cartDrawerEl.classList.add('active', 'animate', 'open');
          cartDrawerEl.removeAttribute('inert');
          cartDrawerEl.setAttribute('aria-hidden', 'false');
          const closeBtn = cartDrawerEl.querySelector('button[class*="drawer__close"], .cart-drawer__close');
          closeBtn?.focus();
        }
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      const stickyATC = document.getElementById('StickyATC');
      const addBtn = stickyATC ? stickyATC.querySelector('.sticky-atc__btn') : null;
      const stickyVariantInput = document.getElementById('StickyVariantId');

      if (!stickyATC || !addBtn) return;

      function getVariantId() {
        const checkedRadio = stickyATC.querySelector('.sticky-atc__variant-radio:checked');
        if (checkedRadio) return checkedRadio.value;

        if (stickyVariantInput && stickyVariantInput.value) return stickyVariantInput.value;

        const mainForm = document.getElementById('{{ product_form_id }}');
        if (mainForm) {
          const mainId = mainForm.querySelector('input[name="id"], select[name="id"]');
          if (mainId) return mainId.value;
        }
        return null;
      }

      addBtn.addEventListener('click', async function (e) {
        e.preventDefault();

        const variantId = getVariantId();
        if (!variantId) {
          console.warn('[StickyATC] No variant ID found.');
          return;
        }

        const originalText = addBtn.textContent.trim();
        addBtn.disabled = true;
        addBtn.textContent = 'Adding…';

        try {
          const res = await fetch('/cart/add.js', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Requested-With': 'XMLHttpRequest',
            },
            body: JSON.stringify({
              items: [{ id: parseInt(variantId, 10), quantity: 1 }],
              sections: ['cart-drawer', 'cart-icon-bubble'],
              sections_url: window.location.pathname,
            }),
          });

          if (!res.ok) {
            const errData = await res.json().catch(() => ({}));
            const errMsg = errData?.description || errData?.message || 'HTTP ' + res.status;
            console.error('[StickyATC] Shopify error:', errMsg);
            throw new Error(errMsg);
          }

          const data = await res.json();

          if (data.sections) {
            updateDawnCart(data.sections);
          } else {
            document.querySelector('cart-drawer')?.open?.();
          }

          addBtn.textContent = originalText;
          setTimeout(function () {
            addBtn.textContent = originalText;
            addBtn.disabled = false;
          }, 2000);
        } catch (err) {
          console.error('[StickyATC]', err.message);
          addBtn.textContent = 'Error — try again';
          addBtn.disabled = false;
          setTimeout(function () {
            addBtn.textContent = originalText;
          }, 2500);
        }
      });

      const stickyRadios = stickyATC.querySelectorAll('.sticky-atc__variant-radio');
      const mainForm = document.getElementById('{{ product_form_id }}');
      const mainVariantInput = mainForm ? mainForm.querySelector('input[name="id"], select[name="id"]') : null;

      stickyRadios.forEach(function (radio) {
        radio.addEventListener('change', function () {
          if (!this.checked) return;

          if (stickyVariantInput) stickyVariantInput.value = this.value;

          if (mainVariantInput) {
            mainVariantInput.value = this.value;
            mainVariantInput.dispatchEvent(new Event('change', { bubbles: true }));
          }

          const matchingInput = document.querySelector(
            '.product__info-wrapper input[data-variant-id="' + this.value + '"]'
          );
          if (matchingInput) {
            matchingInput.checked = true;
            matchingInput.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      });

      if (mainVariantInput) {
        mainVariantInput.addEventListener('change', function () {
          if (stickyVariantInput) stickyVariantInput.value = this.value;
          stickyRadios.forEach(function (radio) {
            radio.checked = radio.value === mainVariantInput.value;
          });
        });
      }
    });

    if (window.innerWidth > 767) {
      document.addEventListener('DOMContentLoaded', function () {
        const stickyATC = document.getElementById('StickyATC');
        const sentinel = document.getElementById('product_sec');

        if (!stickyATC || !sentinel) return;

        let lastScrollTop = window.pageYOffset || document.documentElement.scrollTop;
        let isSentinelVisible = false;

        const observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              isSentinelVisible = entry.isIntersecting;
              if (isSentinelVisible) stickyATC.classList.remove('active');
            });
          },
          { threshold: 0 }
        );

        observer.observe(sentinel);

        window.addEventListener('scroll', function () {
          const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
          if (isSentinelVisible) {
            stickyATC.classList.remove('active');
          } else {
            stickyATC.classList.toggle('active', scrollTop > lastScrollTop);
          }
          lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
        });
      });
    }

    if (window.innerWidth <= 767) {
      document.addEventListener('DOMContentLoaded', function () {
        const stickyATC = document.getElementById('StickyATC');
        const originalATC = document.querySelector('product-info');

        if (!stickyATC || !originalATC) return;

        const observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              stickyATC.classList.toggle('active', !entry.isIntersecting);
            });
          },
          { root: null, threshold: 0.1 }
        );

        observer.observe(originalATC);
      });
    }
  })();
</script>


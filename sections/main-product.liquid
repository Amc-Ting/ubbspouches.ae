    select.addEventListener('click', () => {

      // Get selected variant ID
      const pdpInput = document.querySelector('.product-part .product-variant-id');
      const selectAttr = select.getAttribute('data-vid');

      if (pdpInput) {
        pdpInput.value = selectAttr;
        console.log('Variant ID:', selectAttr);
      }

      // Check variant availability
      const isAvailable = select.getAttribute('data-available') === 'true';

      // Find submit button
      const submitButton = document.querySelector(
        '.product-part .product-form__submit'
      );

      if (submitButton) {
        submitButton.disabled = !isAvailable;
        submitButton.classList.toggle('disabled', !isAvailable);
        const buttonText = submitButton.querySelector('span');
        if (buttonText) {
          buttonText.textContent = isAvailable
            ? 'Add to basket'
            : 'Out of Stock';
        }
        {% comment %} if (isAvailable) {
          submitButton.classList.remove('disabled');
        } else {
          submitButton.classList.add('disabled');
        } {% endcomment %}
      }

      // Get price
      const priceElement = document.querySelector(
        '.product-part span.price-item.price-item--regular'
      );

      if (!priceElement) return;

      const priceText = priceElement.textContent;

      // Convert price to number
      const priceNumber = parseFloat(
        priceText.replace(/[^0-9.]/g, '')
      );


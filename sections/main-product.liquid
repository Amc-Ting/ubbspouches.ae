    if (!part1 || !splitText || !part2) return;

    const words = part1.innerText.trim().split(/\s+/);

    // ✔ Smart truncate — dots only if needed
    let truncatedPart1;
    if (words.length > wordLimit) {
      truncatedPart1 = words.slice(0, wordLimit).join(" ") + "...";
    } else {
      truncatedPart1 = part1.innerText.trim(); // no "..." if not truncated
    }

    const shortHTML = `
      <div class="desc_part_1">${truncatedPart1}</div>
      ${splitText.outerHTML}
      ${part2.outerHTML}
    `;

    const fullHTML = `
      ${part1.outerHTML}
      ${splitText.outerHTML}
      ${part2.outerHTML}
    `;

    block.innerHTML = `
      <div class="short-content">${shortHTML}</div>
      <div class="full-content" style="display:none;">${fullHTML}</div>
      <button class="read-more-btn" style="margin-top:10px;">Read More</button>
    `;

    const btn = block.querySelector('.read-more-btn');
    const full = block.querySelector('.full-content');
    const short = block.querySelector('.short-content');

    btn.addEventListener('click', function () {
      const expanded = full.style.display === 'block';
      full.style.display = expanded ? 'none' : 'block';
      short.style.display = expanded ? 'block' : 'none';
      btn.textContent = expanded ? 'Read More' : 'Read Less';
    });
    });
    }); 

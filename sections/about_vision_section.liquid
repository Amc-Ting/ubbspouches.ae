<section id="with_this_vision_section">
   <div class="container">
    <div class="with_this_vision_inner">
       <div class="with_this_vision_content">
          <h2 class="text_xxl font_heading text_400 fadeInUp">{{ section.settings.title }}</h2>
          <p>{{ section.settings.subtitle }}</p>
       </div>
       <div class="with_this_vision_img">
         <div class="hand_image fadeInUp">
            <img src="{{ section.settings.desktop_border_img | img_url: 'master' }}" alt="" class="img-responsive" />
            <div class="element_02">
              <div class="blur_circle"></div>
           </div>
         </div>
      </div>
    </div>
   </div>
</section>
{% schema %}
  {
   "name":"About Vision Section",
   "settings":[
       {
         "type":"image_picker",
         "id":"desktop_border_img",
         "label":"Desktop Image"
      },
      {
         "type":"text",
         "id":"title",
         "label":"Title"
      },
	  {
         "type":"text",
         "id":"subtitle",
         "label":"Subheading"
      }
	  
   ],
	"presets": [
      {
      "name": "About Vision Section"
      }
   ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}